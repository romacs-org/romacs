;;; Fixture projects identity to booleans before transport; no symbol-name
;;; encoding can conceal raw bytes or collapse distinct symbol identities.
(case empty romacs-obj-probe
 (progn
   (defun romacs-obj-probe (names)
     (let ((ob (obarray-make)) (out nil) (count 0))
       (push (obarrayp ob) out)
       (mapc (lambda (name)
               (let* ((before (intern-soft name ob)) (s (intern name ob)))
                 (push (not (null before)) out)
                 (push (eq s (intern name ob)) out)
                 (push (eq s (intern-soft name ob)) out)
                 (push (symbol-name s) out))) names)
       (mapatoms (lambda (_) (setq count (1+ count))) ob)
       (push count out)
       (mapc (lambda (name)
               (push (unintern (make-symbol name) ob) out)
               (push (unintern name ob) out)
               (push (not (null (intern-soft name ob))) out)) names)
       (setq count 0)
       (mapatoms (lambda (_) (setq count (1+ count))) ob)
       (push count out)
       (vconcat (nreverse out))))
   ["" ""]))
(case ascii romacs-obj-probe (vector "alpha" "beta" "alpha" (string-to-multibyte "alpha")))
(case unicode romacs-obj-probe ["é" "λ" "é"])
(case raw romacs-obj-probe (vector (unibyte-string 255) (string-as-multibyte (unibyte-string 255))))
(case same-text romacs-obj-probe (vector (unibyte-string 233) "é"))
(case same-bytes romacs-obj-probe (vector (unibyte-string 195 169) "é"))
(case growth romacs-obj-probe (vconcat (mapcar #'number-to-string (number-sequence 0 100))))

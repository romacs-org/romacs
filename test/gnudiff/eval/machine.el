;;; Machine scenarios; no bytecode/call-depth contract in E1a.
(require 'cl-lib)
(defvar eval-e1a-v 0)
(defun eval-e1a-watcher (s v op where) (push (list v op where) eval-e1a-log))
(defvar eval-e1a-log nil)
(defun eval-e1a-watcher-added-inside-let ()
  (setq eval-e1a-v 0 eval-e1a-log nil)
  (unwind-protect
      (progn (let ((eval-e1a-v 1)) (add-variable-watcher 'eval-e1a-v #'eval-e1a-watcher))
             (car eval-e1a-log))
    (remove-variable-watcher 'eval-e1a-v #'eval-e1a-watcher)))
(defun eval-e1a-plain-made-local ()
  (setq-default eval-e1a-v 0)
  (with-temp-buffer
    (let ((eval-e1a-v 1)) (make-local-variable 'eval-e1a-v) (setq eval-e1a-v 2))
    (list (default-value 'eval-e1a-v) eval-e1a-v)))
(defun eval-e1a-plain-made-local-watcher ()
  (setq-default eval-e1a-v 0)
  (setq eval-e1a-log nil)
  (unwind-protect
      (with-temp-buffer
        (let ((eval-e1a-v 1))
          (make-local-variable 'eval-e1a-v)
          (setq eval-e1a-v 2)
          (add-variable-watcher 'eval-e1a-v #'eval-e1a-watcher))
        (car eval-e1a-log))
    (remove-variable-watcher 'eval-e1a-v #'eval-e1a-watcher)))
(defun eval-e1a-max-lisp-eval-depth-let-restore ()
  (let ((old max-lisp-eval-depth) inside)
    (let ((max-lisp-eval-depth 222)) (setq max-lisp-eval-depth 333 inside max-lisp-eval-depth))
    (list inside (= old max-lisp-eval-depth))))
(defun eval-e1a-quit-staging ()
  (let ((inhibit-quit t) (quit-flag nil) log result)
    (catch 'done
      (unwind-protect
          (catch 'inner (unwind-protect (throw 'done 1)
                          (push (list 'inner quit-flag) log) (setq quit-flag t)))
        (push (list 'outer quit-flag) log)))
    (setq result (list (reverse log) quit-flag) quit-flag nil) result))
(defun eval-e1a-cleanup-overrides-throw ()
  (catch 'outer (catch 'inner (unwind-protect (throw 'inner 1) (throw 'outer 2)))))
(defun eval-e1a-quit-flag-let ()
  (let ((inhibit-quit t) (quit-flag nil) result)
    (let ((quit-flag t)) nil) (setq result quit-flag quit-flag nil) result))
(defun eval-e1a-watcher-removed-inside-let ()
  (setq eval-e1a-v 0 eval-e1a-log nil)
  (add-variable-watcher 'eval-e1a-v #'eval-e1a-watcher)
  (let ((eval-e1a-v 1)) (remove-variable-watcher 'eval-e1a-v #'eval-e1a-watcher))
  (list (caar eval-e1a-log) eval-e1a-v))
(defun eval-e1a-watcher-throw ()
  (setq eval-e1a-v 0)
  (let ((fn (lambda (&rest _) (throw 'done 8))))
    (unwind-protect
        (progn (add-variable-watcher 'eval-e1a-v fn)
               (list (catch 'done (let ((eval-e1a-v 1)) nil)) eval-e1a-v))
      (remove-variable-watcher 'eval-e1a-v fn))))
(defun eval-e1a-alias-resolved-once ()
  (setq eval-e1a-v 0)
  (defvaralias 'eval-e1a-alias 'eval-e1a-v)
  (unwind-protect
      (let (inside)
        (let ((eval-e1a-alias 1)) (setq inside eval-e1a-v)
             (defvaralias 'eval-e1a-alias 'max-lisp-eval-depth))
        (list inside eval-e1a-v))
    (defvaralias 'eval-e1a-alias nil)))
(defun eval-e1a-cleanup-error-inner-and-outer ()
  (list
   (condition-case e (condition-case nil (unwind-protect (signal 'error 1) (signal 'error 9))
                       (error (signal 'error 9))) (error (cdr e)))
   (condition-case e (unwind-protect (signal 'error 1) (signal 'error 9)) (error (cdr e)))))
(defun eval-e1a-handler-bind-observes-binding ()
  (let (seen)
    (condition-case nil
        (handler-bind ((error (lambda (_) (setq seen eval-e1a-v))))
          (let ((eval-e1a-v 42)) (signal 'error 9)))
      (error nil)) seen))
(defun eval-e1a-nil-tag-no-catch ()
  (condition-case e (catch nil (throw nil 1)) (no-catch (car e))))
(defun eval-e1a-nil-tag-under-funcall ()
  (funcall (lambda () (condition-case e (throw nil 1) (no-catch e)))))
(defun eval-e1a-host-reentrant-catches ()
  (catch 'outer (funcall (lambda () (catch 'inner (throw 'inner 5))))))
(defun eval-e1a-pending-quit-abandoned ()
  (let ((inhibit-quit t) (quit-flag nil) result)
    (setq quit-flag t)
    (catch 'done (unwind-protect (throw 'done 1) (throw 'done 2)))
    (setq result quit-flag quit-flag nil) result))
(dolist (name '(watcher-added-inside-let plain-made-local plain-made-local-watcher max-lisp-eval-depth-let-restore
               quit-staging cleanup-overrides-throw quit-flag-let watcher-removed-inside-let
               watcher-throw alias-resolved-once cleanup-error-inner-and-outer
               handler-bind-observes-binding nil-tag-no-catch nil-tag-under-funcall host-reentrant-catches pending-quit-abandoned))
  (princ (format "(%s . " name))
  (prin1 (funcall (intern (format "eval-e1a-%s" name)))) (princ ")\n"))

;;; 01-inheritance.el --- Props and markers GNU oracle -*- lexical-binding: t; -*-
(case props-inheritance eval
 '(let (rows)
    (dolist (fn '(insert insert-and-inherit insert-before-markers insert-before-markers-and-inherit))
      (dolist (sticky
               (let (matrix)
                 (dolist (front '(nil t (p r)))
                   (dolist (rear '(nil t (q r)))
                     (dolist (default '(nil ((p . t) (r . t))))
                       (dolist (category '(nil t))
                         (push (list front rear default category) matrix)))))
                 (nreverse matrix)))
        (dolist (span '((1 7) (2 5)))
          (dolist (pos '(1 2 3 5 7))
            (with-temp-buffer
              (insert "abcdef")
              (let ((text-property-default-nonsticky (nth 2 sticky))
                    (category (make-symbol "props-category")))
                (setplist category '(p category-p q category-q r category-r))
                (add-text-properties (car span) (cadr span)
                  (append '(p direct-p q direct-q)
                    (list 'front-sticky (nth 0 sticky) 'rear-nonsticky (nth 1 sticky))
                    (when (nth 3 sticky) (list 'category category))))
                (goto-char pos)
                (let ((before (copy-marker pos)) (after (copy-marker pos t)))
                  (funcall fn "X")
                  (push (list fn sticky span pos
                          (get-text-property pos 'p) (get-text-property pos 'q)
                          (get-text-property pos 'r)
                          (get-text-property pos 'front-sticky)
                          (get-text-property pos 'rear-nonsticky)
                          (not (null (get-text-property pos 'category)))
                          (marker-position before) (marker-position after)) rows))))))))
    (vconcat (nreverse rows))))

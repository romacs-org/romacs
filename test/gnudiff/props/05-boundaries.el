;;; 05-boundaries.el --- Props and markers GNU oracle -*- lexical-binding: t; -*-
(case props-boundary-limits eval
 '(with-temp-buffer
    (insert "abcdefgh")
    (set-text-properties 2 4 (list 'p (list 'a) 'q 1))
    (set-text-properties 4 6 (list 'p (list 'a) 'q 1))
    (put-text-property 6 8 'q 2)
    (let ((s (buffer-string)) rows)
      (dolist (stringp '(nil t))
        (let ((object (if stringp s (current-buffer))) (offset (if stringp 0 1)))
          (dolist (spec '((next-property-change forward all)
                          (previous-property-change backward all)
                          (next-single-property-change forward single)
                          (previous-single-property-change backward single)
                          (next-char-property-change forward char)
                          (previous-char-property-change backward char)
                          (next-single-char-property-change forward single-char)
                          (previous-single-char-property-change backward single-char)))
            (unless (and stringp (eq (nth 2 spec) 'char))
              (dolist (pos '(0 1 2 3 4 5 6 7 8))
                (dolist (limit '(nil 0 1 2 3 4 5 6 7 8))
                  (when (or (null limit) (if (eq (nth 1 spec) 'forward) (>= limit pos) (<= limit pos)))
                    (let* ((p (+ pos offset)) (lim (and limit (+ limit offset)))
                           (args (pcase (nth 2 spec)
                                   ('all (list p object lim))
                                   ('single (list p 'p object lim))
                                   ('char (list p lim))
                                   ('single-char (list p 'p object lim))))
                           (result (condition-case e (apply (car spec) args) (error e))))
                      (push (list stringp (car spec) pos limit result) rows)))))))))
      (list (object-intervals s) (vconcat (nreverse rows))))))
(case props-equal-adjacent-plists eval
 '(with-temp-buffer
    (insert "abcdef")
    (set-text-properties 1 4 (list 'p 'a 'q 1))
    (set-text-properties 4 7 (list 'p 'a 'q 1))
    (put-text-property 4 7 'q 2)
    (put-text-property 4 7 'q 1)
    (let ((s (buffer-string)))
      (list (object-intervals (current-buffer)) (object-intervals s)
            (next-property-change 1) (next-single-property-change 1 'p)
            (previous-property-change 7) (previous-single-property-change 7 'p)
            (next-property-change 0 s) (next-single-property-change 0 'p s)
            (previous-property-change 6 s) (previous-single-property-change 6 'p s)))))

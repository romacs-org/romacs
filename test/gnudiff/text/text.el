(case insertion gnudiff-text-run t "abcdef" '((mk 3 nil) (mk 3 t) (ins 3 "XY") (ins-bm 3 "Z")))
(case deletion gnudiff-text-run t "abcdefghij" '((mk 2 nil) (mk 5 nil) (mk 8 nil) (mk 9 nil) (del 3 8)))
(case replacement gnudiff-text-run t "foo bar baz" '((mk 5 nil) (mk 6 nil) (mk 8 t) (mk 9 nil) (rep 5 8 "QUUXX")))
(case erase gnudiff-text-run t "abc" '((mk 2 nil) (del 1 4) (ins 1 "xyz")))
(case ticks gnudiff-text-run t "" (list '(ins 1 "a") (list 'ins 2 (make-string 1000 ?x)) '(del 1 501) '(ins 1 "")))
(case multibyte gnudiff-text-run t "aé€😀\377b" (list (list 'ins 7 (unibyte-string 255)) '(b2p 3) '(b2p 4)))
(case unibyte gnudiff-text-run nil "a\351b" '((mk 2 t) (ins 2 "\377") (del 1 2)))
(case partial-eob gnudiff-text-run t "a\nb" '((fl 4 1) (fl 3 1) (fl 4 2)))
(case terminal-eob gnudiff-text-run t "a\nb\n" '((fl 5 1) (fl 4 1) (fl 5 2)))
(case lines gnudiff-text-run t "l1\nl2\n\nl4" '((fl 1 10) (fl 10 -10) (fl 1 2)))
(case empty gnudiff-text-run t "" '((mk 1 nil) (mk 1 t) (ins 1 "") (rep 1 1 "") (fl 1 1) (fl 1 -1)))
(case edges gnudiff-text-run t "é€😀" '((mk 1 nil) (mk 4 t) (ins 1 "\n") (ins 5 "\n") (rep 2 2 "Z") (mset 0 3) (mtype 0 t) (ins 3 "Q")))
(case raw-boundaries gnudiff-text-run t (concat (make-string 4095 ?x) (string #x3fffff #x234567 ?\n)) (list (list 'ins 4096 (string #x3fff80)) '(del 4095 4097)))

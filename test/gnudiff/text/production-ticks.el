;; Production eval tick oracle. Evaluate this single form, then prin1 its result.
;; Character-edit rows carry exact logarithmic deltas for one Text primitive;
;; other rows carry labeled monotonicity/equality/modified-state predicates.
;; Complex operations need not have identical tick values (design §7 D2).
(progn
  (erase-buffer)
  (insert "abcdefgh")
  (set-buffer-modified-p nil)
  (let ((rows nil))
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (goto-char 3)
      (insert "XYZW")
      (setq rows (cons (list 'insert (- (buffer-modified-tick) m)
                  (- (buffer-chars-modified-tick) c)
                  (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (delete-region 3 7)
      (setq rows (cons (list 'delete (- (buffer-modified-tick) m)
                  (- (buffer-chars-modified-tick) c)
                  (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (goto-char 3)
      (search-forward "cdef")
      (replace-match "WXYZ" t t)
      (setq rows (cons (list 'replace (- (buffer-modified-tick) m)
                  (- (buffer-chars-modified-tick) c)
                  (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (subst-char-in-region 1 (point-max) ?a ?A)
      (setq rows (cons (list 'subst (> (buffer-modified-tick) m)
                  (> (buffer-chars-modified-tick) c)
                  (= (buffer-modified-tick) (buffer-chars-modified-tick))
                  (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (put-text-property 1 3 'w17 'yes)
      (setq rows (cons (list 'property (> (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c)
                  (> (buffer-modified-tick) (buffer-chars-modified-tick))
                  (buffer-modified-p)) rows)))
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (set-buffer-modified-p nil)
      (setq rows (cons (list 'set-clean (= (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c) (buffer-modified-p)) rows)))
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (set-buffer-modified-p t)
      (setq rows (cons (list 'set-dirty (> (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c) (buffer-modified-p)) rows)))
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (restore-buffer-modified-p nil)
      (setq rows (cons (list 'restore-clean (= (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c) (buffer-modified-p)) rows)))
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (restore-buffer-modified-p t)
      (setq rows (cons (list 'restore-dirty (> (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c) (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (goto-char (point-max))
      (insert "!")
      (setq rows (cons (list 'chars-after-properties (- (buffer-modified-tick) m)
                  (> (buffer-chars-modified-tick) c)
                  (= (buffer-modified-tick) (buffer-chars-modified-tick))
                  (buffer-modified-p)) rows)))
    (set-buffer-modified-p nil)
    (let ((m (buffer-modified-tick)) (c (buffer-chars-modified-tick)))
      (insert "")
      (delete-region 1 1)
      (subst-char-in-region 1 (point-max) ?q ?Q)
      (setq rows (cons (list 'noops (= (buffer-modified-tick) m)
                  (= (buffer-chars-modified-tick) c) (buffer-modified-p)) rows)))
    (nreverse rows)))

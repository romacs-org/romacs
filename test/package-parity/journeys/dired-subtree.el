;;; dired-subtree.el --- Journey: insert and remove a subtree  -*- lexical-binding: t -*-
(pp-step "require" (require 'dired-subtree) (featurep 'dired-subtree))
(let ((root (expand-file-name "tree" (getenv "HOME"))))
  (make-directory (expand-file-name "sub" root) t)
  (dolist (file '("a.txt" "sub/b.txt" "sub/c.txt"))
    (with-temp-file (expand-file-name file root) (insert file)))
  (dolist (file '("a.txt" "sub/b.txt" "sub/c.txt" "sub" "."))
    (set-file-times (expand-file-name file root) (encode-time '(0 0 0 1 1 2026 nil nil t))))
  (let ((dired-listing-switches "-al --time-style=iso"))
    (pp-step "dired" (dired root) (dired-goto-file (expand-file-name "sub" root)) (dired-get-filename))
    (pp-step "insert" (dired-subtree-insert) (dired-subtree--get-depth (dired-subtree--get-ov)))
    (pp-step "files" (let (files) (save-excursion (goto-char (point-min))
                                                   (while (not (eobp))
                                                     (when-let* ((f (dired-get-filename 'no-dir t))) (push f files))
                                                     (forward-line)))
                       (nreverse files)))
    (pp-step "remove" (dired-subtree-remove) (dired-get-filename 'no-dir t))))

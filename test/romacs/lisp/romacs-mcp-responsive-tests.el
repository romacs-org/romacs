;;; romacs-mcp-responsive-tests.el --- Admission and read regressions -*- lexical-binding: t; -*-

;; Source definitions only until the scheduling hold is explicitly released.
(require 'ert)
(require 'cl-lib)
(require 'romacs-mcp)
(require 'romacs-mcp-editor)

(defun romacs-mcp-test--request (peer id &optional generation)
  "Return a production-enqueued request for PEER, ID and GENERATION."
  (let ((romacs-mcp--queue nil)
        (romacs-mcp--generation (or generation romacs-mcp--generation)))
    ;; Use the real constructor: cancellation mutates its existing plist slot.
    ;; A hand-built plist without that slot loses updates through shared aliases.
    (cl-letf (((symbol-function 'romacs-mcp--schedule) #'ignore))
      (romacs-mcp--enqueue
       peer (romacs-mcp--object "id" id "method" "fixture")))
    (car romacs-mcp--queue)))

(ert-deftest romacs-mcp-responsive-input-defers-and-recovers ()
  (let* ((romacs-mcp--active nil) (romacs-mcp--timer nil)
         (romacs-mcp--queue (list (romacs-mcp-test--request 'a 1)
                                   (romacs-mcp-test--request 'b 2)))
         (pending t) (calls nil) (scheduled 0))
    (cl-letf (((symbol-function 'input-pending-p)
               (lambda (&rest args)
                 (should (equal args '(nil)))
                 ;; Exercise the guard with injected reentry at the polling boundary.
                 (romacs-mcp--drain)
                 pending))
              ((symbol-function 'romacs-mcp--live-p) (lambda (&rest _) t))
              ((symbol-function 'romacs-mcp--dispatch)
               (lambda (peer _) (push peer calls) (romacs-mcp--object)))
              ((symbol-function 'romacs-mcp--send) #'ignore)
              ((symbol-function 'romacs-mcp--schedule) (lambda () (cl-incf scheduled))))
      (romacs-mcp--drain)
      (should-not calls)
      (should (= 2 (length romacs-mcp--queue)))
      (should-not romacs-mcp--active)
      (setq pending nil)
      (romacs-mcp--drain)
      (should (equal calls '(a)))
      (should (= 1 (length romacs-mcp--queue)))
      (romacs-mcp--drain)
      (should (equal calls '(b a)))
      (should-not romacs-mcp--queue)
      (should (= scheduled 3)))))

(ert-deftest romacs-mcp-responsive-bounded-retirement ()
  (let* ((romacs-mcp--active nil) (romacs-mcp--timer nil)
         (romacs-mcp--queue
          (append (cl-loop repeat (1+ romacs-mcp--scan-limit)
                           collect (list :peer 'a :cancelled t))
                  (list (romacs-mcp-test--request 'b 1))))
         (calls 0))
    (cl-letf (((symbol-function 'input-pending-p) (lambda (&optional _) nil))
              ((symbol-function 'romacs-mcp--live-p) (lambda (&rest _) t))
              ((symbol-function 'romacs-mcp--schedule) #'ignore)
              ((symbol-function 'romacs-mcp--send) #'ignore)
              ((symbol-function 'romacs-mcp--dispatch)
               (lambda (&rest _) (cl-incf calls) (romacs-mcp--object))))
      (romacs-mcp--drain)
      (should (= calls 0))
      (should (= 2 (length romacs-mcp--queue)))
      (romacs-mcp--drain)
      (should (= calls 1))
      (should-not romacs-mcp--queue))))

(ert-deftest romacs-mcp-responsive-control-cancel-and-generation ()
  (let* ((romacs-mcp--active nil) (romacs-mcp--timer nil)
         (romacs-mcp--generation 7) (romacs-mcp--peers '(a b))
         (romacs-mcp--queue (list (romacs-mcp-test--request 'a 1)
                                   (romacs-mcp-test--request 'a 2 6)
                                   (romacs-mcp-test--request 'dead 3)
                                   (romacs-mcp-test--request 'b 1)))
         (calls nil))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'input-pending-p)
               (lambda (&optional _)
                 (romacs-mcp--frame 'a "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":1}}")
                 nil))
              ((symbol-function 'romacs-mcp--schedule) #'ignore)
              ((symbol-function 'romacs-mcp--send) #'ignore)
              ((symbol-function 'romacs-mcp--dispatch)
               (lambda (peer _) (push peer calls) (romacs-mcp--object))))
      (romacs-mcp--drain)
      (should (equal calls '(b)))
      (should-not romacs-mcp--queue))))

(ert-deftest romacs-mcp-responsive-unwind-and-abandoned-send ()
  (dolist (exit '(error quit throw cancel))
    (let* ((romacs-mcp--active nil) (romacs-mcp--timer nil)
           (request (romacs-mcp-test--request 'a 1))
           (romacs-mcp--queue (list request (romacs-mcp-test--request 'b 2)))
           (sent 0) (scheduled 0))
      (cl-letf (((symbol-function 'input-pending-p) (lambda (&optional _) nil))
                ((symbol-function 'romacs-mcp--live-p) (lambda (&rest _) t))
                ((symbol-function 'romacs-mcp--schedule) (lambda () (cl-incf scheduled)))
                ((symbol-function 'process-send-string) (lambda (&rest _) (cl-incf sent)))
                ((symbol-function 'run-at-time) (lambda (&rest _) 'timer))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'process-put) #'ignore)
                ((symbol-function 'process-get) (lambda (&rest _) nil))
                ((symbol-function 'romacs-mcp--dispatch)
                 (lambda (&rest _)
                   (pcase exit
                     ('error (error "Fixture"))
                     ('quit (signal 'quit nil))
                     ('throw (throw 'fixture t))
                     ('cancel (romacs-mcp--cancel 'a 1) (romacs-mcp--object))))))
        (catch 'fixture (romacs-mcp--drain))
        (should-not romacs-mcp--active)
        (should (= scheduled 1))
        (should (= 1 (length romacs-mcp--queue)))
        (should (= sent (if (memq exit '(throw cancel)) 0 1)))))))

(defun romacs-mcp-test--editor-args (&rest pairs)
  "Return editor arguments containing the current instance and PAIRS."
  (apply #'romacs-mcp--object
         "instance" (gethash "instance" (romacs-mcp-identity)) pairs))

(ert-deftest romacs-mcp-editor-optional-registration ()
  (let ((romacs-mcp-tools (copy-tree romacs-mcp-tools))
        (romacs-mcp--listener nil) (before (buffer-list)))
    (romacs-mcp-enable-editor-tools)
    (romacs-mcp-enable-editor-tools)
    (should (= 1 (cl-count "romacs_buffer_read" romacs-mcp-tools :key #'car :test #'equal)))
    (should (assoc "romacs_eval" romacs-mcp-tools))
    (should (equal before (buffer-list)))
    (should-not romacs-mcp--listener)))

(ert-deftest romacs-mcp-editor-literal-range-and-protected-state ()
  (let* ((study (current-buffer)) (window (selected-window))
         (window-buffer (window-buffer window)) (window-point (window-point window))
         (window-start (window-start window))
         (buffer (generate-new-buffer "mcp-read-fixture")))
    (unwind-protect
        (with-current-buffer buffer
          (insert (propertize "α\n\"\\β終🙂text" 'face 'bold))
          (buffer-enable-undo)
          (goto-char 5) (set-mark 6) (setq mark-active t)
          (narrow-to-region 3 9)
          (let* ((point (point)) (mark (mark)) (minimum (point-min)) (maximum (point-max))
                 (undo buffer-undo-list) (tick (buffer-modified-tick))
                 (args (romacs-mcp-test--editor-args "name" (buffer-name) "start" 1
                                                       "maxChars" 5 "expectedTick" tick))
                 (value (romacs-mcp--buffer-read args)))
            (should (equal (gethash "text" value) "α\n\"\\β"))
            (should-not (text-properties-at 0 (gethash "text" value)))
            (should (= (gethash "start" value) 1))
            (should (= (gethash "end" value) 6))
            (should (= (gethash "nextStart" value) 6))
            (should (eq (gethash "truncated" value) t))
            (should (= (gethash "tick" value) tick))
            (should (eq (current-buffer) buffer))
            (should (= point (point))) (should (= mark (mark)))
            (should mark-active)
            (should (= minimum (point-min))) (should (= maximum (point-max)))
            (should (eq undo buffer-undo-list))
            (should (= tick (buffer-modified-tick)))))
      (kill-buffer buffer))
    (should (eq (current-buffer) study))
    (should (eq (selected-window) window))
    (should (eq (window-buffer window) window-buffer))
    (should (= (window-point window) window-point))
    (should (= (window-start window) window-start))))

(ert-deftest romacs-mcp-editor-validation-tick-and-eob ()
  (with-temp-buffer
    (rename-buffer "mcp-validation-fixture" t)
    (insert "abc")
    (let ((args (romacs-mcp-test--editor-args "name" (buffer-name) "start" 1 "maxChars" 4)))
      (dolist (pair '(("instance" . "wrong") ("name" . "absent-mcp-fixture")
                      ("start" . 0) ("start" . 5) ("maxChars" . 0)
                      ("maxChars" . 4097) ("expectedTick" . -1)))
        (let ((bad (copy-hash-table args)))
          (puthash (car pair) (cdr pair) bad)
          (should-error (romacs-mcp--buffer-read bad))))
      (puthash "expectedTick" (buffer-modified-tick) args)
      (insert "d")
      (should-error (romacs-mcp--buffer-read args))
      (remhash "expectedTick" args)
      (puthash "start" (point-max) args)
      (let ((value (romacs-mcp--buffer-read args)))
        (should (equal "" (gethash "text" value)))
        (should (eq :false (gethash "truncated" value)))
        (should (eq :null (gethash "nextStart" value)))))))

(ert-deftest romacs-mcp-editor-encoded-budget-and-distant-start ()
  (with-temp-buffer
    (rename-buffer "mcp-output-fixture" t)
    (insert (make-string 100000 ?x) (make-string 4096 1) "🙂")
    (let* ((romacs-mcp-editor-output-limit 2048)
           (value (romacs-mcp--buffer-read
                   (romacs-mcp-test--editor-args "name" (buffer-name) "start" 100001 "maxChars" 4096)))
           (text (gethash "text" value)))
      (should (> (length text) 0))
      (should (< (length text) 4096))
      (should (<= (romacs-mcp--editor-result-bytes value) romacs-mcp-editor-output-limit))
      (should (= (gethash "end" value) (+ 100001 (length text))))
      (should (eq t (gethash "truncated" value)))
      (should (equal text (make-string (length text) 1))))))

(ert-deftest romacs-mcp-editor-discovery-bounded-native-slots ()
  (let* ((buffers (cl-loop for n below 40 collect (generate-new-buffer (format "mcp-list-%s" n))))
         (current (current-buffer)))
    (unwind-protect
        (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) buffers)))
          (let* ((value (romacs-mcp--buffer-list
                         (romacs-mcp-test--editor-args "offset" 0 "limit" 2)))
                 (entries (gethash "buffers" value)))
            (should (= 2 (length entries)))
            (should (= 2 (gethash "nextOffset" value)))
            (should (eq t (gethash "truncated" value)))
            (should (equal (gethash "name" (aref entries 0)) (buffer-name (car buffers))))
            (should (<= (romacs-mcp--editor-result-bytes value) romacs-mcp-editor-output-limit))
            (should (eq current (current-buffer))))
          (dolist (pair '(("offset" . -1) ("limit" . 0) ("limit" . 33)))
            (should-error (romacs-mcp--buffer-list
                           (romacs-mcp-test--editor-args "offset" (if (equal (car pair) "offset") (cdr pair) 0)
                                                         "limit" (if (equal (car pair) "limit") (cdr pair) 1)))))
          (should-error (romacs-mcp--buffer-list (romacs-mcp--object "instance" "wrong" "offset" 0 "limit" 1))))
      (mapc #'kill-buffer buffers))))

(ert-deftest romacs-mcp-editor-no-minibuffer-or-credential-disclosure ()
  (let* ((secret (generate-new-buffer "mcp-secret-fixture"))
         (alias (make-indirect-buffer secret "mcp-secret-alias" nil)))
    (unwind-protect
        (progn
          (with-current-buffer secret (setq buffer-file-name "/fixture/.authinfo.gpg"))
          (dolist (buffer (list secret alias (window-buffer (minibuffer-window))))
            (should (romacs-mcp--editor-denied-p buffer))
            (should-error (romacs-mcp--buffer-read
                           (romacs-mcp-test--editor-args "name" (buffer-name buffer) "start" 1 "maxChars" 1))))
          (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) (make-list 200 secret))))
            (let ((value (romacs-mcp--buffer-list (romacs-mcp-test--editor-args "offset" 0 "limit" 1))))
              (should (= 0 (length (gethash "buffers" value))))
              (should (= romacs-mcp-editor-scan-limit (gethash "scanned" value)))
              (should (= romacs-mcp-editor-scan-limit (gethash "nextOffset" value))))))
      (kill-buffer alias) (kill-buffer secret))))

(ert-deftest romacs-mcp-responsive-native-pending-and-regular-reschedule ()
  (let* ((romacs-mcp--active nil) (romacs-mcp--timer nil)
         (romacs-mcp--queue (list (romacs-mcp-test--request 'a 1)))
         (unread-command-events '(?x)) (calls 0) (timers nil))
    (cl-letf (((symbol-function 'run-at-time)
               (lambda (&rest args) (push args timers) 'fixture-timer))
              ((symbol-function 'romacs-mcp--live-p) (lambda (&rest _) t))
              ((symbol-function 'romacs-mcp--send) #'ignore)
              ((symbol-function 'romacs-mcp--dispatch)
               (lambda (&rest _) (cl-incf calls) (romacs-mcp--object))))
      ;; Use the real input predicate, not a timer-running replacement.
      (romacs-mcp--drain)
      (should (= calls 0))
      (should (equal unread-command-events '(?x)))
      (should (equal timers '((0.01 nil romacs-mcp--drain))))
      (setq unread-command-events nil romacs-mcp--timer nil)
      (romacs-mcp--drain)
      (should (= calls 1))
      (should-not romacs-mcp--queue))))

(ert-deftest romacs-mcp-editor-current-namesake-not-enduring-identity ()
  (let* ((old (generate-new-buffer "mcp-namesake"))
         (name (buffer-name old)) (replacement nil))
    (unwind-protect
        (progn
          (with-current-buffer old (insert "old") (rename-buffer "mcp-renamed" t))
          (setq replacement (get-buffer-create name))
          (with-current-buffer replacement (insert "new"))
          (let ((value (romacs-mcp--buffer-read
                        (romacs-mcp-test--editor-args "name" name "start" 1 "maxChars" 3))))
            (should (equal "new" (gethash "text" value)))
            (should (= (gethash "tick" value)
                       (with-current-buffer replacement (buffer-modified-tick))))))
      (when replacement (kill-buffer replacement)) (kill-buffer old))))

(ert-deftest romacs-mcp-editor-no-expensive-read-paths-and-outer-budget ()
  (let ((buffer (generate-new-buffer "mcp-no-hooks"))
        (romacs-mcp-tools (copy-tree romacs-mcp-tools)) (forbidden nil))
    (unwind-protect
        (progn
          (with-current-buffer buffer (insert "Ελλάδα\n"))
          (romacs-mcp-enable-editor-tools)
          (cl-letf (((symbol-function 'line-number-at-pos) (lambda (&rest _) (push 'lines forbidden) 0))
                    ((symbol-function 'find-file) (lambda (&rest _) (push 'files forbidden)))
                    ((symbol-function 'project-current) (lambda (&rest _) (push 'project forbidden)))
                    ((symbol-function 'font-lock-ensure) (lambda (&rest _) (push 'fontify forbidden))))
            (let* ((result (romacs-mcp--call
                            (romacs-mcp--object
                             "name" "romacs_buffer_read" "arguments"
                             (romacs-mcp-test--editor-args "name" (buffer-name buffer) "start" 1 "maxChars" 4096)) t))
                   (wire (json-serialize result :false-object :false :null-object :null)))
              (should (eq :false (gethash "isError" result)))
              (should (<= (string-bytes wire) romacs-mcp-editor-output-limit))))
          ;; Assert outside production error handlers; mocks must not swallow failures.
          (should-not forbidden))
      (kill-buffer buffer))))

(ert-deftest romacs-mcp-responsive-cancel-stops-deferred-poll ()
  (let* ((romacs-mcp--generation 7) (romacs-mcp--peers '(a))
         (romacs-mcp--active nil) (romacs-mcp--queue nil)
         (romacs-mcp--deferred nil) (romacs-mcp--deferred-timer nil)
         (polls 0) (sent nil))
    (cl-letf (((symbol-function 'process-live-p) (lambda (_) t))
              ((symbol-function 'run-at-time) (lambda (&rest _) 'timer))
              ((symbol-function 'cancel-timer) #'ignore)
              ((symbol-function 'romacs-mcp--send) (lambda (&rest args) (push args sent))))
      (romacs-mcp--defer-request (romacs-mcp-test--request 'a 1) 1
                                 (lambda () (cl-incf polls) nil) nil)
      (romacs-mcp--frame 'a "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":1}}")
      (romacs-mcp--poll-deferred)
      (should (= polls 0))
      (should-not romacs-mcp--deferred)
      (should-not sent))))

(provide 'romacs-mcp-responsive-tests)

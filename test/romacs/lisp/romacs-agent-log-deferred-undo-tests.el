(require 'cl-lib)
(require 'ert)
(require 'romacs-mcp)

(let ((romacs-mcp-call-function romacs-mcp-call-function)
      (romacs-mcp-tools (copy-alist romacs-mcp-tools)))
  (require 'romacs-agent-log))

(defmacro romacs-agent-log-deferred-undo-tests--with-chat (&rest body)
  "Run BODY in a chat with undo enabled."
  (declare (indent 0))
  `(with-temp-buffer
     (romacs-agent-log-mode)
     (setq romacs-agent-log--session (romacs-agent--make :id "undo" :harness 'claude :state 'running)
           romacs-agent-log--end (copy-marker (point-min) t)
           romacs-agent-log--input (point-min-marker))
     (romacs-agent-log--separator t)
     (buffer-enable-undo)
     (goto-char (point-max))
     ,@body))

(ert-deftest romacs-agent-log-selective-undo-continues-after-output ()
  (romacs-agent-log-deferred-undo-tests--with-chat
    (dolist (text '("a" "b" "outside"))
      (insert text)
      (undo-boundary))
    (let ((transient-mark-mode t)
          (last-command 'self-insert-command)
          (this-command 'undo))
      (goto-char (+ 2 romacs-agent-log--input))
      (set-mark romacs-agent-log--input)
      (activate-mark)
      (call-interactively #'undo)
      (should undo-in-region)
      (should (equal (buffer-substring-no-properties romacs-agent-log--input (point-max)) "aoutside"))
      (undo-boundary)
      (romacs-agent-log--stream-root 'text "Streamed output")
      (let ((chrome (buffer-substring (point-min) romacs-agent-log--input))
            (last-command 'undo))
        (should romacs-agent-log--undo-shifts)
        (call-interactively #'undo)
        (should-not romacs-agent-log--undo-shifts)
        (should (equal-including-properties
                 (buffer-substring (point-min) romacs-agent-log--input) chrome))
        (should (equal (buffer-substring-no-properties romacs-agent-log--input (point-max)) "outside"))))))

(ert-deftest romacs-agent-log-undo-after-worker-activity-appears ()
  (romacs-agent-log-deferred-undo-tests--with-chat
    (insert "draft")
    (undo-boundary)
    (let ((start (marker-position romacs-agent-log--input))
          (last-command 'self-insert-command)
          (this-command 'undo))
      (cl-letf (((symbol-function 'romacs-agent-children-rows)
                 (lambda (_) '((:subagent t :state "running" :tool "worker" :title "Reading")))))
        (romacs-agent-log--activity-refresh))
      (should (> romacs-agent-log--input start))
      (let ((chrome (buffer-substring (point-min) romacs-agent-log--input)))
        (run-hooks 'pre-command-hook)
        (call-interactively #'undo)
        (should (equal-including-properties (buffer-string) chrome))))))

(ert-deftest romacs-agent-log-stream-coalesces-without-walking-undo ()
  (romacs-agent-log-deferred-undo-tests--with-chat
    (romacs-agent-log--stream-root 'thinking "Start")
    (goto-char (point-max))
    (insert "draft")
    (let* ((start (marker-position romacs-agent-log--input))
           (entry (cons start (point-max)))
           (history (make-list 10000 entry))
           (unexpected (lambda (&rest _) (ert-fail "Streaming walked the undo list"))))
      (setq buffer-undo-list history)
      (cl-letf (((symbol-function 'romacs-agent-log--shift-undo) unexpected)
                ((symbol-function 'romacs-agent-log--shift-undo-entry) unexpected))
        (romacs-agent-log--stream-root 'thinking "w")
        (let ((boundary buffer-undo-list))
          (should-not (car boundary))
          (should (eq (cdr boundary) history))
          (dotimes (_ 999) (romacs-agent-log--stream-root 'thinking "w"))
          (should (eq buffer-undo-list boundary))))
      (should (cl-every (lambda (record) (eq record entry)) history))
      (should (= romacs-agent-log--input (+ start 1000)))
      (should (= (length romacs-agent-log--undo-shifts) 1))
      (should (eq (caar romacs-agent-log--undo-shifts) history))
      (should (equal (cdar romacs-agent-log--undo-shifts) (cons start 1000))))))

(ert-deftest romacs-agent-log-undo-applies-shifts-across-draft-edits ()
  (romacs-agent-log-deferred-undo-tests--with-chat
    (insert "first")
    (undo-boundary)
    (romacs-agent-log--stream-root 'thinking "First chunk")
    (insert " second")
    (undo-boundary)
    (romacs-agent-log--stream-root 'thinking "Second chunk")
    (should (= (length romacs-agent-log--undo-shifts) 2))
    (let ((last-command 'self-insert-command)
          (this-command 'undo))
      (call-interactively #'undo)
      (should (equal (buffer-substring-no-properties romacs-agent-log--input (point-max)) "first"))
      (let ((last-command 'undo))
        (call-interactively #'undo)
        (should (= romacs-agent-log--input (point-max)))))))


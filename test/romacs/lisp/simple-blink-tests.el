;;; simple-blink-tests.el --- Lexical matching on close insertion -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'ert)
(require 'c-ts-mode)
(require 'paren)

(defun simple-blink-tests--insert (close)
  "Self-insert CLOSE with the interactive blink hook enabled."
  (let ((last-command-event close)
        (noninteractive nil)
        (executing-kbd-macro nil)
        (electric-indent-mode nil)
        (blink-matching-paren-distance 100)
        (blink-paren-function #'blink-matching-open))
    (self-insert-command 1)))

(ert-deftest simple-blink-c-ts-mode-uses-lexical-match ()
  (skip-unless (treesit-language-available-p 'c))
  (with-temp-buffer
    (c-ts-mode)
    (insert "f (a")
    (should (memq forward-sexp-function
                  '(treesit-forward-sexp treesit-forward-sexp-list)))
    (let* ((motion forward-sexp-function)
           (calls 0)
           (count (lambda (&rest _) (cl-incf calls)))
           (show-paren-mode t)
           (blink-matching-paren t)
           (match nil)
           (blink-matching-check-function
            (lambda (beg end)
              (setq match (list beg end))
              (blink-matching-check-mismatch beg end))))
      (advice-add motion :before count)
      (unwind-protect
          (cl-letf (((symbol-function 'pos-visible-in-window-p)
                     (lambda (&rest _) t))
                    ((symbol-function 'sit-for)
                     (lambda (&rest _) (ert-fail "Blink ran with Show Paren enabled"))))
            (simple-blink-tests--insert ?\)))
        (advice-remove motion count))
      (should (equal (buffer-string) "f (a)"))
      (should (= calls 0))
      (should (equal match '(3 6))))))

(ert-deftest simple-blink-lexical-match-in-lisp-and-text ()
  (dolist (mode '(emacs-lisp-mode text-mode))
    (with-temp-buffer
      (funcall mode)
      (insert "f (a")
      (let ((blink-matching-paren t)
            (blink-matching-paren-on-screen t)
            (show-paren-mode nil)
            (highlight nil))
        (cl-letf (((symbol-function 'pos-visible-in-window-p)
                   (lambda (&rest _) t))
                  ((symbol-function 'sit-for)
                   (lambda (&rest _)
                     (setq highlight (cons (overlay-start blink-matching--overlay)
                                           (overlay-end blink-matching--overlay))))))
          (simple-blink-tests--insert ?\)))
        (should (equal highlight '(3 . 4)))
        (should-not (overlay-buffer blink-matching--overlay))
        (should (= (point) 6))))))

(ert-deftest simple-blink-reports-mismatch ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "[a")
    (let ((blink-matching-paren t)
          (echo nil))
      (cl-letf (((symbol-function 'message)
                 (lambda (format &rest args)
                   (setq echo (apply #'format format args)))))
        (simple-blink-tests--insert ?\)))
      (should (equal echo "Mismatched parentheses")))))

(ert-deftest simple-blink-jump-and-restore-point ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "'(a")
    (let ((blink-matching-paren 'jump)
          (blink-matching-paren-on-screen t)
          (show-paren-mode nil)
          (jump nil))
      (cl-letf (((symbol-function 'pos-visible-in-window-p)
                 (lambda (&rest _) t))
                ((symbol-function 'sit-for)
                 (lambda (&rest _) (setq jump (point)))))
        (simple-blink-tests--insert ?\)))
      (should (= jump 2))
      (should (= (point) 5)))))

(ert-deftest simple-blink-honors-distance ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "(abc)")
    (let* ((blink-matching-paren t)
           (show-paren-mode t)
           (match nil)
           (blink-matching-check-function
            (lambda (beg _end) (setq match (list beg)) nil)))
      (dolist (case '((4 nil) (5 1) (nil 1)))
        (let ((blink-matching-paren-distance (car case)))
          (blink-matching-open)
          (should (equal match (cdr case)))
          (should (= (point-min) 1))
          (should (= (point) 6)))))))

;;; simple-blink-tests.el ends here

;;; window-tests.el --- Window resizing tests -*- lexical-binding: t -*-

(require 'ert)

(ert-deftest romacs-delete-other-windows-preserves-subtree-height ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((window-combination-limit nil)
           (window-combination-resize nil)
           (height (window-pixel-height (frame-root-window)))
           (chat (selected-window))
           (discarded (split-window chat nil 'above))
           (composer (let ((window-combination-limit t))
                       (split-window chat -4 'below)))
           (pair (window-parent chat)))
      (window-make-atom pair)
      (window-preserve-size composer nil t)
      (delete-other-windows chat)
      (should-not (window-live-p discarded))
      (should (eq (frame-root-window) pair))
      (should (= (window-pixel-height pair) height))
      (should (= (window-total-height composer) 4)))))

(ert-deftest romacs-delete-other-windows-expands-fixed-height-subtree ()
  (with-temp-buffer
    (let ((buffer (current-buffer))
          (window-combination-limit nil)
          (window-combination-resize nil))
      (save-window-excursion
        (delete-other-windows)
        (let* ((height (window-pixel-height (frame-root-window)))
               (top (selected-window))
               (discarded (split-window top nil 'above))
               (bottom (let ((window-combination-limit t))
                         (split-window top nil 'below)))
               (pair (window-parent top)))
          (dolist (window (list top bottom))
            (set-window-buffer window buffer))
          (with-current-buffer buffer (setq-local window-size-fixed 'height))
          (window-make-atom pair)
          (window--resize-reset)
          (delete-other-windows top)
          (should-not (window-live-p discarded))
          (should (eq (frame-root-window) pair))
          (should (= (window-pixel-height pair) height))
          (should (= (+ (window-pixel-height top) (window-pixel-height bottom))
                     height))
          (should (= (+ (window-pixel-top top) (window-pixel-height top))
                     (window-pixel-top bottom))))))))

(ert-deftest romacs-delete-other-windows-keeps-protected-side-window ()
  (with-temp-buffer
    (let ((side-buffer (current-buffer))
          (window-combination-limit nil)
          (window-combination-resize nil))
      (save-window-excursion
        (delete-other-windows)
        (let* ((chat (selected-window))
               (side (display-buffer-in-side-window
                      side-buffer '((side . right) (window-width . 12)
                                    (window-parameters
                                     . ((no-delete-other-windows . t))))))
               (main-edges (window-pixel-edges (window-main-window)))
               (side-edges (window-pixel-edges side))
               (discarded-column (split-window chat nil 'right))
               (discarded-row (split-window chat nil 'above))
               (composer (let ((window-combination-limit t))
                           (split-window chat -4 'below)))
               (pair (window-parent chat))
               (detail (split-window chat -12 'right))
               (detail-width (window-pixel-width detail))
               (composer-height (window-pixel-height composer)))
          (window-make-atom pair)
          (window-preserve-size detail t t)
          (window-preserve-size composer nil t)
          (delete-other-windows chat)
          (should-not (window-live-p discarded-column))
          (should-not (window-live-p discarded-row))
          (should (eq (window-main-window) pair))
          (should (equal (window-pixel-edges pair) main-edges))
          (should (equal (window-pixel-edges side) side-edges))
          (should (= (window-pixel-width detail) detail-width))
          (should (= (window-pixel-height composer) composer-height))
          (should (= (+ (window-pixel-width chat) (window-pixel-width detail))
                     (window-pixel-width pair)))
          (should (= (+ (window-pixel-height chat) (window-pixel-height composer))
                     (window-pixel-height pair))))))))

;;; window-tests.el ends here

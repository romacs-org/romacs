(ert-deftest gnosis-test-linked-background-protected-ids-error-and-timeout ()
  (dolist (kind '(current history altered invalid reject timeout))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1")
                                      (gnosis-test-linked--question "q2")
                                      (gnosis-test-linked--question "q3"))
      (gnosis-test-linked--answer state)
      (let* ((gnosis-agent-eval-timeout 0)
             (gnosis-agent-review-function
              (lambda (_request yes no)
                (pcase kind
                  ('current (funcall yes (gnosis-test-linked--plan (gnosis-test-linked--question "q2"))))
                  ('history (funcall yes (gnosis-test-linked--plan (gnosis-test-linked--question "q1"))))
                  ('altered (let ((q (gnosis-test-linked--question "q3")))
                              (setf (plist-get q :question) "Changed")
                              (funcall yes (gnosis-test-linked--plan q))))
                  ('invalid (funcall yes '(:invalid t)))
                  ('reject (funcall no "Offline")))
                #'ignore)))
        (gnosis-agent-review--start-background state)
        (gnosis-agent-review--present state)
        (gnosis-agent-review--drain-background state)
        (should (equal '("q2" "q3") (gnosis-review-state-remaining state)))
        (should (equal "q2" (plist-get (plist-get (gnosis-agent-review--data state) :current) :id)))
        (should (plist-get (aref (plist-get (gnosis-agent-review--data state) :attempts) 0) :error))
        (should (= 1 (gnosis-review-state-reviewed state)))))))


(ert-deftest gnosis-test-linked-background-rollback-and-cancel-reentry ()
  (dolist (reentry '(nil t))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1")
                                      (gnosis-test-linked--question "q2")
                                      (gnosis-test-linked--question "q3"))
      (gnosis-test-linked--answer state)
      (let ((gnosis-agent-review-function
             (lambda (_request yes _no)
               (funcall yes (gnosis-test-linked--plan (gnosis-test-linked--question "new")))
               (lambda ()
                 (when reentry
                   (let ((data (gnosis-agent-review--copy (gnosis-agent-review--data state))))
                     (setf (plist-get data :agent-note) "Successor owns this revision")
                     (gnosis-agent-review--commit state data (gnosis-review-state-remaining state))))))))
        (gnosis-agent-review--start-background state)
        (let ((before (gnosis-review--session-target)))
          (if reentry
              (should-error (gnosis-agent-review--drain-background state) :type 'user-error)
            (cl-letf (((symbol-function 'gnosis-review--save-history) (lambda (_) (error "Injected failure"))))
              (should-error (gnosis-agent-review--drain-background state)))
            (should (equal before (gnosis-review--session-target))))
          (should (equal '("q2" "q3") (gnosis-review-state-remaining state)))
          (should (= 1 (gnosis-review-state-reviewed state)))
          (when reentry
            (should (equal "Successor owns this revision" (plist-get (gnosis-agent-review--data state) :agent-note)))))))))


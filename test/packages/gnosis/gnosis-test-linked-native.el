          (should (= 1 (gnosis-review-state-reviewed historic)))
          (should (equal '("q2") (gnosis-review-state-remaining historic))))
        (when (eq retire 'buffer) (should (equal successor (buffer-string))))
        (gnosis-test-linked--empty-evidence)))))

(ert-deftest gnosis-test-linked-native-pause-reopen-resume ()
  "Preserve native partial cloze input through C-g and public cold resume."
  (skip-unless (not noninteractive))
  (gnosis-test-linked--with (vector (gnosis-test-linked--question "cloze" "cloze"))
    (let* ((reads 0) timer (next nil)
           (id (gnosis-review-state-session-id state))
           (gnosis-agent--launches nil)
           (minibuffer-setup-hook
            (cons (lambda ()
                    (when (string-match-p "Answer:" (minibuffer-prompt))
                      (cl-incf reads)
                      (setq unread-command-events
                            (pcase reads
                              (1 (append (string-to-list "increases") (list ?\r)))
                              (2 (list ?\C-g))
                              (3 (append (string-to-list "opens") (list ?\r)))
                              (_ (ert-fail "A captured blank was requested again"))))))
                  minibuffer-setup-hook)))
      (condition-case nil (gnosis-review--run-state review state) (quit nil))
      (should (= reads 2))
      (should (= 0 (gnosis-review-state-reviewed state)))
      (let ((before (gnosis-agent-review--copy (gnosis-agent-review--data state))))
        (gnosis-sqlite-close gnosis-db)
        (setq gnosis-db (gnosis-sqlite-open gnosis-test--db-file))
        (gnosis-db-init)
        (should (equal before (gnosis-agent-review--data (gnosis-review--read-session)))))
      (gnosis-agent-review-bind-provider
       id gnosis-db (lambda (&rest _) (ert-fail "Cold native resume inferred a provider call")))
      (let ((start-key (lookup-key global-map [gnosis-test-linked-start]))
            (done-key (lookup-key global-map [gnosis-test-linked-done])))
        (unwind-protect
            (progn
              (define-key global-map [gnosis-test-linked-start]
                          (lambda () (interactive) (gnosis-agent-resume id)))
              (define-key global-map [gnosis-test-linked-done] #'exit-recursive-edit)
              (setq timer (run-at-time
                           0.01 0.01
                           (lambda ()
                             (cond
                              ((equal "completed" (plist-get (gnosis-agent-status id) :status))
                               (setq unread-command-events '(gnosis-test-linked-done)))
                              ((and (bound-and-true-p gnosis-review-feedback-mode) (not next))
                               (setq next t unread-command-events (list ?n)))))))
              ;; Schedule from an ordinary command in this test's native loop;
              ;; the package's real timer and ordinary event do the handoff.
              (setq unread-command-events '(gnosis-test-linked-start))
              (with-timeout (10 (ert-fail "Cold native resume timed out"))
                (recursive-edit))
              (should (equal "completed" (plist-get (gnosis-agent-status id) :status))))
          (define-key global-map [gnosis-test-linked-start] start-key)
          (define-key global-map [gnosis-test-linked-done] done-key)
          (when timer (cancel-timer timer))
          (dolist (record (copy-sequence gnosis-agent--launches)) (gnosis-agent--release record))))
      (should (= reads 3))
      (should next)
      (should (= 1 (plist-get (gnosis-agent-status id) :accepted)))
      (gnosis-test-linked--empty-evidence))))

(ert-deftest gnosis-test-linked-native-command-loop-mixed ()
  "Drive native minibuffers, one semantic submit and actual feedback Next."
  (skip-unless (not noninteractive))
  (gnosis-test-linked--with
      (vconcat
       (mapcar (lambda (type)
                 (let ((question (gnosis-test-linked--question type type)))
                   (setf (plist-get question :parathema)
                         "Opening permits flow.\n\n[[id:synthetic-source][Valve physiology α]]")
                   question))
               '("basic" "cloze" "mcq" "mc-cloze" "agent-eval")))
    (let* ((semantic 0) (native-inputs 0) (nexts 0) (adapt 0)
           (submitted nil) timer failure late
           (last-feedback nil)
           (minibuffer-setup-hook
            (cons
             (lambda ()
               (when (and (active-minibuffer-window)
                          (string-match-p (regexp-opt '("Answer:" "Select answer:")) (minibuffer-prompt)))
                 (cl-incf native-inputs)
                 (let* ((current (plist-get (gnosis-agent-review--data state) :current))
                        (id (plist-get current :id))
                        (answer (if (and (equal id "cloze") (= native-inputs 2)) "increases" "opens")))
                   (when (and (equal id "mcq") late)
                     (funcall late (gnosis-test-linked--plan (gnosis-test-linked--question "stale")))
                     (setq late nil))
                   (setq unread-command-events
                         (append (string-to-list answer) (list ?\r))))))
             minibuffer-setup-hook)))
      (gnosis-agent-review-bind-provider
       (gnosis-review-state-session-id state) gnosis-db
       (lambda (request resolve reject)
         (if (equal (plist-get request :phase) "evaluate")
             (progn
               (cl-incf semantic)
               (should (equal "Native α\nresponse 🧠" (plist-get request :response)))
               (funcall resolve '(:api-version 2 :evaluation (:verdict "pass" :explanation "Opening.")
                                 :adjustment nil)))
           (cl-incf adapt)
           (if (= adapt 1) (setq late resolve) (funcall reject "Optional adjustment offline")))
         #'ignore))
      (setq timer
            (run-at-time
             0.01 0.01
             (lambda ()
               (condition-case err
                   (cond
                    ((and (derived-mode-p 'gnosis-agent-eval-mode) (not submitted))
                     (setq submitted t)
                     (insert "Native α\nresponse 🧠")
                     (setq unread-command-events (listify-key-sequence (kbd "C-c C-c"))))
                    ((and (bound-and-true-p gnosis-review-feedback-mode)
                          (not (eq last-feedback gnosis-review--feedback)))
                     (setq last-feedback gnosis-review--feedback)
                     (should-not (string-match-p "matched-blank-index" (buffer-string)))
                     (should-not (string-match-p "\\[\\[id:synthetic-source" (buffer-string)))
                     (should (string-match-p "Valve physiology α" (buffer-string)))
                     (save-excursion
                       (goto-char (point-min))
                       (while (search-forward "\n" nil t)
                         (should-not
                          (memq 'gnosis-face-directions
                                (ensure-list (get-text-property (1- (point)) 'face))))))
                     (should (= nexts (gnosis-review-state-reviewed state)))
                     (cl-incf nexts)
                     (setq unread-command-events (list ?n))))
                 ((error quit) (setq failure err unread-command-events (list ?\C-g)))))))
      (unwind-protect
          (with-timeout (15 (if failure (signal (car failure) (cdr failure))
                             (ert-fail "Mixed native journey timed out")))
            (gnosis-review--run-state review state))
        (cancel-timer timer))
      (when failure (signal (car failure) (cdr failure)))
      (should (= native-inputs 5))
      (should (= semantic 1))
      (should (= nexts 5))
      (should (= 5 (gnosis-review-state-reviewed state)))
      (should-not (gnosis-review--work-p state))
      (should-not unread-command-events)
      (should-not (featurep 'hermes))
      (should-not (seq-find (lambda (q) (equal (plist-get q :id) "stale"))
                            (plist-get (gnosis-agent-review--data state) :questions)))
      (gnosis-test-linked--empty-evidence))))

(ert-deftest gnosis-test-linked-feedback-cloze-response-is-readable ()
  "Project captured cloze input, without replacing its durable JSON evidence."
  (dolist (answers '(("?") ("increases" "opens") ("increases" "[[id:literal][typed α]]")))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1" "cloze"))
      (let ((inputs (copy-sequence answers)) response)
        (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                   (lambda (&rest _) (pop inputs)))
                  ((symbol-function 'gnosis-review--read-action)
                   (lambda (_)
                     (setq response (plist-get (plist-get (gnosis-agent-review--data state) :current) :response))
                     (should (string-match-p "matched-blank-index" response))
                     (should-not (string-match-p "matched-blank-index" (buffer-string)))
                     (dolist (answer answers)
                       (should (string-match-p (regexp-quote answer) (buffer-string))))
                     ?n)))
          (gnosis-agent-review--question-input state))
        (should (equal response (plist-get (aref (plist-get (gnosis-agent-review--data state) :encounters) 0) :response)))
        (should (= 1 (gnosis-review-state-reviewed state)))
        (let* ((encounter (aref (plist-get (gnosis-agent-review--data state) :encounters) 0))
               (expected (if (equal answers '("increases" "opens")) "success" "failure")))
          (should (equal expected (plist-get encounter :outcome))))
        (gnosis-test-linked--empty-evidence)))))

(ert-deftest gnosis-test-linked-feedback-authored-explanation ()
  "Format authored explanation links, but keep typed response markup literal."
  (let* ((q (gnosis-test-linked--question "q1"))
         (authored "The valve opens.\n\n[[id:synthetic-source][Valve physiology α]]")
         (typed "[[id:literal][my typed answer]]"))
    (setf (plist-get q :parathema) authored)
    (gnosis-test-linked--with (vector q)
      (cl-letf (((symbol-function 'gnosis--read-string-with-input-method) (lambda (&rest _) typed))
                ((symbol-function 'gnosis-review--read-action)
                 (lambda (_)
                   (should (string-match-p "Explanation: The valve opens" (buffer-string)))
                   (should-not (string-match-p "Native text matching" (buffer-string)))
                   (should (< (string-match "Explanation:" (buffer-string))
                              (string-match "Reference answer:" (buffer-string))))
                   (should (string-match-p
                            "Native text matching"
                            (plist-get (plist-get
                                        (plist-get (gnosis-agent-review--data state) :current)
                                        :evaluation) :explanation)))
                   (should (string-match-p "Valve physiology α" (buffer-string)))
                   (should-not (string-match-p "\\[\\[id:synthetic-source" (buffer-string)))
                   (should (string-match-p (regexp-quote typed) (buffer-string)))
                   (goto-char (point-min))
                   (search-forward "Valve physiology α")
                   (should (memq 'org-link (ensure-list (get-text-property (1- (point)) 'face))))
                   ?n)))
        (gnosis-agent-review--question-input state))
      (should (equal authored (plist-get (gnosis-agent-review--find (gnosis-agent-review--data state) "q1") :parathema)))
      (gnosis-test-linked--empty-evidence))))

(ert-deftest gnosis-test-linked-feedback-label-newlines-unstyled ()
  "Keep wrapped label underlines out of the centered line-prefix whitespace."
  (dolist (center '(nil t))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1"))
      (setq-local gnosis-center-content center fill-column 14)
      (cl-letf (((symbol-function 'gnosis--read-string-with-input-method) (lambda (&rest _) "?"))
                ((symbol-function 'gnosis-review--read-action)
                 (lambda (_)
                   (goto-char (point-min))
                   (search-forward "Your response:")
                   (should (memq 'gnosis-face-directions (ensure-list (get-text-property (- (point) 2) 'face))))
                   (goto-char (point-min))
                   (while (search-forward "\n" nil t)
                     (should-not (memq 'gnosis-face-directions
                                       (ensure-list (get-text-property (1- (point)) 'face)))))
                   ?n)))
        (gnosis-agent-review--question-input state))
      (gnosis-test-linked--empty-evidence))))


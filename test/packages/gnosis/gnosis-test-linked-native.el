(ert-deftest gnosis-test-linked-provisional-reopen-acceptance-rollback ()
  (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1" "agent-eval"))
    (let ((gnosis-agent-review-function
           (lambda (_request yes _no)
             (funcall yes (list :api-version 2 :evaluation '(:verdict "pass" :explanation "Correct.")
                                :adjustment (gnosis-test-linked--plan (gnosis-test-linked--question "next"))))
             #'ignore)))
      (cl-letf (((symbol-function 'recursive-edit)
                 (lambda () (insert "opens") (gnosis-agent-eval-submit) (signal 'quit nil))))
        (condition-case nil (gnosis-agent-review--question-input state) (quit nil))))
    (let ((before (gnosis-agent-review--copy (gnosis-agent-review--data state))))
      (gnosis-sqlite-close gnosis-db)
      (setq gnosis-db (gnosis-sqlite-open gnosis-test--db-file))
      (gnosis-db-init)
      (setq state (gnosis-review--read-session) gnosis-review--state state)
      (should (equal before (gnosis-agent-review--data state))))
    (let (pending)
      (cl-letf (((symbol-function 'gnosis-agent-eval--read) #'ignore)
                ((symbol-function 'gnosis-review-actions) (lambda (_success _id result) (setq pending result))))
        (gnosis-agent-review--question-input state))
      (let ((before (gnosis-review--session-target)))
        (cl-letf (((symbol-function 'gnosis-review--save-history) (lambda (_) (error "Injected failure"))))
          (should-error (gnosis-review-result "q1" t pending)))
        (should (equal before (gnosis-review--session-target)))
        (should (equal before (cons gnosis-db (gnosis-review--state-data state)))))
      (gnosis-review-result "q1" t pending)
      (should (equal '("next") (gnosis-review-state-remaining state)))
      (should-error (gnosis-review-result "q1" t pending)))
    (gnosis-test-linked--empty-evidence)))


(defun gnosis-test-linked--question (id &optional type)
  "Return a fresh synthetic question with ID and TYPE."
  (let ((type (or type "basic")))
    (list :id id :type type :question "The α valve opens and flow increases."
          :answer (if (equal type "cloze") ["opens" "increases"] ["opens"])
          :choices (if (member type '("mcq" "mc-cloze")) ["opens" "closes"] [])
          :rubric (when (equal type "agent-eval") "Require opening.")
          :hints [] :parathema nil :tags ["synthetic"] :source "Synthetic valve source α")))

(defun gnosis-test-linked--reserve (questions)
  "Reserve new-protocol QUESTIONS without a deferred launch."
  (cl-letf (((symbol-function 'gnosis-agent--schedule) #'ignore))
    (gnosis-agent-start-review-session :questions questions :goal "Synthetic recall" :source "Synthetic"))
  (gnosis-review--read-session))

(defmacro gnosis-test-linked--with (questions &rest body)
  "Run BODY with STATE and REVIEW for new-protocol QUESTIONS."
  (declare (indent 1))
  `(gnosis-test-with-db
     (let* ((gnosis-review-buffer-name (generate-new-buffer-name "*linked native test*"))
            (gnosis-review-centered nil)
            (gnosis-agent-review--providers nil)
            (gnosis-agent-review--background nil)
            (state (gnosis-test-linked--reserve ,questions))
            (review (gnosis-review--setup-buffer nil 'practice)))
       (unwind-protect
           (with-current-buffer review
             (setq gnosis-review--state state)
             ,@body)
         (gnosis-agent-review--stop-background)
         (when (buffer-live-p review) (kill-buffer review))))))

(defun gnosis-test-linked--plan (&rest questions)
  "Return a finite unseen tail of QUESTIONS."
  (list :agent-note "Finite synthetic adjustment" :context '(:topic "valve")
        :remaining (vconcat questions) :done (if questions :false t)))

(defun gnosis-test-linked--empty-evidence ()
  "Assert no permanent collection, practice or FSRS evidence was created."
  (dolist (table '(themata extras thema-tag thema-links scheduler-state scheduler-baseline
                          review-events practice-events practice-encounters))
    (should-not (gnosis-select '* table))))

(defun gnosis-test-linked--answer (state &optional text)
  "Answer STATE with controlled native input TEXT and real Next acceptance."
  (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
             (lambda (&rest _) (or text "opens")))
            ((symbol-function 'gnosis-review--read-action) (lambda (_) ?n)))
    (gnosis-agent-review--question-input state)))

(ert-deftest gnosis-test-linked-types-native-matching-no-provider ()
  (dolist (type '("basic" "cloze" "mcq" "mc-cloze"))
    (dolist (wrong '(nil t))
      (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1" type))
        (let ((gnosis-agent-review-function (lambda (&rest _) (ert-fail "No semantic request for native input")))
              (answers (if wrong '("closes") '("increases" "opens"))))
          (cl-letf (((symbol-function 'gnosis--read-string-with-input-method)
                     (lambda (&rest _) (if (equal type "cloze") (pop answers)
                                         (if wrong "closes" "opens"))))
                    ((symbol-function 'gnosis-completing-read)
                     (lambda (_prompt options &rest _)
                       (should (equal options '("opens" "closes")))
                       (if wrong "closes" "opens")))
                    ((symbol-function 'gnosis-review--read-action)
                     (lambda (_)
                       (should (string-match-p "(native) — not yet accepted" (buffer-string)))
                       (should (= 0 (gnosis-review-state-reviewed state))) ?n)))
            (gnosis-agent-review--run state)))
        (let ((encounter (aref (plist-get (gnosis-agent-review--data state) :encounters) 0)))
          (should (equal (plist-get encounter :outcome) (if wrong "failure" "success")))
          (should (equal (plist-get (plist-get encounter :question) :type) type)))
        (should (= 3 (plist-get (gnosis-review--state-data state) :version)))
        (should-not (gnosis-review--work-p state))
        (gnosis-test-linked--empty-evidence)))))

(ert-deftest gnosis-test-linked-combined-one-call-and-native-override ()
  (dolist (override '(nil t))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1" "agent-eval")
                                      (gnosis-test-linked--question "prepared"))
      (let* ((calls 0) (choices (if override '(?o ?n ?n) '(?n ?n)))
             (gnosis-agent-review-function
              (lambda (request resolve _reject)
                (cl-incf calls)
                (should (= 2 (plist-get request :api-version)))
                (should (equal "evaluate" (plist-get request :phase)))
                (should (equal ["prepared"]
                               (vconcat (mapcar (lambda (q) (plist-get q :id)) (plist-get request :remaining)))))
                (funcall resolve (list :api-version 2
                                       :evaluation '(:verdict "fail" :explanation "Opening is required.")
                                       :adjustment (gnosis-test-linked--plan
                                                    (gnosis-test-linked--question "repair"))))
                #'ignore)))
        (cl-letf (((symbol-function 'recursive-edit)
                   (lambda () (insert "Literal α\nresponse 🧠") (gnosis-agent-eval-submit)))
                  ((symbol-function 'gnosis--read-string-with-input-method) (lambda (&rest _) "opens"))
                  ((symbol-function 'gnosis-review--read-action) (lambda (_) (pop choices)))
                  ((symbol-function 'read-multiple-choice) (lambda (&rest _) (ert-fail "No adaptation barrier"))))
          (gnosis-agent-review--run state))
        (should (= calls 1))
        (let ((encounters (plist-get (gnosis-agent-review--data state) :encounters)))
          (should (= 2 (length encounters)))
          (should (equal (plist-get (aref encounters 0) :response) "Literal α\nresponse 🧠"))
          (should (equal (plist-get (aref encounters 0) :outcome) (if override "success" "failure")))
          (should (equal (plist-get (plist-get (aref encounters 1) :question) :id)
                         (if override "prepared" "repair"))))
        (gnosis-test-linked--empty-evidence)))))

(ert-deftest gnosis-test-linked-background-late-safe-and-conflicting ()
  (dolist (consume '(nil t))
    (gnosis-test-linked--with (vector (gnosis-test-linked--question "q1")
                                      (gnosis-test-linked--question "prepared")
                                      (gnosis-test-linked--question "tail"))
      (gnosis-test-linked--answer state)
      (let* (resolve request
             (gnosis-agent-review-function
              (lambda (r yes _no) (setq resolve yes request r) #'ignore)))
        (gnosis-agent-review--start-background state)
        (should (equal "adapt" (plist-get request :phase)))
        (should (equal ["tail"] (vconcat (mapcar (lambda (q) (plist-get q :id))
                                                (plist-get request :remaining)))))
        (if consume (gnosis-test-linked--answer state)
          (gnosis-agent-review--present state))
        (let ((current (gnosis-agent-review--copy (plist-get (gnosis-agent-review--data state) :current)))
              (history (gnosis-agent-review--copy (plist-get (gnosis-agent-review--data state) :encounters)))
              (before (gnosis-review--session-target)))
          (funcall resolve (gnosis-test-linked--plan (gnosis-test-linked--question "replacement")))
          (should (equal before (gnosis-review--session-target)))
          (gnosis-agent-review--drain-background state)
          (should (equal current (plist-get (gnosis-agent-review--data state) :current)))
          (should (equal history (plist-get (gnosis-agent-review--data state) :encounters)))
          (should (equal (gnosis-review-state-remaining state)
                         (if consume '("tail") '("prepared" "replacement"))))
          (let ((before (gnosis-review--session-target)))
            (funcall resolve (gnosis-test-linked--plan))
            (gnosis-agent-review--drain-background state)
            (should (equal before (gnosis-review--session-target))))))
      (gnosis-test-linked--empty-evidence))))


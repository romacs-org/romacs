#!/usr/bin/env python3
"""Reversible benchmark runtime tuning; no boot configuration is changed.

Hold ~/romacs-bench/.lock with flock and export its inherited descriptor as
ROMACS_BENCH_LOCK_FD. Use on --profile quiet|isolated|isolated+sibling-offline
[--turbo off], off, status [--json], fingerprint, or run -- COMMAND.
Explicit multi-chunk sessions: session begin --token TOKEN --profile isolated;
export ROMACS_BENCH_SESSION=TOKEN for on/run/off in every admitted chunk;
session end --token TOKEN restores once. Keep the shared lock for each command,
not the whole session: release/requeue between <=45-minute chunks. Compatible
sessions share one preparation; only the last participant restores. Each owner
has a one-hour lease renewed at begin. A different profile or expired lease is
restored/re-prepared by the next lock holder; displaced tokens can rejoin. Legacy
on/run/off chunks join temporarily with their parent process identity. Foreign
tokens cannot end another participant. off cleans tracked scopes but retains
explicit preparation; recover crashes with session end
--token TOKEN (the token is recorded in status). Legacy on/off remains a single
chunk lifecycle. Recent unit starts near StartLimitBurst refuse preparation
before any mutation: wait for the reported window, never reset it to force entry.
sibling-offline reserves CPU3 and offlines CPU2 until restore; CPU0 stays online.
"""
import argparse
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import signal
import socket
import uuid
import stat
import subprocess
import sys
import tempfile
import time


NOISE_UNITS = (
    'cups.socket', 'cups.path', 'avahi-daemon.socket', 'avahi-daemon.service',
    'udisks2.service', 'snapper-timeline.timer', 'snapper-cleanup.timer',
    'snapper-boot.timer', 'snapper-sync.timer',
    'sddm.service', 'packagekit.service', 'updatedb.timer', 'man-db.timer',
    'fstrim.timer', 'paccache.timer', 'plocate-updatedb.timer',
    'power-profiles-daemon.service', 'pacman-init.timer', 'pacman-keyring-wkd-sync.timer',
    'systemd-tmpfiles-clean.timer', 'fwupd.service', 'fwupd-refresh.timer',
    'cups.service', 'cups-browsed.service', 'bluetooth.service',
    'updatedb.service', 'man-db.service', 'fstrim.service', 'paccache.service',
    'plocate-updatedb.service', 'systemd-tmpfiles-clean.service', 'fwupd-refresh.service',
)
# Stop the desktop before its clients' D-Bus-activated daemons.
DESKTOP_UNITS = ('sddm.service', 'bluetooth.service', 'power-profiles-daemon.service')
STOP_UNITS = (*DESKTOP_UNITS, *(unit for unit in NOISE_UNITS if unit not in DESKTOP_UNITS))
SLICES = ('system.slice', 'user.slice', 'init.scope', 'romacs-bench.slice')
TURBO_PATHS = ('/sys/devices/system/cpu/intel_pstate/no_turbo',
               '/sys/devices/system/cpu/cpufreq/boost')
PROFILES = ('quiet', 'isolated', 'isolated+sibling-offline')
SIBLING_ONLINE = '/sys/devices/system/cpu/cpu2/online'
SESSION_LEASE_SECONDS = 3600


def execute(command, *, input=None):
    result = subprocess.run(command, input=input, text=True, capture_output=True,
                            env=dict(os.environ, LC_ALL='C'))
    if result.returncode:
        raise RuntimeError(f'{command!r}: {result.stdout.strip()} {result.stderr.strip()}')
    return result.stdout.strip()


def validate_lock(path, descriptor=None):
    try:
        descriptor = int(os.environ['ROMACS_BENCH_LOCK_FD'] if descriptor is None else descriptor)
        held = os.fstat(descriptor)
        expected = path.stat()
        if not stat.S_ISREG(held.st_mode) or (held.st_dev, held.st_ino) != (expected.st_dev, expected.st_ino):
            raise ValueError('lock descriptor does not name the benchmark lock')
        with path.open('r') as probe:
            try:
                fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                pass
            else:
                fcntl.flock(probe, fcntl.LOCK_UN)
                raise ValueError('benchmark lock is not held')
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (KeyError, OSError, ValueError) as error:
        raise RuntimeError(f'valid inherited ROMACS_BENCH_LOCK_FD required: {error}') from error
    return descriptor


class BenchMode:
    def __init__(self, state, runner=execute, root=Path('/'), hostname=None):
        self.state = Path(state)
        self.runner = runner
        self.root = Path(root)
        self.hostname = hostname or socket.gethostname().split('.')[0]

    def path(self, value):
        return self.root / value.lstrip('/')

    def read(self, value):
        return self.path(value).read_text().strip()

    def show(self, unit, property):
        return self.runner(['systemctl', 'show', unit, '--property=' + property, '--value'])

    def save(self, journal):
        self.state.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix='.bench-mode-', dir=self.state.parent)
        try:
            with os.fdopen(fd, 'w') as stream:
                json.dump(journal, stream, indent=2, sort_keys=True)
                stream.write('\n')
                stream.flush()
                os.fsync(stream.fileno())
            os.replace(temporary, self.state)
            self.sync_directory()
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)

    def sync_directory(self):
        fd = os.open(self.state.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

    def load(self):
        if not self.state.exists():
            return None
        journal = json.loads(self.state.read_text())
        if journal['host'] != self.hostname or journal['version'] not in (1, 2, 3):
            raise RuntimeError('journal host/version mismatch')
        return journal

    def fingerprint(self):
        online = normalize_cpus(self.read('/sys/devices/system/cpu/online'))
        present = normalize_cpus(self.read('/sys/devices/system/cpu/present'))
        policies = []
        for policy in sorted(self.path('/sys/devices/system/cpu/cpufreq').glob('policy*')):
            if not policy.is_dir():
                continue
            try:
                affected = normalize_cpus((policy / 'affected_cpus').read_text())
            except OSError as error:
                if error.errno != errno.EBUSY:
                    raise
                continue
            if affected & online:
                policies.append(policy)
        governors = {str(p.relative_to(self.root)): p.read_text().strip()
                     for policy in policies for p in [policy / 'scaling_governor']}
        turbo = {p: self.read(p) for p in TURBO_PATHS if self.path(p).exists()}
        thp = {p: self.read(p) for p in (
            '/sys/kernel/mm/transparent_hugepage/enabled',
            '/sys/kernel/mm/transparent_hugepage/defrag') if self.path(p).exists()}
        cpusets = {unit: {key: self.show(unit, key) for key in ('AllowedCPUs', 'EffectiveCPUs')}
                   for unit in SLICES}
        services = {unit: self.show(unit, 'ActiveState') for unit in
                    sorted((*NOISE_UNITS, 'sshd.service', 'tailscaled.service'))}
        frequency = {str(p.relative_to(self.root)): p.read_text().strip()
                     for policy in policies for name in ('scaling_min_freq', 'scaling_max_freq')
                     for p in [policy / name]}
        power = {str(p.relative_to(self.root)): p.read_text().strip()
                 for p in sorted(self.path('/sys/class/power_supply').glob('*/online'))}
        actual = {'host': self.hostname, 'governors': governors, 'frequency_limits': frequency,
                  'ac_online': power, 'turbo': turbo, 'thp': thp,
                  'cpusets': cpusets, 'services': services,
                  'online_cpus': sorted(online), 'offline_cpus': sorted(present - online),
                  'stopped_services': sorted(unit for unit in NOISE_UNITS if services[unit] == 'inactive'),
                  'graphical_target': self.show('graphical.target', 'ActiveState')}
        digest = hashlib.sha256(json.dumps(actual, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
        return {'sha256': digest, 'actual': actual}

    def plan(self, profile, turbo, *, include_unchanged=False):
        if profile not in PROFILES:
            raise RuntimeError('unknown benchmark profile')
        actions = []
        governors = sorted(self.path('/sys/devices/system/cpu/cpufreq').glob('policy*/scaling_governor'))
        if not governors:
            raise RuntimeError('no CPU frequency governors found')
        for governor in governors:
            path = '/' + str(governor.relative_to(self.root))
            available = governor.with_name('scaling_available_governors')
            if 'performance' not in available.read_text().split():
                raise RuntimeError(f'performance governor unavailable: {governor}')
            actions.append({'kind': 'file', 'target': path, 'before': self.read(path), 'after': 'performance'})
        if turbo == 'off':
            paths = [p for p in TURBO_PATHS if self.path(p).exists()]
            if not paths:
                raise RuntimeError('turbo control unavailable')
            for path in paths:
                actions.append({'kind': 'file', 'target': path, 'before': self.read(path),
                                'after': '1' if path.endswith('no_turbo') else '0'})
        for unit in STOP_UNITS:
            state = self.show(unit, 'ActiveState')
            if state == 'active':
                actions.append({'kind': 'service', 'target': unit, 'before': 'active', 'after': 'inactive'})
            elif state not in ('inactive', 'failed', ''):
                raise RuntimeError(f'unit is transitioning: {unit}: {state}')
        if profile in PROFILES[1:]:
            online = self.read('/sys/devices/system/cpu/online')
            cpus = set()
            for item in online.split(','):
                bounds = item.split('-')
                cpus.update(range(int(bounds[0]), int(bounds[-1]) + 1))
            if not {0, 1, 2, 3} <= cpus:
                raise RuntimeError('isolated profile requires online CPUs 0,1,2,3')
            if profile == 'isolated+sibling-offline':
                for cpu in (2, 3):
                    topology = f'/sys/devices/system/cpu/cpu{cpu}/topology/'
                    if (self.read(topology + 'core_id') != '1'
                            or normalize_cpus(self.read(topology + 'thread_siblings_list')) != {2, 3}):
                        raise RuntimeError('sibling-offline requires core1 siblings CPUs 2,3')
                if self.read(SIBLING_ONLINE) != '1':
                    raise RuntimeError('sibling-offline requires CPU2 online before tuning')
            for unit in SLICES:
                actions.append({'kind': 'cpuset', 'target': unit,
                                'before': self.show(unit, 'AllowedCPUs'),
                                'after': ('3' if profile == 'isolated+sibling-offline' else '2,3')
                                if unit == 'romacs-bench.slice' else '0,1'})
            state = self.show('romacs-bench.slice', 'ActiveState')
            actions.append({'kind': 'slice', 'target': 'romacs-bench.slice',
                            'before': state, 'after': 'active'})
            if profile == 'isolated+sibling-offline':
                actions.append({'kind': 'cpu-online', 'target': SIBLING_ONLINE,
                                'before': '1', 'after': '0'})
        return actions if include_unchanged else [action for action in actions if action['before'] != action['after']]

    def start_restored_unit(self, unit):
        try:
            self.runner(['sudo', '-n', 'systemctl', 'reset-failed', unit])
        except RuntimeError as error:
            # systemd can garbage-collect an idle unit after stop. Its start
            # limit is gone too; reset-failed rejects it but start can load it.
            if f'Unit {unit} not loaded.' not in str(error) or self.show(unit, 'ActiveState') != 'inactive':
                raise
        self.runner(['sudo', '-n', 'systemctl', 'start', unit])

    def apply(self, action, restore=False):
        target = action['target']
        value = action['before' if restore else 'after']
        if action['kind'] in ('file', 'cpu-online'):
            if action['kind'] == 'cpu-online' and (target != SIBLING_ONLINE or value not in ('0', '1')):
                raise RuntimeError('refusing unexpected CPU hotplug action')
            self.runner(['sudo', '-n', 'tee', target], input=value + '\n')
            actual = self.read(target)
            if actual != value:
                raise RuntimeError(f'write verification failed: {target}: {actual!r} != {value!r}')
            if action['kind'] == 'cpu-online':
                online = normalize_cpus(self.read('/sys/devices/system/cpu/online'))
                if (2 in online) != (value == '1') or not {0, 1, 3} <= online:
                    raise RuntimeError('CPU online-set verification failed')
        elif action['kind'] == 'service':
            if target not in NOISE_UNITS or target in ('sshd.service', 'tailscaled.service'):
                raise RuntimeError('refusing non-noise service')
            if restore:
                self.start_restored_unit(target)
            else:
                self.runner(['sudo', '-n', 'systemctl', 'stop', target])
            actual = self.show(target, 'ActiveState')
            if actual != value:
                raise RuntimeError(f'service verification failed: {target}: {actual}')
        elif action['kind'] == 'slice':
            if target != 'romacs-bench.slice' or value not in ('active', 'inactive'):
                raise RuntimeError('invalid benchmark slice state')
            if restore and value == 'active':
                self.start_restored_unit(target)
            else:
                self.runner(['sudo', '-n', 'systemctl', 'start' if value == 'active' else 'stop', target])
            if self.show(target, 'ActiveState') != value:
                raise RuntimeError('benchmark slice state verification failed')
        elif action['kind'] == 'cpuset':
            if target not in SLICES:
                raise RuntimeError('refusing unknown cgroup')
            self.runner(['sudo', '-n', 'systemctl', 'set-property', '--runtime', target, 'AllowedCPUs=' + value])
            actual = self.show(target, 'AllowedCPUs')
            if normalize_cpus(actual) != normalize_cpus(value):
                raise RuntimeError(f'cpuset verification failed: {target}: {actual}')
        else:
            raise RuntimeError('unknown journal action')

    def check_start_budget(self, actions):
        """Reserve restore headroom before stopping anything; never reset at admission."""
        for action in actions:
            if action['kind'] != 'service' or action['before'] != 'active':
                continue
            unit = action['target']
            burst = int(self.show(unit, 'StartLimitBurst'))
            interval = self.show(unit, 'StartLimitIntervalUSec')
            if burst == 0 or interval == '0':
                continue
            if interval == 'infinity':
                since = '0'
            else:
                parts = re.findall(r'(\d+(?:\.\d+)?)(us|ms|s|min|h|d)', interval.replace(' ', ''))
                if not parts or ''.join(n + u for n, u in parts) != interval.replace(' ', ''):
                    raise RuntimeError(f'cannot read start-limit interval for {unit}: {interval!r}')
                factors = {'us': 0.000001, 'ms': 0.001, 's': 1, 'min': 60, 'h': 3600, 'd': 86400}
                seconds = sum(float(n) * factors[u] for n, u in parts)
                since = str(max(0, time.time() - seconds))
            records = self.runner(['sudo', '-n', 'journalctl', '--quiet', '--no-pager',
                                   '--boot', '--output=json', '--unit=' + unit, '--since=@' + since])
            # Type=simple may emit only Started, not Starting. Count manager
            # start jobs, deduplicating Starting/Started by job identity.
            starts = set()
            for line in records.splitlines():
                entry = json.loads(line)
                if (entry.get('UNIT') == unit and entry.get('_PID') == '1'
                        and entry.get('JOB_TYPE') == 'start'):
                    identity = entry.get('JOB_ID') or entry.get('INVOCATION_ID')
                    if not identity:
                        raise RuntimeError(f'start job without identity for {unit}')
                    starts.add(identity)
            recent = len(starts)
            if recent >= max(1, burst - 1):
                raise RuntimeError(f'{unit}: recent starts {recent} near StartLimitBurst={burst} '
                                   f'within {interval}; wait for the start-limit window before session begin')

    def caller_token(self):
        token = os.environ.get('ROMACS_BENCH_SESSION')
        if token:
            return token
        # Legacy on/run/off calls share their parent worker, not the short-lived
        # bench-mode CLI PID. Include procfs start time to disambiguate PID reuse.
        parent = os.getppid()
        fields = Path(f'/proc/{parent}/stat').read_text().rsplit(')', 1)[1].split()
        return f'legacy-{parent}-{fields[19]}'

    def participants(self, journal):
        session = journal['session']
        if isinstance(session, dict):
            return session['leases']
        # Previous experimental session journals remain recoverable.
        return {session: {'owner': session, 'expires_at': 0}}

    def lease(self, token):
        return {'owner': token, 'caller_pid': os.getppid(),
                'expires_at': time.time() + SESSION_LEASE_SECONDS}

    def require_session(self, journal, token=None):
        if journal.get('session') and (token or self.caller_token()) not in self.participants(journal):
            raise RuntimeError('another explicit session owns the journal; begin a compatible session or supply its token to recover')

    def session_begin(self, token, profile, turbo):
        if not re.fullmatch(r'[A-Za-z0-9_.-]{1,128}', token):
            raise RuntimeError('invalid session token')
        existing = self.load()
        replaced = False
        if existing:
            if not existing.get('session'):
                raise RuntimeError('existing legacy journal: recover with off before session begin')
            participants = self.participants(existing)
            live = {member: lease for member, lease in participants.items()
                    if lease['expires_at'] > time.time()}
            expired = not live
            changed = (existing['profile'], existing['turbo']) != (profile, turbo)
            if expired or changed or existing['phase'] != 'active':
                # The shared lock excludes live admitted work. A different profile
                # or expired owner cannot pin this host indefinitely. Old tokens
                # may rejoin on their next chunk; their eventual end is a no-op.
                self.off(end_session=True)
                replaced = True
            else:
                self.stop_scope(existing)
                if self.fingerprint() != existing['admission_fingerprint']:
                    raise RuntimeError('prepared session fingerprint drift; recover before joining')
                live[token] = self.lease(token)
                existing['session'] = {'leases': live}
                self.save(existing)
                return existing
        deadline = time.monotonic() + 120
        while True:
            try:
                return self.on(profile, turbo, session=token)
            except RuntimeError as error:
                if not replaced or 'near StartLimitBurst=' not in str(error) or time.monotonic() >= deadline:
                    raise
                time.sleep(1)

    def session_end(self, token):
        journal = self.load()
        if journal:
            if not journal.get('session'):
                raise RuntimeError('legacy journal: recover with off')
            self.stop_scope(journal)
            participants = self.participants(journal)
            if token not in participants:
                return {'phase': journal['phase'], 'retained': True, 'not_member': token}
            others = {member: lease for member, lease in participants.items()
                      if member != token and lease['expires_at'] > time.time()}
            if others:
                journal['session'] = {'leases': others}
                self.save(journal)
                return {'phase': journal['phase'], 'session': journal['session'], 'retained': True}
        return self.off(end_session=True)

    def on(self, profile, turbo, *, session=None):
        journal = self.load()
        if journal:
            if journal.get('session') and not session and not os.environ.get('ROMACS_BENCH_SESSION'):
                return self.session_begin(self.caller_token(), profile, turbo)
            self.require_session(journal, session)
            if journal['phase'] == 'active' and (journal['profile'], journal['turbo']) == (profile, turbo):
                return journal
            raise RuntimeError('existing journal: use off before changing mode or recovering')
        power = list(self.path('/sys/class/power_supply').glob('*/online'))
        if power and not any(p.read_text().strip() == '1' for p in power):
            print('bench-mode: WARNING: AC power is not online', file=sys.stderr)
        intended = self.fingerprint()['actual']
        plan = self.plan(profile, turbo, include_unchanged=True)
        self.check_start_budget(plan)
        for action in plan:
            kind, target, wanted = action['kind'], action['target'], action['after']
            if kind == 'file':
                for field in ('governors', 'turbo'):
                    for path in intended[field]:
                        if path.lstrip('/') == target.lstrip('/'):
                            intended[field][path] = wanted
            elif kind == 'service':
                intended['services'][target] = wanted
            elif kind == 'cpuset':
                intended['cpusets'][target] = dict.fromkeys(('AllowedCPUs', 'EffectiveCPUs'), wanted)
            elif kind == 'cpu-online':
                cpu = int(target.split('/cpu')[-1].split('/')[0])
                intended['online_cpus'].remove(cpu)
                intended['offline_cpus'].append(cpu)
        # Hotplug removes inactive cpufreq policies from the public fingerprint.
        for field in ('governors', 'frequency_limits'):
            intended[field] = {path: value for path, value in intended[field].items()
                               if normalize_cpus(self.read(str(Path(path).parent/'affected_cpus')))
                               & set(intended['online_cpus'])}
        intended['stopped_services'] = sorted(unit for unit in NOISE_UNITS if intended['services'][unit] == 'inactive')
        journal = {'version': 1, 'host': self.hostname, 'profile': profile,
                   'turbo': turbo, 'phase': 'applying',
                   'actions': [a for a in plan if a['before'] != a['after']], 'log': []}
        if session:
            journal['version'] = 3
            journal['session'] = {'leases': {session: self.lease(session)}}
        self.save(journal)
        for action in journal['actions']:
            action['pending'] = True
            self.save(journal)
            try:
                self.apply(action)
            except (OSError, RuntimeError) as error:
                journal['log'].append(str(error))
                self.save(journal)
                raise
            action['applied'] = True
            journal['log'].append({'operation': 'apply', 'target': action['target'],
                                   'before': action['before'], 'after': action['after']})
            self.save(journal)
        # Freeze the owner's complete prepared state, including controls that
        # needed no mutation and therefore are absent from the restore journal.
        prepared = self.fingerprint()
        # Validate the exact captured state, not fresh reads after capture.
        def normalized(actual):
            copy = json.loads(json.dumps(actual))
            copy['cpusets'] = {unit: {key: sorted(normalize_cpus(value)) for key, value in values.items()}
                               for unit, values in copy['cpusets'].items()}
            copy['online_cpus'].sort()
            copy['offline_cpus'].sort()
            return copy
        if normalized(prepared['actual']) != normalized(intended):
            raise RuntimeError('prepared fingerprint differs from complete owner plan; recover with off')
        journal['admission_fingerprint'] = prepared
        journal['phase'] = 'active'
        self.save(journal)
        return journal

    def stop_scope(self, journal):
        scope = journal.get('scope')
        if not scope:
            return
        if not re.fullmatch(r'romacs-bench-[0-9a-f]{32}\.scope', scope):
            raise RuntimeError('invalid tracked benchmark scope')
        errors = []
        for operation in (['kill', '--signal=SIGKILL', '--kill-whom=all'], ['stop']):
            try:
                self.runner(['sudo', '-n', 'systemctl', *operation, scope])
            except (OSError, RuntimeError) as error:
                errors.append(str(error))
        state = self.show(scope, 'ActiveState')
        if state == 'failed':
            self.runner(['sudo', '-n', 'systemctl', 'reset-failed', scope])
            journal['log'].append({'operation': 'scope-reset-failed', 'target': scope})
            self.save(journal)
            state = self.show(scope, 'ActiveState')
        if state != 'inactive':
            raise RuntimeError(f'benchmark scope not inactive: {scope}: {state}; {errors}')
        journal['log'].append({'operation': 'scope-stopped', 'target': scope})
        journal.pop('scope')
        self.save(journal)

    def run(self, command):
        journal = self.load()
        if not journal or journal['phase'] != 'active' or journal['profile'] not in PROFILES[1:]:
            raise RuntimeError('run requires an active isolated bench-mode journal')
        self.require_session(journal)
        if journal.get('scope'):
            raise RuntimeError('tracked benchmark scope exists: recover session before run')
        if not command:
            raise RuntimeError('run requires a command after --')
        scope = 'romacs-bench-' + uuid.uuid4().hex + '.scope'
        journal['scope'] = scope
        journal['log'].append({'operation': 'scope-launch', 'target': scope})
        self.save(journal)
        handlers = {}

        def interrupted(signum, frame):
            raise RuntimeError(f'benchmark interrupted by signal {signum}')

        try:
            for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
                handlers[signum] = signal.signal(signum, interrupted)
            return run_command(command, scope, self.runner,
                               cpus='3' if journal['profile'] == 'isolated+sibling-offline' else '2,3')
        finally:
            for signum in handlers:
                signal.signal(signum, signal.SIG_IGN)
            try:
                self.stop_scope(journal)
            finally:
                for signum, handler in handlers.items():
                    signal.signal(signum, handler)

    def off(self, *, end_session=False):
        journal = self.load()
        if not journal:
            return {'phase': 'off'}
        if not end_session:
            self.require_session(journal)
            if journal.get('session'):
                self.stop_scope(journal)
                if not os.environ.get('ROMACS_BENCH_SESSION'):
                    return self.session_end(self.caller_token())
                return {'phase': journal['phase'], 'session': journal['session'], 'retained': True}
        journal['phase'] = 'restoring'
        self.save(journal)
        self.stop_scope(journal)
        failures = []
        for action in reversed(journal['actions']):
            if action['kind'] == 'cpu-online' and action.get('pending'):
                action['restored'] = False
            if not action.get('pending') or action.get('restored'):
                continue
            try:
                self.apply(action, restore=True)
            except (OSError, RuntimeError) as error:
                failures.append(str(error))
                journal['log'].append(str(error))
            else:
                action['restored'] = True
                journal['log'].append({'operation': 'restore', 'target': action['target'],
                                       'value': action['before']})
            self.save(journal)
        if journal['profile'] == 'isolated+sibling-offline':
            if (self.read(SIBLING_ONLINE) != '1'
                    or not {0, 1, 2, 3} <= normalize_cpus(self.read('/sys/devices/system/cpu/online'))):
                failures.append('CPU restore incomplete: CPUs 0,1,2,3 must be online')
        if failures:
            raise RuntimeError('restore incomplete; retained journal: ' + '; '.join(failures))
        with self.state.with_suffix('.history.jsonl').open('a') as history:
            history.write(json.dumps(journal, sort_keys=True) + '\n')
            history.flush()
            os.fsync(history.fileno())
        self.state.unlink()
        self.sync_directory()
        return {'phase': 'off', 'log': journal['log']}


def normalize_cpus(value):
    result = set()
    for part in value.replace(',', ' ').split():
        bounds = part.split('-')
        result.update(range(int(bounds[0]), int(bounds[-1]) + 1))
    return result


AFFINITY_WRAPPER = '''import json
import os
from pathlib import Path
import sys
import tempfile

scope, *command = sys.argv[1:]
cpus = os.sched_getaffinity(0)
if cpus != {2, 3}:
    raise RuntimeError(f'benchmark affinity assertion failed: {sorted(cpus)}')
cgroup = Path('/proc/self/cgroup').read_text()
paths = [line.split(':', 2)[2] for line in cgroup.splitlines() if line.startswith('0::')]
if len(paths) != 1 or paths[0].split('/')[-2:] != ['romacs-bench.slice', scope] or 'system.slice' in paths[0].split('/'):
    raise RuntimeError(f'benchmark cgroup assertion failed: {cgroup!r}; expected {scope}')
receipt = os.environ.get('ROMACS_BENCH_AFFINITY_RECEIPT')
if receipt:
    target = Path(receipt)
    fd, temporary = tempfile.mkstemp(prefix='.affinity-', dir=target.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump({'pid': os.getpid(), 'affinity': sorted(cpus), 'cgroup': cgroup, 'scope': scope}, stream, sort_keys=True)
            stream.write('\\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, target)
        directory = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
os.execvp(command[0], command)
'''


def run_command(command, scope, runner=execute, *, cpus='2,3'):
    if cpus not in ('2,3', '3'):
        raise RuntimeError('invalid benchmark CPUs')
    if not command:
        raise RuntimeError('run requires a command after --')
    uid = int(os.environ.get('SUDO_UID', os.getuid()))
    if uid == 0:
        raise RuntimeError('run must identify an unprivileged caller')
    user = pwd.getpwuid(uid)
    environment = [f'{key}={value}' for key, value in sorted(os.environ.items())
                   if key.startswith(('CORE_BENCH_', 'ROMACS_')) and key != 'ROMACS_BENCH_LOCK_FD']
    args = ['sudo', '-n', 'systemd-run', '--scope', '--slice=romacs-bench.slice',
            '--unit=' + scope, '--property=AllowedCPUs=' + cpus,
            '--property=RuntimeMaxSec=2300', '--quiet', '--',
            'sudo', '-n', '-u', user.pw_name, '--',
            *(['env', *environment] if environment else []), 'taskset', '-c', cpus,
            'python3', '-c', AFFINITY_WRAPPER.replace('if cpus != {2, 3}:',
                                                      'if cpus != ' + repr(normalize_cpus(cpus)) + ':'), scope, *command]
    if runner is not execute:
        return runner(args)
    return subprocess.run(args).returncode


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state', type=Path, default=Path.home() / 'romacs-bench/bench-mode.json')
    parser.add_argument('--host', help='explicit expected host identity; required before mutation')
    sub = parser.add_subparsers(dest='command', required=True)
    on = sub.add_parser('on')
    on.add_argument('--profile', choices=PROFILES, default='quiet')
    on.add_argument('--turbo', choices=('unchanged', 'off'), default='unchanged')
    for name in ('off', 'status', 'fingerprint'):
        command = sub.add_parser(name)
        if name == 'status':
            command.add_argument('--json', action='store_true', help='stable JSON status (also the default)')
    session = sub.add_parser('session')
    session.add_argument('operation', choices=('begin', 'end'))
    session.add_argument('--token', required=True)
    session.add_argument('--profile', choices=PROFILES, default='isolated')
    session.add_argument('--turbo', choices=('unchanged', 'off'), default='unchanged')
    run = sub.add_parser('run')
    run.add_argument('args', nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    mode = BenchMode(args.state)
    try:
        if args.command in ('on', 'off', 'run', 'session'):
            if not args.host:
                raise RuntimeError('--host is required before mutation')
            if mode.hostname != args.host:
                raise RuntimeError(f'refusing mutation on {mode.hostname}; expected {args.host}')
            validate_lock(Path.home() / 'romacs-bench/.lock')
        if args.command == 'session':
            result = (mode.session_begin(args.token, args.profile, args.turbo)
                      if args.operation == 'begin' else mode.session_end(args.token))
        elif args.command == 'on':
            result = mode.on(args.profile, args.turbo)
        elif args.command == 'off':
            result = mode.off()
        elif args.command == 'run':
            return mode.run(args.args[1:] if args.args[:1] == ['--'] else args.args)
        elif args.command == 'fingerprint':
            result = mode.fingerprint()
        else:
            result = {'journal': mode.load(), 'fingerprint': mode.fingerprint()}
        print(json.dumps(result, sort_keys=True))
        return 0
    except (OSError, RuntimeError, ValueError) as error:
        print(f'bench-mode: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())

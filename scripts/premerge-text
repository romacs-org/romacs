#!/usr/bin/env python3
"""Run full-strength text checks inside an already admitted build slot."""
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent


def main():
    flags = ['--offline', '--release', '-p', 'romacs-text']
    for target in (['--lib'], ['--test', 'structural']):
        result = subprocess.run(['cargo', 'rustc', *flags, *target, '--', '--print', 'cfg'],
                                cwd=ROOT, check=True, text=True, capture_output=True)
        cfg = set(result.stdout.splitlines())
        if 'debug_assertions' in cfg or not any(c.startswith('target_arch=') for c in cfg):
            sys.exit('premerge-text: full strength requires verified debug_assertions off')
    print('premerge-text: debug_assertions verified off (library and tests)', flush=True)
    subprocess.run(['cargo', 'nextest', 'run', *flags, '-p', 'romacs-chars',
                    '--no-tests=fail'], cwd=ROOT, check=True)


if __name__ == '__main__':
    main()

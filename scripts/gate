#!/usr/bin/env python3
"""Build and test the surviving VM2 workspace inside one neomacs-slot admission.

    python3 scripts/gate --lane nocore full
    scripts/gate focused 'EXPR'
    scripts/gate --repeat 60 focused 'EXPR'
    scripts/gate changed [BASE]
    scripts/gate build
    scripts/gate reuse RUN_DIR [full|focused|changed [EXPR]]

Full covers surviving workspace test targets with one feature resolution.
All workspace suites, including VM2 oracle tests, remain included.
Linux enables display-runtime/video.
A gate-owned nextest config avoids retired editor filters and setup scripts.
VM2 and support tests run beside a disjoint display suite. No editor binary,
compiled Lisp runtime, bootstrap image or bytecode overlay is provisioned.
Frozen tracked and untracked inputs are mirrored into a persistent slot source
without touching the worktree or index. Tests use private HOME/XDG/TMPDIR and
no inherited display or session bus. Receipts bind verdict, tree, gate, runner,
oracle, effective environments and exact nextest test outcomes. Reuse requires
a complete green receipt, an identical clean tree and identical environment.
Build-only receipts and stress runs cannot substitute for full acceptance.
"""
import argparse, fcntl, hashlib, json, os, pathlib, re, shlex, shutil, subprocess, sys, tempfile, time, tomllib

SLOT = os.environ.get('ROMACS_SLOT', str(pathlib.Path(__file__).resolve().with_name('neomacs-slot')))
RUNNER = os.environ.get('ROMACS_SLOT_RUNNER', str(pathlib.Path(__file__).resolve().with_name('neomacs-slot-runner.py')))


def _pinned_oracle(repo):
    """Resolve the submitted reference; copied gates must pass their extracted root."""
    try:
        text = (pathlib.Path(repo) / 'parity-reference.toml').read_text()
    except OSError as error:
        raise SystemExit(f'gate: cannot read parity-reference.toml in {repo}: {error}; '
                         'restore the submitted reference before gating')
    pin = re.search(r'^mirror_commit\s*=\s*"([0-9a-f]{40})"', text, re.M)
    if not pin:
        raise SystemExit('gate: parity-reference.toml has no valid mirror_commit; '
                         'restore its 40-character GNU revision before gating')
    root = pathlib.Path(os.environ.get('GNU_ORACLE_ROOT', str(pathlib.Path(os.environ.get('XDG_CACHE_HOME', pathlib.Path.home() / '.cache')) / 'gnu-emacs-pin'))).absolute()
    path = root / pin[1] / 'bin' / 'emacs'
    if not (path.is_file() and os.access(path, os.X_OK)):
        raise SystemExit(f'gate: no GNU oracle built at the pin {pin[1][:10]} '
                         f'(looked for {path}); build it with scripts/build-gnu-oracle.sh. '
                         'There is no fallback: a different revision is not the oracle.')
    return str(path)


def _override_oracle(value):
    path = pathlib.Path(value).resolve()
    if not (path.is_file() and os.access(path, os.X_OK)):
        raise SystemExit(f'gate: --oracle must name an executable file (looked for {path})')
    return str(path)


ORACLE = None
LABWC = os.environ.get('ROMACS_TEST_LABWC', shutil.which('labwc') or 'labwc')
GNU_GUI = os.environ.get('ROMACS_GNU_GUI_BINARY', shutil.which('emacs') or 'emacs')
DISPLAY_TOOLS = os.environ.get('ROMACS_DISPLAY_TOOLS', str(pathlib.Path(shutil.which('weston') or '/usr/bin/weston').parent))
GUI_FONTCONFIG = os.environ.get('ROMACS_GATE_FONTCONFIG', '/etc/fonts/fonts.conf')
TOOLCHAIN = os.environ.get('ROMACS_TOOLCHAIN_BIN', str(pathlib.Path(shutil.which('cargo') or '/usr/bin/cargo').parent))
NEXTEST = os.environ.get('ROMACS_NEXTEST_BIN', str(pathlib.Path(shutil.which('cargo-nextest') or '/usr/bin/cargo-nextest').parent))
SCCACHE = os.environ.get('ROMACS_SCCACHE', shutil.which('sccache') or 'sccache')
HOME = pathlib.Path.home()
CACHE = pathlib.Path(os.environ.get('ROMACS_GATE_CACHE', HOME / '.cache/emax-gate'))
SHORT = pathlib.Path(os.environ.get('ROMACS_GATE_SCRATCH', HOME / '.cache/ng'))
DISPLAY_PACKAGES = {
    'romacs-display-runtime', 'romacs-renderer-wgpu',
    'romacs-font', 'romacs-face', 'romacs-gui-oracle', 'romacs-display-protocol',
    'romacs-font-materializer', 'romacs-test-fonts', 'romacs-video',
    'romacs-video-model', 'romacs-layout-input',
    'romacs-layout2', 'romacs-vm-gui',
}
GATE_PROFILE = ['--config', 'profile.gate.inherits="release"', '--config', 'profile.gate.lto="off"',
                '--config', 'profile.gate.codegen-units=256', '--config', 'profile.gate.incremental=true']


def sh(*cmd, **kw):
    return subprocess.run(cmd, check=True, **kw)


def out(*cmd, cwd=None, env=None):
    return subprocess.run(cmd, check=True, cwd=cwd, env=env, stdout=subprocess.PIPE).stdout


def workspace_suites(metadata):
    members = set(metadata['workspace_members'])
    packages = {p['name'] for p in metadata['packages'] if p['id'] in members}
    if len(packages) != len(members) or 'romacs-vm' not in packages:
        raise ValueError('invalid VM2 workspace inventory')
    return {suite: sorted(names) for suite, names in (
        ('vm2', packages - DISPLAY_PACKAGES), ('display', packages & DISPLAY_PACKAGES)) if names}


BUILD_PREFIXES = ('CARGO_', 'RUST', 'ROMACS_', 'ROMACS_', 'EMACS', 'LC_',
                  'PKG_CONFIG', 'SCCACHE_', 'CC_', 'CXX_', 'AR_', 'TARGET_CC', 'TARGET_AR')
BUILD_NAMES = {'LANG', 'TZ', 'CC', 'CXX', 'AR', 'CFLAGS', 'CXXFLAGS', 'LDFLAGS',
               'LD_LIBRARY_PATH', 'LIBRARY_PATH', 'CPATH', 'C_INCLUDE_PATH', 'CPLUS_INCLUDE_PATH'}


def source_env_names(src):
    """Discover compile-time inputs; unreadable/unsupported declarations fail closed.

    Literal env!/option_env! and Cargo declarations are scanned in every Rust
    source. Dynamic build-script tool selectors also name variables through
    format templates: their leading selector comes from literal names in that
    script (e.g. CC/AR), while the target suffix is arbitrary.
    """
    src = pathlib.Path(src)
    if not src.is_dir():
        raise ValueError('environment source unavailable')
    names = set()
    def failed(error):
        raise error
    for directory, dirs, files in os.walk(src, onerror=failed):
        dirs[:] = [d for d in dirs if d not in ('.git', 'target')]
        for name in files:
            if not name.endswith('.rs'):
                continue
            text = (pathlib.Path(directory) / name).read_text()
            for argument in re.findall(r'\b(?:option_)?env!\s*\(\s*([^)]*)', text):
                literal = re.match(r'"([A-Za-z_][A-Za-z0-9_-]*)"', argument)
                if not literal:
                    raise ValueError('unsupported environment macro')
                names.add(literal[1])
            declarations = re.findall(r'cargo::?rerun-if-env-changed=([^"\\\s]+)', text)
            names.update(v for v in declarations if re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', v))
            dynamic = [v for v in declarations if '{' in v]
            if dynamic:
                # Support the native-tool selector's finite names + target
                # templates, not arbitrary executable Rust as a name generator.
                selectors = re.findall(r'for\s+name\s+in\s*\[([^]]+)\]', text)
                if dynamic != ['{name}'] or len(selectors) != 1:
                    raise ValueError('unsupported dynamic Cargo environment declaration')
                selector = selectors[0]
                literals = set(re.findall(r'"([A-Z][A-Z0-9_]*)"', text))
                templates = re.findall(r'format!\s*\(\s*"([^"\n]+)"', selector)
                if not templates or not literals or not re.search(r'\w+\.to_owned\(\)', selector):
                    raise ValueError('unsupported dynamic Cargo environment declaration')
                names.update(literals)
                patterns = []
                for template in templates:
                    if not re.fullmatch(r'(?:[A-Z0-9_]+|\{[a-z_]*\})+', template):
                        raise ValueError('unsupported environment name template')
                    parts = [p for p in re.split(r'(\{[a-z_]*\})', template) if p]
                    patterns.append(''.join('(?:' + '|'.join(sorted(literals)) + ')'
                                            if i == 0 and p.startswith('{')
                                            else r'[A-Za-z0-9_-]+' if p.startswith('{') else re.escape(p)
                                            for i, p in enumerate(parts)))
                names.update(k for k in os.environ if any(re.fullmatch(p, k) for p in patterns))
            if name == 'build.rs':
                names.update(re.findall(r'\b(?:var|var_os)\s*\(\s*"([A-Za-z_][A-Za-z0-9_]*)"', text))
    return names


def env(src=None, names=None):
    # Clear ambient shell-profile state for commands too, not just identity.
    if names is None:
        names = source_env_names(src) if src is not None else set()
    e = {k: v for k, v in os.environ.items()
         if k in BUILD_NAMES or k in names or k.startswith(BUILD_PREFIXES)}
    e['ROMACS_TEST_FONTS_DIR'] = os.environ.get(
        'ROMACS_TEST_FONTS_DIR', str(HOME / '.cache/romacs-test-fonts'))
    e.update(HOME=str(HOME), PATH=gate_path(),
             CARGO_HOME=os.environ.get('CARGO_HOME', str(HOME / '.cargo')),
             TMPDIR=os.environ.get('TMPDIR', str(HOME / '.cache')),
             RUSTUP_TOOLCHAIN='', NEXTEST_EXPERIMENTAL_LIBTEST_JSON='1')
    # Reconstruct the slot's fixed cache/wrapper policy outside admission too.
    # Apply it to actual commands as well as fingerprints: inherited overrides
    # cannot become a second, divergent source of effective execution inputs.
    e.update(RUSTC_WRAPPER=SCCACHE,
             SCCACHE_CLIENT_SIDE='1', SCCACHE_DIR=str(HOME / '.cache/sccache'),
             SCCACHE_CACHE_SIZE='20G', SCCACHE_CONF='/dev/null')
    e.pop('SCCACHE_ERROR_LOG', None)
    e.pop('SCCACHE_LOG', None)
    # The slot exports CARGO_INCREMENTAL=0 for sccache, which overrides the
    # profile. Unset it (sccache refuses =1): workspace crates then build
    # incrementally while sccache keeps caching dependencies.
    e.pop('CARGO_INCREMENTAL', None)
    if 'NEOMACS_SLOT_INDEX' not in names:
        e.pop('NEOMACS_SLOT_INDEX', None)  # scheduler location, not a build input
    for selector in ('ROMACS_SLOT', 'ROMACS_SLOT_RUNNER'):
        if selector not in names:
            e.pop(selector, None)
    for k in list(e):
        if k.startswith('CARGO_PROFILE_'):
            e.pop(k)
    return e


def gate_path():
    return ':'.join([TOOLCHAIN, NEXTEST, DISPLAY_TOOLS, '/usr/bin', '/bin',
                     str(pathlib.Path(SCCACHE).parent)])


def digest(path):
    return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()


def source_metadata_identity(root, captured=None):
    if captured is not None:
        if not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', captured):
            raise ValueError('invalid captured source context')
        if out('git', 'cat-file', '-t', captured, cwd=root).strip() != b'tree':
            raise ValueError('captured source object is not a tree')
        return captured
    revision = out('git', 'rev-parse', '--verify', 'HEAD', cwd=root).decode().strip()
    tree = out('git', 'rev-parse', '--verify', 'HEAD^{tree}', cwd=root).decode().strip()
    return revision + '\n' + tree


def environment_identity(src, inputs=None):
    names = source_env_names(inputs if inputs is not None else src)
    e = env(names=names)
    excluded = {'CARGO_TARGET_DIR', 'CARGO_BUILD_JOBS',
                'NEXTEST_TEST_THREADS', 'RUST_TEST_THREADS'} - names
    root_name = 'ROMACS_VACUITY_GIT_ROOT'
    captured = e.get('ROMACS_VACUITY_GIT_TREE') if not (src / '.git').exists() else None
    if captured is not None and root_name not in e:
        raise ValueError('captured source requires a metadata root')
    root_identity = source_metadata_identity(e[root_name], captured) if root_name in e else None
    hashes = {label: {k: hashlib.sha256(
                         (root_identity if k == root_name else v).encode()).hexdigest()
                      for k, v in effective.items() if k not in excluded}
              for label, effective in (('build', e), ('test', test_env(
                  pathlib.Path('/gate-src'), pathlib.Path('/gate-home'), names=names)))}

    # Cargo searches from the mirror up, then CARGO_HOME. Origins matter:
    # relative config paths resolve against their containing directory.
    homes = [p / '.cargo' for p in src.absolute().parents]
    homes.append(pathlib.Path(e['CARGO_HOME']).absolute())
    configs = [(str(p), p.read_bytes().hex()) for h in homes
               for p in (h / 'config', h / 'config.toml') if p.is_file()]
    tools = {'cargo': str(pathlib.Path(TOOLCHAIN) / 'cargo'),
             'rustc': str(pathlib.Path(TOOLCHAIN) / 'rustc'),
             'cargo-nextest': str(pathlib.Path(NEXTEST) / 'cargo-nextest'),
             'sccache': SCCACHE, 'labwc': LABWC, 'gnu-gui': GNU_GUI,
             'gui-fontconfig': GUI_FONTCONFIG,
             **{name: str(pathlib.Path(DISPLAY_TOOLS) / name)
                for name in ('weston', 'Xvfb', 'xauth', 'xdpyinfo')}}
    for name, command in tools.items():
        if not pathlib.Path(command).is_file():
            raise MissingTool(name)
    tools = {name: f'{path}:{digest(path)}' for name, path in tools.items()}
    fp = hashlib.sha256(json.dumps([hashes, tools, configs, out('rustc', '-vV', env=e).decode()],
                                  sort_keys=True).encode()).hexdigest()
    return fp, hashes, tools


class MissingTool(ValueError):
    """A public tool label, never the submitted command or its private value."""


def tool_variable(name):
    return (name in ('CC', 'CXX', 'AR', 'PKG_CONFIG', 'TARGET_CC', 'TARGET_CXX',
                     'TARGET_AR', 'RUSTC', 'RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER',
                     'CARGO_BUILD_RUSTC', 'CARGO_BUILD_RUSTC_WRAPPER',
                     'CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER')
            or name.startswith(('CC_', 'CXX_', 'AR_'))
            or (name.startswith('CARGO_TARGET_') and name.endswith(('_LINKER', '_RUNNER'))))


def unpinned_executable(src, inputs):
    """Reuse only: configured commands outside the fixed closure need a fresh run."""
    e = env(names=source_env_names(inputs))
    fixed = {str(pathlib.Path(p).resolve()) for p in
             (SCCACHE, ORACLE, '/usr/bin/cc', '/usr/bin/c++', '/usr/bin/ar',
              '/usr/bin/ld', '/usr/bin/pkg-config', '/usr/bin/awk', '/usr/bin/cat',
              '/usr/bin/prlimit', '/bin/sh', '/bin/bash',
              str(pathlib.Path(TOOLCHAIN) / 'cargo'),
              str(pathlib.Path(TOOLCHAIN) / 'rustc'),
              str(pathlib.Path(NEXTEST) / 'cargo-nextest'))}
    immutable_roots = [root for root in (pathlib.Path(TOOLCHAIN).parent, pathlib.Path(NEXTEST).parent)
                       if root.parent == pathlib.Path('/nix/store')]

    def unpinned(value):
        command = value if isinstance(value, list) else shlex.split(value)
        if not command:
            return False
        # A wrapper plus arguments can select another executable or script.
        if len(command) != 1 or ('/' in command[0] and not pathlib.Path(command[0]).is_absolute()):
            return True
        path = shutil.which(command[0], path=gate_path())
        if path is None:
            return True
        path = pathlib.Path(path).resolve()
        return not (str(path) in fixed or any(path.is_relative_to(root) for root in immutable_roots))

    def selector(name, value):
        if tool_variable(name):
            return unpinned(value)
        if name in ('RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS') or name.endswith('_RUSTFLAGS'):
            # Any rustflags can select executables (linker, link-arg, -Z
            # forms, long --codegen spellings); never parse them, refuse.
            return bool(value if isinstance(value, list) else value.strip('\x1f \t\n'))
        return False

    for name, value in sorted(e.items()):
        if selector(name, value):
            return name
    homes = [p / '.cargo' for p in src.absolute().parents]
    homes += [pathlib.Path(e['CARGO_HOME']).absolute(), pathlib.Path(inputs) / '.cargo']
    for home in homes:
        for config in (home / 'config', home / 'config.toml'):
            if not config.is_file():
                continue
            data = tomllib.loads(config.read_text())
            for name, value in data.get('env', {}).items():
                if name == 'PATH':
                    return '[env] PATH'
                if isinstance(value, dict):
                    relative = value.get('relative', False)
                    value = value['value']
                    if relative and tool_variable(name):
                        value = str(config.parent.parent / value)
                # Conservatively reject unpinned config routes even when an
                # ambient value may override them; no Cargo precedence replica.
                if selector(name, value):
                    return f'[env] {name}'
            for section, values in [('build', data.get('build', {})),
                                    *[(f'target.{k}', v) for k, v in data.get('target', {}).items()]]:
                for name in ('linker', 'runner', 'rustc', 'rustc-wrapper', 'rustc-workspace-wrapper'):
                    if values.get(name) and unpinned(values[name]):
                        return f'[{section}] {name}'
                if selector('RUSTFLAGS', values.get('rustflags', [])):
                    return f'[{section}] rustflags'
    return None


def env_fingerprint(src):
    return environment_identity(src)[0]


def environment_difference(receipt, current):
    _, hashes, tools = current
    differences = []
    for phase in ('build', 'test'):
        before, after = receipt['env_hashes'][phase], hashes[phase]
        for label, keys in (('changed', before.keys() & after.keys()),
                            ('missing', before.keys() - after.keys()),
                            ('extra', after.keys() - before.keys())):
            keys = sorted(k for k in keys if label != 'changed' or before[k] != after[k])
            if keys:
                differences.append(f'{phase} {label}: ' + ', '.join(keys))
    before = receipt['tool_hashes']
    changed = sorted(k for k in before.keys() | tools.keys() if before.get(k) != tools.get(k))
    if changed:
        differences.append('tools changed: ' + ', '.join(changed))
    return '; '.join(differences) or 'toolchain/Cargo configuration'


def freeze(wt, staged=False):
    CACHE.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=CACHE) as tmp:
        e = dict(os.environ, GIT_INDEX_FILE=f'{tmp}/index')
        index = out('git', 'rev-parse', '--git-path', 'index', cwd=wt).decode().strip()
        shutil.copyfile(wt / index, e['GIT_INDEX_FILE'])
        if not staged:
            sh('git', 'add', '-A', cwd=wt, env=e)
        return subprocess.check_output(['git', 'write-tree'], cwd=wt, env=e).decode().strip()


def mirror(group):
    index = os.environ.get('NEOMACS_SLOT_INDEX')
    if index is None:
        return CACHE / 'lanes' / group / 'src'
    if not re.fullmatch(r'0|[1-9][0-9]*', index):
        raise ValueError('invalid slot index')
    return HOME / '.cache/neomacs-slots' / index / 'src'


def cargo_flags(src):
    has_profile = '[profile.gate]' in (src / 'Cargo.toml').read_text()
    return ['--locked', '--offline'] + ([] if has_profile else GATE_PROFILE)


def run_env(root, home):
    """Test environment: private HOME/XDG/TMPDIR, no display or session bus."""
    for d in ('home/.config', 'home/.local/share', 'home/.local/state', 'home/.cache', 'run', 'tmp'):
        (home / d).mkdir(parents=True, exist_ok=True)
    (home / 'run').chmod(0o700)
    return test_env(root, home)


def test_env(root, home, names=None):
    """Pure test normalization, also used with stable paths for receipt identity."""
    e = env(root, names=names)
    # No desktop session, and none of a running editor's own launch
    # variables (a gate started from inside Romacs is a plain shell's).
    for k in ('DISPLAY', 'WAYLAND_DISPLAY', 'DBUS_SESSION_BUS_ADDRESS',
              'ROMACS_RUNTIME_ROOT', 'ROMACS_LISP_DIR', 'ROMACS_USAGE_LOG',
              'ROMACS_GUI_FONT', 'ROMACS_GUI_FONT_SIZE'):
        e.pop(k, None)
    e.update(HOME=f'{home}/home', XDG_CONFIG_HOME=f'{home}/home/.config',
             XDG_DATA_HOME=f'{home}/home/.local/share', XDG_STATE_HOME=f'{home}/home/.local/state',
             XDG_CACHE_HOME=f'{home}/home/.cache', XDG_RUNTIME_DIR=f'{home}/run', TMPDIR=f'{home}/tmp',
             CARGO_HOME=str(HOME / '.cargo'), CARGO_NET_OFFLINE='true', CARGO_WORKSPACE_DIR=str(root),
             RUST_MIN_STACK='134217728', ROMACS_FORCE_ORACLE_PATH=ORACLE,
             ROMACS_TEST_LABWC=LABWC, ROMACS_GNU_GUI_BINARY=GNU_GUI,
             FONTCONFIG_FILE=GUI_FONTCONFIG,
             ROMACS_GNU_GUI_FONTCONFIG=GUI_FONTCONFIG)
    return e


def canonical_test_name(name):
    return re.sub(r'@stress-[0-9]+(?=\$)', '', name, count=1)


def stress_complete(events, repeat):
    """Require a terminal suite record for every requested native stress iteration."""
    if repeat == 1 or not any(e.get('type') == 'test' for e in events):
        return True
    iterations = {}
    for event in events:
        meta = event.get('nextest', {})
        if (event.get('type') == 'suite' and event.get('event') in ('started', 'ok', 'failed')
                and meta.get('stress_total') == repeat):
            key = (meta.get('crate'), meta.get('test_binary'), meta.get('kind'))
            indices = iterations.setdefault(key, set())
            if event.get('event') != 'started':
                indices.add(meta.get('stress_index'))
    return bool(iterations) and all(indices == set(range(repeat)) for indices in iterations.values())


def test_completion_errors(events, ignored, selected, repeat):
    starts, terminals, results = {}, {}, {}
    for event in events:
        if event.get('type') != 'test':
            continue
        name = event['name']
        canonical = canonical_test_name(name)
        kind = event.get('event')
        if kind == 'started':
            starts[name] = starts.get(name, 0) + 1
        elif kind in ('ok', 'failed', 'timeout', 'ignored'):
            terminals[name] = terminals.get(name, 0) + 1
            if kind != 'ignored':
                results.setdefault(canonical, []).append(name)
    errors = [f'{name}: started without a terminal result'
              for name, count in sorted(starts.items())
              if count > terminals.get(name, 0) and canonical_test_name(name) not in ignored]
    for name in sorted(results.keys() - selected - ignored):
        errors.append(f'{name}: result absent from selected inventory')
    for name in sorted(selected - ignored):
        names = results.get(name, [])
        if len(names) != repeat or len(set(names)) != repeat:
            errors.append(f'{name}: expected {repeat} results, received {len(names)} '
                          f'({len(set(names))} distinct iterations)')
    if repeat > 1:
        for name in sorted(({canonical_test_name(n) for n in starts} - selected) - ignored):
            names = results.get(name, [])
            if len(names) != repeat or len(set(names)) != repeat:
                errors.append(f'{name}: expected {repeat} results, received {len(names)} '
                              f'({len(set(names))} distinct iterations)')
    return errors


NOTICES = 'notices.txt'
EVIDENCE = 'evidence.txt'


def print_notices(run_dir):
    """Print what passing tests asked to be seen, on GREEN as well as RED."""
    try:
        lines = (run_dir / NOTICES).read_text(errors='replace').splitlines()
    except FileNotFoundError:
        return
    for line in lines:
        if line.strip():
            print(f'gate: NOTICE {line}', flush=True)


def build_and_run(src, run_dir, expr, threads, run, t0, suites, repeat=1):
    """Build every workspace test target once, then run disjoint suites."""
    SHORT.mkdir(parents=True, exist_ok=True)
    scratch = pathlib.Path(tempfile.mkdtemp(dir=SHORT))  # short: Unix socket names are <= 108 bytes
    procs, inventories = {}, {}
    failure_path = run_dir / 'failure-reason.txt'
    failure_path.unlink(missing_ok=True)
    (run_dir / NOTICES).unlink(missing_ok=True)
    (run_dir / EVIDENCE).unlink(missing_ok=True)
    def incomplete(reason):
        failure_path.write_text(reason + '\n')
        print(f'gate: {reason}', flush=True)
        return None
    try:
        # One explicit config for build, inventory and execution, apart from
        # the workspace's; slot admission supplies the memory limit, and this
        # bounds test hangs.
        config = run_dir / 'nextest.toml'
        # The warm census loads GNU's loadup chain through abbrev.el into a
        # fresh VM per file: about 275s per pass alone in the gate, and over
        # 600s beside the display suite, so it gets a longer bound. The batch
        # scaling probes bound each session by its CPU (scaling_live.py), which
        # load does not stretch: their test ends on those bounds.
        config.write_text('[profile.default]\n'
                          'slow-timeout = { period = "600s", terminate-after = 1, grace-period = "0s" }\n'
                          '[[profile.default.overrides]]\n'
                          "filter = 'test(=parity_ratchet_census_warm)'\n"
                          'slow-timeout = { period = "1200s", terminate-after = 1, grace-period = "0s" }\n'
                          '[[profile.default.overrides]]\n'
                          "filter = 'test(=batch_probes_scale_within_their_budgets)'\n"
                          'slow-timeout = { period = "3600s", terminate-after = 1, grace-period = "0s" }\n')
        nextest = ['cargo', 'nextest']
        config_flags = ['--config-file', str(config), '--user-config-file', 'none']
        flags = cargo_flags(src)
        with open(run_dir / 'cargo-metadata.json', 'w') as f:
            sh('cargo', 'metadata', '--format-version', '1', *flags, stdout=f, env=env(src), cwd=src)
        suites.update(workspace_suites(json.loads((run_dir / 'cargo-metadata.json').read_text())))
        pkgs = [a for packages in suites.values() for p in packages for a in ('-p', p)]
        features = (['--features', 'romacs-display-runtime/video']
                    if sys.platform == 'linux' and 'romacs-display-runtime' in suites.get('display', [])
                    else [])
        subject_tool = src / 'gnu-tests/tools/gate_vacuity.py'
        subject_source = out(sys.executable, '-B', str(subject_tool), 'source', cwd=src, env=env(src))
        build_command = [*nextest, 'list', *config_flags, '--cargo-profile', 'gate', *flags, *pkgs, *features,
                         '--list-type', 'binaries-only', '--message-format', 'json']
        with open(run_dir / 'all-binaries.json', 'w') as f:
            rc = subprocess.call(build_command, stdout=f, env=env(src), cwd=src)
        if rc:
            return incomplete(f'combined build failed (exit {rc})')
        if run:
            sh(sys.executable, '-B', str(subject_tool), 'prepare', '--run-dir', str(run_dir),
               '--source', subject_source, '--command', json.dumps(build_command), cwd=src, env=env(src))
        built = json.loads((run_dir / 'all-binaries.json').read_text())
        for suite, packages in suites.items():
            binaries = run_dir / f'{suite}-binaries.json'
            # Nextest IDs are PACKAGE for a lib and PACKAGE::TARGET otherwise.
            selected = {k: b for k, b in built['rust-binaries'].items()
                        if b['binary-id'].split('::', 1)[0] in packages}
            if {b['binary-id'].split('::', 1)[0] for b in selected.values()} != set(packages):
                raise ValueError(f'gate: missing binaries for {suite}')
            binaries.write_text(json.dumps(dict(built, **{'rust-binaries': selected})))
            print(f'gate: built {suite} ({time.monotonic() - t0:.0f}s)', flush=True)
            if run:                                 # runs from the listed binaries: no cargo, no build lock
                inventory_path = run_dir / f'{suite}-tests.json'
                test_environment = run_env(src, scratch / suite)
                # Tests that pass but must still reach a human (the parity
                # ratchet's UNCONFIRMED forgiveness) append lines here.
                test_environment['ROMACS_GATE_NOTICES'] = str(run_dir / NOTICES)
                # ...and tests whose PASS must stay auditable keep their
                # verdicts here (nextest drops a passing test's output).
                test_environment['ROMACS_GATE_EVIDENCE'] = str(run_dir / EVIDENCE)
                test_environment['ROMACS_VACUITY_RECEIPT'] = str(run_dir / 'VACUITY-VERDICT.json')
                test_environment['ROMACS_MEMBER_EVIDENCE'] = str(run_dir / 'MEMBER-EVIDENCE.json')
                with open(inventory_path, 'w') as inventory:
                    sh_args = [*nextest, 'list', *config_flags, '--cargo-metadata', str(run_dir / 'cargo-metadata.json'),
                               '--binaries-metadata', str(binaries), '-E', expr, '--message-format', 'json']
                    rc = subprocess.call(sh_args, stdout=inventory, env=test_environment, cwd=src)
                    if rc:
                        return incomplete(f'{suite} test inventory failed (exit {rc})')
                inventories[suite] = json.loads(inventory_path.read_text())['rust-suites']
                cmd = [*nextest, 'run', *config_flags, '--cargo-metadata', str(run_dir / 'cargo-metadata.json'),
                       '--binaries-metadata', str(binaries), '-E', expr, '--no-fail-fast', '--no-tests=pass',
                       '--test-threads', str(threads[suite]), '--message-format', 'libtest-json-plus',
                       '--status-level', 'fail', '--final-status-level', 'fail']
                if repeat > 1:
                    cmd += ['--stress-count', str(repeat), '--retries', '0']
                with open(run_dir / f'{suite}.jsonl', 'w') as o, open(run_dir / f'{suite}.log', 'w') as e:
                    procs[suite] = subprocess.Popen(cmd, env=test_environment, cwd=src, stdout=o, stderr=e)
        failed, broken = [], False
        for suite, p in procs.items():
            rc = p.wait()
            summary = [l.strip() for l in (run_dir / f'{suite}.log').read_text(errors='replace').splitlines()
                       if l.strip().startswith('Summary [')]
            print(f'gate: {suite} exit={rc} {summary[-1] if summary else "(no summary)"} '
                  f'({time.monotonic() - t0:.0f}s)', flush=True)
            ids, events = [], []
            for line in (run_dir / f'{suite}.jsonl').read_text(errors='replace').splitlines():
                if line.startswith('{'):
                    x = json.loads(line)
                    events.append(x)
                    if x.get('type') == 'test' and x.get('event') in ('failed', 'timeout'):
                        ids.append(canonical_test_name(x['name']))
            failed += ids
            ignored, selected_tests = set(), set()
            for binary in inventories[suite].values():
                for name, test in binary['testcases'].items():
                    identity = f"{binary['package-name']}::{binary['binary-name']}${name}"
                    if test['ignored']:
                        ignored.add(identity)
                    elif test['filter-match']['status'] == 'matches':
                        selected_tests.add(identity)
            errors = test_completion_errors(events, ignored, selected_tests, repeat)
            for error in errors:
                print(f'gate: incomplete {suite}: {error}', flush=True)
            broken |= bool(errors)
            log = (run_dir / f'{suite}.log').read_text(errors='replace')
            # Complete: a summary, exit 0 or 100 (tests failed) with the failures
            # recorded, and no tests left unrun by a signal or a crash.
            broken |= (not summary or rc not in (0, 100) or (rc == 100 and not ids)
                       or not stress_complete(events, repeat)
                       or re.search(r'^\s*Cancelling due to|^warning: .*not run', log, re.M) is not None)
        if broken:
            return incomplete('test execution incomplete (see suite logs)')
        (run_dir / 'failures.txt').write_text(''.join(f'{i}\n' for i in sorted(failed)))
        return failed
    finally:                                    # however the run ends, nothing outlives it
        for p in procs.values():
            p.terminate()                       # a no-op once the suite has been waited for
            p.wait()
        remove_scratch(scratch)


def remove_scratch(root):
    """Delete a run's scratch, including directories a test left without
    permissions (GNU's ispell tests leave one mode 000), which rmtree skips."""
    for parent, dirs, _ in os.walk(root):     # top-down: unlock a child before entering it
        for name in dirs:
            path = os.path.join(parent, name)
            if not os.path.islink(path):
                try:
                    os.chmod(path, 0o700)
                except OSError:
                    pass
    shutil.rmtree(root, ignore_errors=True)


def sync(root, dest):
    """Replace a warm mirror with exactly the frozen source, retaining content mtimes."""
    dest.mkdir(parents=True, exist_ok=True)
    sh('rsync', '-rlp', '--checksum', '--chmod=u+w', '--delete', '--force',
       f'{root}/', f'{dest}/')
    if mirror_files(dest) != mirror_files(root):
        raise ValueError('mirror file list differs from frozen submission')


def mirror_files(root):
    """List paths and types without following directory symlinks."""
    return {(str(p.relative_to(root)), 'link' if p.is_symlink() else 'dir' if p.is_dir() else 'file')
            for p in root.rglob('*')}


# The rules a change can break anywhere, which no module's name would select:
# what may run Lisp, what may hold a value across it, what each primitive
# declares, which derived files match.  Together a few minutes at worst, of which
# compile_boundaries, the compile-fail fixtures of the rooting rules, is most.
STRUCTURAL = ('romacs-vm::reentry_sites', 'romacs-vm::compile_boundaries', 'romacs-vm::rooting_brand_rules', 'romacs-vm::heap_boundary',
              'romacs-vm::oclosure_boundary', 'romacs-vm::gc_threads_forbidden', 'romacs-vm::primitive_registry',
              'romacs-vm::production_registry', 'romacs-vm::host_boundary_lint', 'romacs-vm::primitive_gc_boundary',
              'romacs-introspect::boundary', 'romacs-introspect::derived_artifacts', 'romacs-introspect::derive',
              'romacs-gui-tests::harness_contract')


def changed_filter(wt, base='master'):
    """Nextest filter for the small gate: tests named after the Rust modules
    changed since BASE, and the structural rules whatever changed.

    None (run everything) when a change cannot be mapped to test names.
    """
    base = out('git', 'merge-base', 'HEAD', base, cwd=wt).decode().strip()
    names = set(out('git', 'diff', '--name-only', base, cwd=wt).decode().split())
    names |= set(out('git', 'ls-files', '-mo', '--exclude-standard', cwd=wt).decode().split())
    terms = set()
    for name in names:
        if name.startswith(('doc/', 'scripts/tests/')) or name.endswith('.md') or name in ('scripts/gate', 'Makefile'):
            continue
        m = re.match(r'crates/([^/]+)/tests/([^/]+)\.rs$', name)
        if m:                                   # a test binary, or a module of compat_all
            terms.add(f'binary_id({m[1]}::{m[2]}) | test(/^{m[2]}::/)')
            continue
        m = re.match(r'crates/[^/]+/src/(.+)\.rs$', name)
        if not m:
            return None
        parts = [p for p in m[1].split('/') if p not in ('mod', 'lib', 'main', 'tests')]
        if not parts:
            return None                           # crate root changed
        leaf = re.sub(r'_test$', '', parts[-1])
        terms.add(f'test(/(^|::){re.escape(leaf)}(_test)?(::|$)/)')
    return ' | '.join(sorted(terms) + [f'binary_id({binary})' for binary in STRUCTURAL])


def reuse(wt, args, group):
    reason = None
    try:
        receipt = json.loads((pathlib.Path(args.rest[0]) / 'receipt.json').read_text())
        mode = args.rest[1] if len(args.rest) > 1 else 'full'
        expr = args.rest[2] if len(args.rest) > 2 else 'all()'
        if len(args.rest) > 3 or mode not in ('full', 'focused', 'changed'):
            raise ValueError('unsupported coverage')
        tree = freeze(wt, staged=True) if args.staged else out('git', 'rev-parse', 'HEAD^{tree}', cwd=wt).decode().strip()
        if not args.staged and out('git', 'status', '--porcelain', cwd=wt):
            reason = 'dirty worktree'
        elif not (receipt['schema'] == 2 and receipt['verdict'] == 'GREEN' and receipt['complete']):
            reason = 'receipt status/schema'
        elif receipt['repeat'] != 1:
            reason = 'stress receipt is diagnostic only'
        elif receipt['tree'] != tree:
            reason = 'tree'
        elif receipt['gate_sha'] != digest(wt / 'scripts/gate'):
            reason = 'gate implementation'
        elif receipt['runner_sha'] != digest(RUNNER):
            reason = 'slot runner'
        elif receipt.get('oracle_source') != ('override' if args.oracle else 'pin'):
            reason = 'oracle selection source'
        elif receipt['oracle_sha'] != digest(ORACLE):
            reason = 'oracle'
        elif (label := unpinned_executable(mirror(group), wt)):
            reason = 'unpinned executable: ' + label
        else:
            # Match inner's candidate-worktree git root before fingerprinting:
            # recording and reuse must bind the same effective environment,
            # even when the caller has no root (or supplies a different one).
            os.environ['ROMACS_VACUITY_GIT_ROOT'] = str(wt)
            os.environ['ROMACS_VACUITY_GIT_TREE'] = tree
            if receipt['env_fp'] != (current := environment_identity(mirror(group), wt))[0]:
                reason = 'environment: ' + environment_difference(receipt, current)
            elif not (receipt['mode'] == 'full' or
                      (receipt['mode'] == mode and receipt['expr'] == expr)):
                reason = 'coverage'
            elif not set(args.require) <= set(receipt['passed']):
                reason = 'required tests'
    except MissingTool as error:
        reason = f'required tool unavailable: {error}'
    except (OSError, ValueError, KeyError, IndexError, TypeError, subprocess.CalledProcessError):
        reason = 'receipt/input unavailable or malformed'
    print('gate: reuse GREEN' if reason is None else f'gate: reuse refused ({reason})')
    return 0 if reason is None else 1


def provision_fixtures(src):
    """Fill the pinned test-fixture cache before any test runs: tests read
    it and never download (crates/romacs-test-fonts/fixtures.json)."""
    script = src / 'scripts/fetch-test-fixtures'
    if not script.is_file():
        return
    fixtures_env = dict(os.environ, ROMACS_TEST_FONTS_DIR=os.environ.get(
        'ROMACS_TEST_FONTS_DIR', str(HOME / '.cache/romacs-test-fonts')))
    if subprocess.call([sys.executable, '-I', str(script)], env=fixtures_env) != 0:
        raise MissingTool('pinned test fixtures (scripts/fetch-test-fixtures failed)')


def inner(args):
    global ORACLE
    wt, run_dir = pathlib.Path(args.worktree), pathlib.Path(args.run_dir)
    # The measured tree is an extracted archive with NO .git, but in-gate receipt
    # checks (gnu-tests/tools/vacuity_binding.py, reached from the parity_ratchet
    # tests) verify revision identity with git plumbing. Offer them the candidate
    # worktree as a git root instead of writing a .git into the measured tree:
    # lisp_oracle.rs:130 deliberately refuses a repository with extras there, and
    # git would otherwise report the worktree's index rather than the archive.
    # ROMACS_* is already carried into the test environment and the environment
    # fingerprint by env(), so this is visible to the receipt, not hidden from it.
    os.environ['ROMACS_VACUITY_GIT_ROOT'] = str(wt)
    os.environ['ROMACS_VACUITY_GIT_TREE'] = args.tree
    run_dir.mkdir(parents=True, exist_ok=True)
    t0 = time.monotonic()
    src = mirror(args.group)
    fingerprint, env_hashes, tool_hashes = None, {}, {}
    failed, reason, suites = None, None, {}
    build_only = args.mode == 'build'
    try:
        with tempfile.TemporaryDirectory(dir=run_dir) as tree:
            root = pathlib.Path(tree)
            sh('tar', '-x', '-C', tree, input=out('git', 'archive', args.tree, cwd=wt))
            ORACLE = _override_oracle(args.oracle) if args.oracle else _pinned_oracle(root)
            fingerprint, env_hashes, tool_hashes = environment_identity(src, root)
            sync(root, src)
        if not build_only:
            provision_fixtures(src)
        threads = {'vm2': args.threads, 'display': args.display_threads}
        failed = build_and_run(src, run_dir, args.expr, threads, not build_only, t0, suites, args.repeat)
        if failed is None:
            failure_path = run_dir / 'failure-reason.txt'
            reason = (failure_path.read_text().strip() if failure_path.exists() else None)
            reason = reason or 'build/test execution incomplete'
    except MissingTool as error:
        reason = f'required tool unavailable: {error}'
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        reason = 'build/test input unavailable or invalid'
    selected, passed, outcomes = {}, set(), {}
    try:
        for suite in suites:
            path = run_dir / f'{suite}.jsonl'
            events = [json.loads(line) for line in path.read_text().splitlines()
                      if line.startswith('{')] if path.exists() else []
            outcomes[suite] = {event: sum(x.get('type') == 'test' and x.get('event') == event
                                         for x in events)
                               for event in ('started', 'ok', 'failed', 'timeout', 'ignored')}
            selected[suite] = sum(outcomes[suite][event] for event in ('ok', 'failed', 'timeout'))
            passed.update(canonical_test_name(x['name']) for x in events
                          if x.get('type') == 'test' and x.get('event') == 'ok')
            if args.repeat > 1:
                print(f'gate: {suite} repeat={args.repeat} outcomes={outcomes[suite]}', flush=True)
    except (OSError, ValueError, KeyError, TypeError):
        failed, reason = None, 'invalid test events'
    complete = failed is not None
    nonempty = (bool(selected) and all(selected.values()) if args.mode == 'full'
                else sum(selected.values()) > 0)
    if complete and not nonempty and not build_only:
        reason = 'no tests matched the filter'
    if complete and not set(args.require) <= passed:
        reason = 'required tests did not pass'
    green = complete and not failed and not reason and (build_only or nonempty)
    receipt = dict(schema=2, verdict='GREEN' if green else 'RED', complete=complete,
                   tree=args.tree, gate_sha=digest(__file__), runner_sha=digest(RUNNER),
                   oracle_sha=digest(ORACLE), oracle_source='override' if args.oracle else 'pin',
                   env_fp=fingerprint, env_hashes=env_hashes,
                   tool_hashes=tool_hashes, suites=suites,
                   tier=2 if args.mode == 'full' else 1, reason=reason, mode=args.mode,
                   expr=args.expr, repeat=args.repeat, outcomes=outcomes,
                   selected=selected, passed=sorted(passed))
    data = json.dumps(receipt, sort_keys=True) + '\n'
    (run_dir / 'receipt.tmp').write_text(data)
    os.replace(run_dir / 'receipt.tmp', run_dir / 'receipt.json')
    with open(CACHE / 'receipts.jsonl', 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(data)
    print(f'gate: {"GREEN" if green else "RED"}: {args.mode} '
          f'({time.monotonic() - t0:.0f}s); logs in {run_dir}', flush=True)
    if reason:
        print(f'gate: {reason}', flush=True)
    print_notices(run_dir)
    for name in failed or ():
        print(f'gate: FAIL {name}', flush=True)
    return 0 if green else 1


def gate_main():
    global ORACLE
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--lane')
    ap.add_argument('--group')
    ap.add_argument('--jobs', type=int)
    ap.add_argument('--staged', action='store_true', help='verify the index snapshot; preserve unstaged and untracked work')
    ap.add_argument('--repeat', type=int, default=1)
    ap.add_argument('--threads', type=int, default=1, help='VM/support workers (default: 1; GNU tests have inner workers)')
    ap.add_argument('--display-threads', type=int, default=1, help='display workers (default: 1)')
    ap.add_argument('--mem', default='34G', help='heavy-job memory cap (default: 34G)')
    ap.add_argument('--oracle', metavar='PATH')
    ap.add_argument('--require', action='append', default=[], metavar='TEST')
    for hidden in ('--worktree', '--run-dir', '--tree'):
        ap.add_argument(hidden, help=argparse.SUPPRESS)
    ap.add_argument('--inner', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('--expr', default='all()', help=argparse.SUPPRESS)
    ap.add_argument('mode', choices=['full', 'focused', 'changed', 'build', 'reuse'])
    ap.add_argument('rest', nargs='*')
    args = ap.parse_intermixed_args()
    if args.repeat < 1 or (args.repeat != 1 and args.mode != 'focused'):
        ap.error('--repeat requires a positive count and focused mode')
    if args.threads < 1 or args.display_threads < 1 or (args.jobs is not None and args.jobs < 1):
        ap.error('jobs and test threads must be positive')
    ORACLE = _override_oracle(args.oracle) if args.oracle else None
    if args.inner:
        return inner(args)
    if args.mode == 'focused' and len(args.rest) != 1:
        ap.error('focused requires one nextest expression')
    if args.mode == 'changed' and len(args.rest) > 1:
        ap.error('changed takes at most one base revision')
    if args.mode not in ('focused', 'reuse', 'changed') and args.rest:
        ap.error('unexpected mode arguments')
    wt = pathlib.Path(out('git', 'rev-parse', '--show-toplevel').decode().strip())
    lane = args.lane or re.sub(r'[^A-Za-z0-9_.-]', '-', out(
        'git', 'branch', '--show-current', cwd=wt).decode().strip() or 'detached')
    group = args.group or lane
    if args.mode == 'reuse':
        ORACLE = _override_oracle(args.oracle) if args.oracle else _pinned_oracle(wt)
        return reuse(wt, args, group)
    tree = freeze(wt, staged=args.staged)
    expr = args.rest[0] if args.mode == 'focused' else changed_filter(wt, *args.rest[:1]) or 'all()' if args.mode == 'changed' else 'all()'
    (CACHE / 'runs').mkdir(parents=True, exist_ok=True)
    run_dir = pathlib.Path(tempfile.mkdtemp(prefix=f'{lane}-{time.strftime("%Y%m%d-%H%M%S")}-', dir=CACHE / 'runs'))
    (run_dir / 'gate').write_bytes(out('git', 'show', f'{tree}:scripts/gate', cwd=wt))
    for source, name in ((SLOT, 'neomacs-slot'), (RUNNER, 'neomacs-slot-runner.py')):
        target = run_dir / name
        target.write_bytes(pathlib.Path(source).read_bytes())
        target.chmod(0o755)
    admission_env = dict(os.environ, ROMACS_SLOT=str(run_dir / 'neomacs-slot'),
                         ROMACS_SLOT_RUNNER=str(run_dir / 'neomacs-slot-runner.py'))
    jobs = ['--jobs', str(args.jobs)] if args.jobs is not None else []
    required = [x for name in args.require for x in ('--require', name)]
    oracle = ['--oracle', ORACLE] if args.oracle else []
    return subprocess.call([str(run_dir / 'neomacs-slot'), lane, '--group', group, *jobs, '--test-threads',
                            str(args.threads + args.display_threads), '--mem', args.mem, '--',
                            sys.executable, str(run_dir / 'gate'), '--inner', '--worktree', str(wt),
                            '--run-dir', str(run_dir), '--tree', tree, '--group', group,
                            '--expr', expr, '--threads', str(args.threads),
                            '--display-threads', str(args.display_threads), '--repeat', str(args.repeat),
                            *required, *oracle, args.mode], env=admission_env)


def main():
    try:
        return gate_main()
    except MissingTool as error:
        print(f'gate: RED (required tool unavailable: {error})', flush=True)
        return 1
    except (OSError, ValueError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        print('gate: RED (build/test input unavailable or invalid)', flush=True)
        return 1


def entry_main():
    """Normalize only the outer launcher, before freezing/building anything."""
    try:
        if not any(arg in ('--inner', '-h', '--help') for arg in sys.argv[1:]):
            if not pathlib.Path(RUNNER).is_file() or not shutil.which(SLOT):
                raise SystemExit('gate: missing slot tools; restore scripts/neomacs-slot and scripts/neomacs-slot-runner.py')
            from gate_limits import run
            result = run([sys.executable, *sys.orig_argv[1:]])
            if result is not None:
                return result
        return main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'gate: RED (resource normalization failed: {error})', flush=True)
        return 1


if __name__ == '__main__':
    sys.exit(entry_main())

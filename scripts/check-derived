#!/usr/bin/env python3
"""Reject corrupt or stale derived artifacts before the expensive gate.

Corruption is rejected without healing. Freshness checks run checked generators
and leave valid regenerated output for review. Explicit recovery is available
through scripts/derived regenerate.
"""
import pathlib
import subprocess
import sys

def main():
    root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else '.').resolve()
    if not (root / '.git').exists():
        sys.exit(f'check-derived: {root} is not a worktree')
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / 'tools'))
    import derived_artifacts
    try:
        derived_artifacts.check(root)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'check-derived: {exc}', file=sys.stderr)
        return 1
    tests = subprocess.run([sys.executable, '-B', 'tools/python_tests.py', '--root', str(root)], cwd=root)
    oracle = subprocess.run([sys.executable, 'tools/lisp_oracle.py', 'check', '--root', str(root)], cwd=root)
    ratchet = subprocess.run([sys.executable, 'tools/parity_ratchet.py', 'verify', '--candidate', '--root', str(root)], cwd=root)
    arity = subprocess.run([sys.executable, 'tools/gnu_arity.py', 'check', '--root', str(root)], cwd=root)
    defvars = subprocess.run([sys.executable, '-B', 'tools/gnu_defvars.py', 'check', '--root', str(root)], cwd=root)
    icons = subprocess.run([sys.executable, '-B', 'tools/icon_font.py', 'check', '--root', str(root)], cwd=root)
    fonts = subprocess.run([sys.executable, '-B', 'tools/bundled_fonts.py', 'check', '--root', str(root)], cwd=root)
    grammars = subprocess.run([sys.executable, '-B', 'tools/treesit_grammars.py', 'check', '--root', str(root)], cwd=root)
    unsafe = subprocess.run([sys.executable, '-B', 'tools/unsafe_census.py', 'check', '--root', str(root)], cwd=root)
    smells = subprocess.run([sys.executable, '-B', 'tools/smells.py', 'check', '--root', str(root)], cwd=root)
    if tests.returncode or oracle.returncode or ratchet.returncode or arity.returncode or defvars.returncode or icons.returncode or fonts.returncode or grammars.returncode or unsafe.returncode or smells.returncode:
        return 1
    print(f'check-derived: ok, {len(derived_artifacts.ARTIFACTS)} derived artifacts match their sources; '
          'the Python unit tests pass; lisp/ is the GNU pin; parity floors, GNU DEFUN arities and DEFVARs, the icon font, the bundled fonts, the bundled grammars\' sources, the unsafe floors and the smell floors verified')
    return 0


if __name__ == '__main__':
    sys.exit(main())

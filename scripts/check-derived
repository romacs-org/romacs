#!/usr/bin/env python3
"""Reject corrupt or stale derived JSON before the expensive gate.

Corruption is rejected without healing. Freshness checks run checked generators
and leave valid regenerated output for review. Explicit recovery is available
through scripts/derived regenerate.
"""
import pathlib
import subprocess
import sys

DERIVED = [
    dict(artifact='DIVERGENCES.json'),
    dict(artifact='PRIMITIVES.json'),
    dict(artifact='crates/romacs-introspect-live/data/registry.json'),
    dict(artifact='crates/romacs-introspect/data/registry.json'),
]


def main():
    root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else '.').resolve()
    if not (root / '.git').exists():
        sys.exit(f'check-derived: {root} is not a worktree')
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / 'tools'))
    import derived_artifacts
    try:
        derived_artifacts.check(root)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'check-derived: {exc}', file=sys.stderr)
        return 1
    layout = subprocess.run([sys.executable, '-B', str(root / 'tools/test_lisp_layout.py')], cwd=root)
    oracle = subprocess.run([sys.executable, 'tools/lisp_oracle.py', 'check', '--root', str(root)], cwd=root)
    ratchet = subprocess.run([sys.executable, 'tools/parity_ratchet.py', 'verify', '--candidate', '--root', str(root)], cwd=root)
    if layout.returncode or oracle.returncode or ratchet.returncode:
        return 1
    print(f'check-derived: ok, {len(DERIVED)} derived artifacts match their sources; '
          'lisp/ is the GNU pin; parity floors verified')
    return 0


if __name__ == '__main__':
    sys.exit(main())

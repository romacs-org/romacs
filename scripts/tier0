#!/usr/bin/env python3
"""Small new-crate loop: tier0 [CRATE...|--changed] [-E FILTER].

Runs only named packages, in dev, offline, in a stable per-worktree target.
Every run has a receipt; a missing/ignored/empty test selection is RED.
No receipt reuse: the working tree must stay unchanged throughout the run.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import resource
import subprocess
import sys
import tempfile
import time
import tomllib
import importlib.machinery

ROOT = Path(__file__).resolve().parent.parent
GATE = importlib.machinery.SourceFileLoader('gate', str(ROOT / 'scripts/gate')).load_module()
EDGES = ROOT / 'scripts/crate-edges.toml'
CACHE = Path.home() / '.cache/romacs-t0'


def target_for(root):
    return CACHE / hashlib.sha256(str(root.resolve()).encode()).hexdigest()[:20]


def check_graph(metadata, crates, edges):
    packages = {p['id']: p for p in metadata['packages']}
    nodes = {n['id']: n for n in metadata['resolve']['nodes']}
    by_name = {p['name']: p['id'] for p in packages.values()}
    for crate in crates:
        if crate not in edges or crate not in by_name:
            raise ValueError('edge: unknown new crate ' + crate)
        todo, seen, retained = [by_name[crate]], set(), set()
        while todo:
            ident = todo.pop()
            if ident in seen:
                continue
            seen.add(ident)
            package = packages[ident]
            name = package['name']
            inherited_member = ident in metadata.get('workspace_members', []) and name not in edges
            if ident not in retained and (inherited_member or
                    (name.startswith(('romacs-', 'romacs-', 'romacs-', 'romacs-')) and name not in edges)):
                raise ValueError('links-old-core: ' + name)
            if name in edges:
                if any('custom-build' in t['kind'] or 'proc-macro' in t['kind'] for t in package['targets']):
                    raise ValueError('edge: build script/proc macro ' + name)
                for dep in nodes[ident]['deps']:
                    child = packages[dep['pkg']]['name']
                    # The only retained workspace edge is redisplay's protocol.
                    if (name == 'romacs-redisplay' and child == 'romacs-display-protocol'
                            and child in edges[name]):
                        retained.add(dep['pkg'])
                        continue
                    if dep['pkg'] in metadata.get('workspace_members', []) and child not in edges:
                        raise ValueError('links-old-core: ' + child)
                    if child.startswith(('romacs-', 'romacs-', 'romacs-', 'romacs-')) and child not in edges:
                        raise ValueError('links-old-core: ' + child)
                    # GNU harness is a test-only dependency, not a layer edge.
                    test_harness = child == 'romacs-gnudiff' and all(
                        k['kind'] == 'dev' for k in dep['dep_kinds'])
                    if child in edges and child not in edges[name] and not test_harness:
                        raise ValueError('edge: ' + name + ' -> ' + child)
            todo.extend(d['pkg'] for d in nodes[ident]['deps'])
    return {c: nodes[by_name[c]]['features'] for c in crates}


def changed(root, metadata):
    base = GATE.out('git', 'merge-base', 'HEAD', 'master', cwd=root).decode().strip()
    paths = set(GATE.out('git', 'diff', '--name-only', base, cwd=root).decode().splitlines())
    paths.update(GATE.out('git', 'ls-files', '-mo', '--exclude-standard', cwd=root).decode().splitlines())
    selected = set()
    for p in metadata['packages']:
        if p['source'] is not None:
            continue
        directory = Path(p['manifest_path']).parent
        if not directory.is_relative_to(root):
            continue
        prefix = str(directory.relative_to(root)) + '/'
        if any(f.startswith(prefix) for f in paths):
            selected.add(p['name'])
        # Case files belong to their crate without being compiled into it.
        area = p['name'].removeprefix('romacs-').removeprefix('romacs-').removeprefix('romacs-')
        if area == 'gnudiff':
            area = 'selftest'
        if any(f.startswith('test/gnudiff/' + area + '/') for f in paths):
            selected.add(p['name'])
    return sorted(selected)


def selection(listing):
    identities = {b['package-name'] + '::' + b['binary-name'] + '$' + name
                  for b in listing['rust-suites'].values() for name, s in b['testcases'].items()
                  if s['filter-match']['status'] == 'matches' and not s['ignored']}
    skipped = sum(s['filter-match']['status'] == 'matches' and s['ignored']
                  for b in listing['rust-suites'].values() for s in b['testcases'].values())
    return identities, skipped


def reconcile(listing, events):
    identities, skipped = selection(listing)
    expected = len(identities)
    passed = [e['name'] for e in events if e.get('type') == 'test' and e.get('event') == 'ok']
    bad = [e for e in events if e.get('type') == 'test' and e.get('event') in
           ('failed', 'timeout', 'ignored')]
    if expected == 0:
        raise ValueError('empty-selection')
    if skipped or bad or len(passed) != expected or set(passed) != identities:
        raise ValueError('incomplete-tests')
    return expected, passed


def metadata_for(root, target, env):
    """Publish a graph only across unchanged manifest/lock/config inputs."""
    def key():
        # Discover inputs independently of potentially stale metadata.
        paths = {root / 'Cargo.toml', root / 'Cargo.lock'}
        paths.update(root.glob('**/Cargo.toml'))
        paths.update(root.glob('**/build.rs'))
        for parent in [root, *root.parents, Path(env['CARGO_HOME'])]:
            paths.update((parent / '.cargo/config', parent / '.cargo/config.toml'))
        paths.update((Path(env['CARGO_HOME']) / 'config', Path(env['CARGO_HOME']) / 'config.toml'))
        digest = hashlib.sha256(json.dumps(env, sort_keys=True).encode())
        for path in sorted(paths):
            content = path.read_bytes() if path.is_file() else b'<missing>'
            digest.update(json.dumps([str(path), hashlib.sha256(content).hexdigest()]).encode())
        return digest.hexdigest()
    before = key()
    cached = target / 'metadata.json'
    if cached.exists():
        saved = json.loads(cached.read_text())
        if saved['key'] == before:
            if key() != before:
                raise ValueError('metadata-input-changed')
            return saved['metadata']
    metadata = json.loads(GATE.out('cargo', 'metadata', '--offline', '--format-version', '1',
                                   cwd=root, env=env))
    if key() != before:
        raise ValueError('metadata-input-changed')
    temporary = cached.with_suffix('.tmp')
    temporary.write_text(json.dumps(dict(key=before, metadata=metadata)))
    os.replace(temporary, cached)
    return metadata


def inner(args):
    root, run = Path(args.root), Path(args.run_dir)
    target = target_for(root)
    target.mkdir(parents=True, exist_ok=True)
    env = GATE.env()
    env.update(CARGO_TARGET_DIR=str(target), CARGO_BUILD_JOBS='2',
               NEXTEST_EXPERIMENTAL_LIBTEST_JSON='1')
    # Dev incremental is intentional; slot cache defaults must not override it.
    env.pop('CARGO_INCREMENTAL', None)
    result = dict(schema=1, verdict='RED', reason=None, tree=None, crate=args.crates,
                  features={}, target=str(target), selected=0, passed=[],
                  build_wall_s=0, run_wall_s=0, peak_rss_kib=0)
    start = time.monotonic()
    try:
        with open(target / 'tier0.lock', 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            result['tree'] = GATE.freeze(root)
            metadata = metadata_for(root, target, env)
            if GATE.freeze(root) != result['tree']:
                raise ValueError('tree-changed')
            edges = tomllib.loads(EDGES.read_text())['edges']
            crates = changed(root, metadata) if args.changed else args.crates
            result['crate'] = crates
            if not crates:
                raise ValueError('empty-selection')
            result['features'] = check_graph(metadata, crates, edges)
            # Preserve candidate identity if the capped scope is killed later.
            (run / 'receipt.json').write_text(json.dumps(dict(result, build_wall_s=None,
                run_wall_s=None, peak_rss_kib=None), sort_keys=True) + '\n')
            flags = ['--offline', *[v for c in crates for v in ('-p', c)], '-E', args.filter]
            listing = GATE.out('cargo', 'nextest', 'list', *flags, '--message-format', 'json',
                               cwd=root, env=env)
            (run / 'list.json').write_bytes(listing)
            result['selected'] = len(selection(json.loads(listing))[0])
            result['build_wall_s'] = time.monotonic() - start
            (run / 'receipt.json').write_text(json.dumps(dict(result, run_wall_s=None,
                peak_rss_kib=None), sort_keys=True) + '\n')
            begin = time.monotonic()
            with open(run / 'tests.jsonl', 'w') as out, open(run / 'tests.log', 'w') as err:
                rc = subprocess.call(['cargo', 'nextest', 'run', *flags, '--no-tests=fail',
                                      '--test-threads', '2', '--message-format', 'libtest-json-plus'],
                                     cwd=root, env=env, stdout=out, stderr=err)
            result['run_wall_s'] = time.monotonic() - begin
            events = [json.loads(l) for l in (run / 'tests.jsonl').read_text().splitlines()
                      if l.startswith('{')]
            result['passed'] = [e['name'] for e in events if e.get('type') == 'test' and e.get('event') == 'ok']
            reconcile(json.loads(listing), events)
            if rc:
                raise ValueError('test-exit: ' + str(rc))
            if GATE.freeze(root) != result['tree']:
                raise ValueError('tree-changed')
            result['verdict'] = 'GREEN'
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        result['reason'] = str(error)
    result['peak_rss_kib'] = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
    result['wall_s'] = time.monotonic() - start
    (run / 'receipt.json').write_text(json.dumps(result, sort_keys=True) + '\n')
    print(json.dumps(result), flush=True)
    return int(result['verdict'] != 'GREEN')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('crates', nargs='*')
    parser.add_argument('--changed', action='store_true')
    parser.add_argument('-E', '--filter', default='all()')
    parser.add_argument('--lane', default=os.environ.get('LANE_ID', 'tier0'))
    parser.add_argument('--inner', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--root', help=argparse.SUPPRESS)
    parser.add_argument('--run-dir', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.inner:
        return inner(args)
    if bool(args.crates) == args.changed:
        parser.error('choose CRATE... or --changed')
    root = Path(GATE.out('git', 'rev-parse', '--show-toplevel').decode().strip())
    runs = CACHE / 'runs'
    runs.mkdir(parents=True, exist_ok=True)
    run = Path(tempfile.mkdtemp(prefix=args.lane + '-', dir=runs))
    print('tier0: receipt ' + str(run / 'receipt.json'), flush=True)
    cmd = ['systemd-run', '--user', '--scope', '--quiet', '-p', 'MemoryMax=3G',
           '-p', 'MemorySwapMax=0', GATE.SLOT, args.lane, '--light', '--max-min', '2', '--',
           sys.executable, str(Path(__file__).resolve()), '--inner', '--root', str(root),
           '--run-dir', str(run), '-E', args.filter,
           *(['--changed'] if args.changed else args.crates)]
    start = time.monotonic()
    rc = subprocess.call(cmd, cwd=root)
    receipt = run / 'receipt.json'
    if not receipt.exists():
        receipt.write_text(json.dumps(dict(schema=1, verdict='RED', reason='scope-exit',
                                          exit=rc, tree=None, crate=args.crates, features={},
                                          selected=0, passed=[], build_wall_s=None,
                                          run_wall_s=None, peak_rss_kib=None)) + '\n')
    result = json.loads(receipt.read_text())
    result.update(edit_to_result_s=time.monotonic() - start, scope_exit=rc, memory_max='3G')
    if rc:
        result['verdict'] = 'RED'
        result['reason'] = result.get('reason') or 'scope-exit'
    receipt.write_text(json.dumps(result, sort_keys=True) + '\n')
    return int(rc != 0 or result['verdict'] != 'GREEN')


if __name__ == '__main__':
    sys.exit(main())

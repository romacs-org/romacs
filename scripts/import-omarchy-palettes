#!/usr/bin/env python3
"""Make Romacs themes of Omarchy's palettes: one etc/themes/omarchy-NAME-theme.el
per themes/NAME/colors.toml, the bundled family table in rlisp/romacs-theme.el
(between its marker comments) and etc/themes/README.md.

Omarchy is not a build input: the files are generated once and committed,
and a refresh is a deliberate commit.  Only `key = "#rrggbb"' and
`mode = "dark"|"light"' lines are read; keys outside the palette
vocabulary (Hyprland's, for one) are ignored.

usage: import-omarchy-palettes [--source DIR] [--version 'X.Y.Z (commit)'] [--repo DIR] [--check]

--source   Omarchy's themes directory (default /usr/share/omarchy/themes)
--version  the Omarchy version the palettes come from (default: the one
           the committed files record)
--check    write nothing; report every file that would change, exit 1 if any
"""
import argparse
from pathlib import Path
import re
import sys

ROOT = Path(__file__).resolve().parents[1]

# Omarchy colors.toml key -> palette slot (rlisp/romacs-theme.el).
SLOTS = [('accent', 'accent'), ('selection', 'selection'), ('muted', 'muted'),
         ('background', 'bg'), ('dark_background', 'bg-dark'), ('darker_background', 'bg-darker'),
         ('lighter_background', 'bg-alt'), ('foreground', 'fg'), ('dark_foreground', 'fg-dim'),
         ('light_foreground', 'fg-light'), ('bright_foreground', 'fg-bright'),
         ('red', 'red'), ('yellow', 'yellow'), ('orange', 'orange'), ('green', 'green'),
         ('cyan', 'cyan'), ('blue', 'blue'), ('magenta', 'magenta'), ('brown', 'brown'),
         ('bright_red', 'bright-red'), ('bright_yellow', 'bright-yellow'), ('bright_green', 'bright-green'),
         ('bright_cyan', 'bright-cyan'), ('bright_blue', 'bright-blue'), ('bright_magenta', 'bright-magenta')]
OPTIONAL = {'orange', 'brown'}

# What each palette is after, and that palette's licence, as read from the
# upstream repository's LICENSE (or README, where it has no LICENSE file).
UPSTREAM = {
    'catppuccin': ('Catppuccin', 'catppuccin/catppuccin', 'MIT'),
    'catppuccin-latte': ('Catppuccin Latte', 'catppuccin/catppuccin', 'MIT'),
    'everforest': ('Everforest', 'sainnhe/everforest', 'MIT'),
    'flexoki-light': ('Flexoki Light', 'kepano/flexoki', 'MIT'),
    'gruvbox': ('Gruvbox', 'morhetz/gruvbox', 'MIT (README; no LICENSE file)'),
    'kanagawa': ('Kanagawa', 'rebelot/kanagawa.nvim', 'MIT'),
    'nord': ('Nord', 'nordtheme/nord', 'MIT'),
    'rose-pine': ('Rosé Pine', 'rose-pine/rose-pine-theme', 'MIT'),
    'tokyo-night': ('Tokyo Night', 'tokyo-night/tokyo-night-vscode-theme', 'MIT'),
    'ristretto': ('Ristretto', None, "values via Omarchy (MIT); the name is Monokai Pro's"),
}
# Themes whose variants `theme-choose-variant' moves between.
FAMILIES = {'catppuccin-latte': 'catppuccin'}

ENTRY = re.compile(r'^\s*([a-z_]+)\s*=\s*"([^"]*)"\s*$')
HEX = re.compile(r'^#[0-9a-fA-F]{6}$')


def parse(path):
    """The palette of colors.toml PATH: (mode, [(slot, '#rrggbb'), ...])."""
    found = {}
    for line in path.read_text().splitlines():
        m = ENTRY.match(line)
        if m:
            found[m.group(1)] = m.group(2)
    mode = found.get('mode')
    if mode not in ('dark', 'light'):
        raise SystemExit(f'{path}: mode must be "dark" or "light", not {mode!r}')
    palette = []
    for key, slot in SLOTS:
        value = found.get(key)
        if value is None:
            if slot in OPTIONAL:
                continue
            raise SystemExit(f'{path}: no {key}')
        if not HEX.match(value):
            raise SystemExit(f'{path}: {key} = {value!r} is not #rrggbb')
        palette.append((slot, value.lower()))
    return mode, palette


def title(name):
    return UPSTREAM.get(name, (' '.join(w.capitalize() for w in name.split('-')),))[0]


def theme_file(name, mode, palette, version):
    """The theme file of Omarchy palette NAME."""
    after = UPSTREAM.get(name)
    lines = [f';;; omarchy-{name}-theme.el --- {title(name)} (Omarchy palette)  -*- lexical-binding: t -*-',
             ';; SPDX-License-Identifier: GPL-3.0-or-later',
             ';; Maintainer: Thanos Apollo <public@thanosapollo.org>',
             f';; Palette: Omarchy {version} themes/{name}/colors.toml, MIT,',
             ';; https://github.com/omacom/omarchy'
             + (f'; after {after[0]} ({after[2]}{", https://github.com/" + after[1] if after[1] else ""}).' if after else '.'),
             ';; Generated by scripts/import-omarchy-palettes; edit the palette there.',
             '',
             ';;; Commentary:',
             f";; The {title(name)} palette as a Romacs theme: its base colours, from",
             ";; which rlisp/romacs-theme.el derives every face.",
             '',
             ';;; Code:',
             '',
             "(require 'romacs-theme)",
             '',
             f"(romacs-theme-define 'omarchy-{name} \"{title(name)}, from Omarchy's palette.\"",
             f"  :family 'omarchy-{FAMILIES.get(name, name)} :mode '{mode}"]
    rows = [f'({slot} "{value}")' for slot, value in palette]
    for i in range(0, len(rows), 4):
        lead = "  :palette '(" if i == 0 else '             '
        lines.append(lead + ' '.join(rows[i:i + 4]) + ('))' if i + 4 >= len(rows) else ''))
    lines += ['', f';;; omarchy-{name}-theme.el ends here', '']
    return '\n'.join(lines)


BEGIN = ';; Begin: generated by scripts/import-omarchy-palettes.'
END = ';; End: generated by scripts/import-omarchy-palettes.'


def ported(root):
    """The ported schemes in etc/themes, read from each file, as
    (NAME, MODE, FAMILY, UPSTREAM, LICENCE, URL)."""
    rows = []
    for path in sorted((root / 'etc/themes').glob('*-theme.el')):
        text = path.read_text()
        form = re.search(r'^\(def-romacs-theme (\S+) .*?:mode (\w+) :family (\S+)', text, re.M | re.S)
        if form:
            who, licence, url = re.search(r'^;; Palette: (.+), ([^,]+), (\S+)$', text, re.M).groups()
            rows.append((*form.groups(), who, licence, url))
    return rows


def family_table(themes, ports):
    """The `romacs-theme-bundled' form: (NAME MODE FAMILY) for each theme."""
    rows = ['(default dark default)', '(rum dark rum)'] + [
        f'({name} {mode} {family})' for name, mode, family, *_ in ports] + [
        f'(omarchy-{name} {mode} omarchy-{FAMILIES.get(name, name)})' for name, mode, _ in themes]
    body = '\n    '.join(rows)
    return (f'{BEGIN}\n(defconst romacs-theme-bundled\n  \'({body})\n'
            '  "The themes Romacs ships, as (NAME MODE FAMILY).")\n' + END)


def with_table(source, table):
    start, end = source.index(BEGIN), source.index(END) + len(END)
    return source[:start] + table + source[end:]


def readme(themes, version, ports):
    lines = ['# Bundled themes', '',
             'Romacs themes are palettes (rlisp/romacs-theme.el): each file names a',
             "theme's base colours, and every face is derived from them.", '',
             '- `default-theme.el`: the stock look a session starts in.',
             '- `NAME-theme.el` with `def-romacs-theme`: popular colour schemes ported as',
             "  Romacs's own: each upstream's colour values with Romacs's face mapping, its",
             '  source and commit in the file header (table below).',
             '- `omarchy-NAME-theme.el`: the palettes of Omarchy\'s themes, generated by',
             '  `scripts/import-omarchy-palettes` from Omarchy ' + version + "'s",
             '  `themes/NAME/colors.toml`. Omarchy is MIT-licensed',
             '  (https://github.com/omacom/omarchy, LICENSE); a refresh is a commit of',
             '  the regenerated files.', '',
             'A palette file uses colors.toml\'s keys: `mode` (`dark` or `light`),',
             '`accent selection muted background dark_background darker_background',
             'lighter_background foreground dark_foreground light_foreground',
             'bright_foreground red yellow orange green cyan blue magenta brown',
             'bright_red bright_yellow bright_green bright_cyan bright_blue',
             'bright_magenta`, each `"#rrggbb"`.', '',
             '| ported theme | mode | palette | its licence |', '|---|---|---|---|']
    lines += [f'| `{name}` | {mode} | {who} ({url}) | {licence} |' for name, mode, _, who, licence, url in ports]
    lines += ['', '| theme | mode | palette after | its licence |', '|---|---|---|---|']
    for name, mode, _ in themes:
        after = UPSTREAM.get(name)
        source = (f'{after[0]}' + (f' (https://github.com/{after[1]})' if after[1] else '')) if after else "Omarchy's own"
        licence = after[2] if after else 'MIT (Omarchy)'
        lines.append(f'| `omarchy-{name}` | {mode} | {source} | {licence} |')
    lines += ['', 'Colour values as such carry little or no copyright; the names carry the',
              "upstream projects' goodwill, which the `omarchy-` prefix and each file's",
              'attribution line respect.', '']
    return '\n'.join(lines)


def recorded_version(root):
    for path in sorted((root / 'etc/themes').glob('omarchy-*-theme.el')):
        m = re.search(r'^;; Palette: Omarchy (.+) themes/', path.read_text(), re.M)
        if m:
            return m.group(1)
    raise SystemExit('no committed palette records a version: pass --version')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--source', type=Path, default=Path('/usr/share/omarchy/themes'))
    ap.add_argument('--version')
    ap.add_argument('--repo', type=Path, default=ROOT)
    ap.add_argument('--check', action='store_true')
    args = ap.parse_args()
    version = args.version or recorded_version(args.repo)
    themes = []
    for directory in sorted(p for p in args.source.iterdir() if p.is_dir()):
        colors = directory / 'colors.toml'
        if colors.is_file():
            mode, palette = parse(colors)
            themes.append((directory.name, mode, palette))
    if not themes:
        raise SystemExit(f'{args.source}: no themes/NAME/colors.toml')
    out = {args.repo / 'etc/themes' / f'omarchy-{name}-theme.el': theme_file(name, mode, palette, version)
           for name, mode, palette in themes}
    ports = ported(args.repo)
    out[args.repo / 'etc/themes/README.md'] = readme(themes, version, ports)
    engine = args.repo / 'rlisp/romacs-theme.el'
    out[engine] = with_table(engine.read_text(), family_table(themes, ports))
    stale = {p for p in (args.repo / 'etc/themes').glob('omarchy-*-theme.el')} - set(out)
    changed = [p for p, text in out.items() if not p.exists() or p.read_text() != text] + sorted(stale)
    if args.check:
        for path in changed:
            print(f'drift: {path.relative_to(args.repo)}')
        return 1 if changed else 0
    for path, text in out.items():
        if not path.exists() or path.read_text() != text:
            path.write_text(text)
    for path in stale:
        path.unlink()
    print(f'{len(themes)} palettes from Omarchy {version}; {len(changed)} files written')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

#!/usr/bin/env python3
"""lanes: claim a surface, keep to it, and prove a candidate merges without divergence.

One file-based registry shared by every lane and the integrator:

    claim    LANE --base SHA --surface GLOB... [--forbid GLOB...] [--branch REF]
    renew    LANE                      push the expiry forward (lanes call it per gate)
    release  LANE --outcome merged|parked|rejected|abandoned [--note TEXT]
    list                               active claims, then expired ones
    check    LANE [--tip REF]          the integrator's merge gate (exit 0 = mergeable)
    ledger   --candidate T --donor T --master T [--path P...]   blob-by-blob rebuild proof
    record   LANE --run DIR            append one farm-log row for a finished gate run
    farm     [--backfill HOURS]        print the farm log; backfill from slot ledgers
    reject   SHA [--base SHA] --reason TEXT   register rejected work (checked by path)

The registry lives at the REAL home (resolved from the password database, never
$HOME, because lane-env replaces HOME per lane): ~/.cache/romacs-lanes/, or
--registry / $LANES_REGISTRY. Every git call runs with GIT_DIR/GIT_WORK_TREE/
GIT_INDEX_FILE removed and the canonical landing ref resolved as refs/heads/master,
never HEAD, so a checkout parked on a feature branch cannot impersonate master.
"""
import argparse, fcntl, functools, fnmatch, glob, json, os, pwd, re, subprocess, sys, time
import fnmatch
import re
from pathlib import Path

REAL_HOME = Path(pwd.getpwuid(os.getuid()).pw_dir)
DEFAULT_REPO = REAL_HOME / 'Projects/rust/romacs'
DEFAULT_TTL_H = 8.0
SHARED = ['Cargo.lock', 'Cargo.toml']      # union-merged by the integrator, never claimed
OUTCOMES = ('merged', 'parked', 'rejected', 'abandoned', 'expired')


# ---------------------------------------------------------------- git, cleanly
def git(repo, *args, check=True, inp=None):
    env = {k: v for k, v in os.environ.items()
           if k not in ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY')}
    env['HOME'] = str(REAL_HOME)            # real config; read-only ops need no identity
    p = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True,
                       env=env, input=inp)
    if check and p.returncode != 0:
        raise SystemExit(f'lanes: git {" ".join(args)} failed ({p.returncode}): {p.stderr.strip()}')
    return p


def rev(repo, ref):
    return git(repo, 'rev-parse', '--verify', '--quiet', ref + '^{commit}').stdout.strip()


def is_ancestor(repo, a, b):
    return git(repo, 'merge-base', '--is-ancestor', a, b, check=False).returncode == 0


def changed(repo, a, b):
    out = git(repo, 'diff', '--no-renames', '--name-only', '-z', a, b).stdout
    return [p for p in out.split('\0') if p]


# ---------------------------------------------------------------- surfaces
KNOWN_PREFIXES = ('crate:',)


def norm(pattern):
    """crate:NAME -> crates/NAME/**; trailing / -> dir/**; else a glob or exact path.

    An unknown WORD: prefix is refused rather than taken literally. Treating
    dir:lisp as a filename matches nothing, and because a surface that matches
    nothing also overlaps nothing, two lanes could claim the same directory and
    both be told the surface was free.
    """
    if pattern.startswith(KNOWN_PREFIXES):
        return f'crates/{pattern[6:]}/**'
    m = re.match(r'([a-z][a-z0-9_-]*):(.*)', pattern)
    if m:
        word, rest = m.groups()
        hint = (f'{rest}/' if '.' not in rest.rsplit('/', 1)[-1] else rest) or rest
        print(f'lanes: REFUSED: unknown surface prefix {word!r} in {pattern!r}; '
              f'supported: crate:NAME, a trailing slash for a directory, or a plain glob. '
              f'Did you mean {hint!r}?', file=sys.stderr)
        raise SystemExit(2)
    if pattern.endswith('/'):
        return pattern + '**'
    return pattern


@functools.lru_cache(maxsize=None)
def to_regex(pattern):
    out, i = [], 0
    while i < len(pattern):
        c = pattern[i]
        if pattern.startswith('**/', i):
            out.append('(?:.*/)?'); i += 3; continue
        if pattern.startswith('**', i):
            out.append('.*'); i += 2; continue
        out.append('[^/]*' if c == '*' else '[^/]' if c == '?' else re.escape(c)); i += 1
    return re.compile(''.join(out) + r'\Z')


def matches(path, patterns):
    return any(to_regex(p).match(path) for p in patterns)


def literal_dir(pattern):
    head = re.split(r'[*?\[]', pattern, maxsplit=1)[0]
    return head if head.endswith('/') or head == '' else (head.rsplit('/', 1)[0] + '/' if '/' in head else '')


def overlap(a_pats, b_pats, tracked):
    """Paths both surfaces would own: tracked files plus a probe for new files in each claimed dir."""
    probes = {literal_dir(p) + '__new_file__' for p in a_pats + b_pats if any(ch in p for ch in '*?[')}
    hits = [f for f in list(tracked) + sorted(probes) if matches(f, a_pats) and matches(f, b_pats)]
    return hits


# ---------------------------------------------------------------- registry
class Registry:
    def __init__(self, root):
        self.root = Path(root)
        (self.root / 'claims').mkdir(parents=True, exist_ok=True)
        self.lockf = open(self.root / 'registry.lock', 'a+')

    def __enter__(self):
        fcntl.flock(self.lockf, fcntl.LOCK_EX); return self

    def __exit__(self, *exc):
        fcntl.flock(self.lockf, fcntl.LOCK_UN)

    def path(self, lane):
        if not re.fullmatch(r'[A-Za-z0-9._-]+', lane):
            raise SystemExit(f'lanes: bad lane name {lane!r}')
        return self.root / 'claims' / f'{lane}.json'

    def claims(self):
        return [json.loads(p.read_text()) for p in sorted((self.root / 'claims').glob('*.json'))]

    def get(self, lane):
        p = self.path(lane)
        return json.loads(p.read_text()) if p.exists() else None

    def write(self, claim):
        p = self.path(claim['lane']); tmp = p.with_suffix('.tmp')
        tmp.write_text(json.dumps(claim, indent=1, sort_keys=True)); os.replace(tmp, p)

    def event(self, kind, **row):
        row = dict(event=kind, at=time.time(), at_iso=time.strftime('%Y-%m-%dT%H:%M:%S%z'), **row)
        with open(self.root / 'history.jsonl', 'a') as f:
            f.write(json.dumps(row, sort_keys=True) + '\n')

    def farm(self, row):
        with open(self.root / 'farm.jsonl', 'a') as f:
            f.write(json.dumps(row, sort_keys=True) + '\n')

    def rejected(self):
        p = self.root / 'rejected.jsonl'
        return [json.loads(l) for l in p.read_text().splitlines() if l.strip()] if p.exists() else []

    def expire(self, now=None):
        """Move expired claims to history. Called under the lock by every mutating command."""
        now, gone = now or time.time(), []
        for c in self.claims():
            if c['expires'] < now:
                self.path(c['lane']).unlink()
                self.event('expire', lane=c['lane'], surface=c['surface'], base=c['base'])
                self.farm(farm_row(c, outcome='expired'))
                gone.append(c['lane'])
        return gone


def loadavg():
    try:
        return [float(x) for x in Path('/proc/loadavg').read_text().split()[:3]]
    except OSError:
        return None


def farm_row(claim, **extra):
    row = {k: claim.get(k) for k in ('lane', 'base', 'surface', 'forbid', 'branch', 'worktree', 'claimed')}
    row.update(loadavg=loadavg(), at=time.time(), at_iso=time.strftime('%Y-%m-%dT%H:%M:%S%z'))
    row.update(extra)
    return row


# ---------------------------------------------------------------- commands
def cmd_claim(a, reg):
    repo = Path(a.repo)
    master = rev(repo, 'refs/heads/master')
    base = rev(repo, a.base)
    if not base:
        raise SystemExit(f'lanes: base {a.base} does not resolve')
    surface = [norm(p) for p in (a.surface or [])]
    forbid = [norm(p) for p in (a.forbid or [])]
    problems = []
    if not is_ancestor(repo, base, master):
        problems.append(f'base {base[:10]} is not on refs/heads/master ({master[:10]}): '
                        'a lane must start from master, not from a branch')
    for r in reg.rejected():
        if is_ancestor(repo, r['sha'], base):
            problems.append(f'base carries rejected {r["sha"][:10]} ({r["reason"]})')
    if base != master:
        print(f'lanes: note: base {base[:10]} is behind master {master[:10]}; '
              f'{len(git(repo, "rev-list", f"{base}..{master}").stdout.split())} commits', file=sys.stderr)
    tracked = git(repo, 'ls-tree', '-r', '--name-only', '-z', master).stdout.split('\0')
    tracked = [t for t in tracked if t]
    with reg:
        reg.expire()
        if reg.get(a.lane):
            problems.append(f'lane {a.lane} already holds a claim; renew or release it')
        for other in reg.claims():
            if other['lane'] == a.lane:
                continue
            hits = overlap(surface, other['surface'], tracked)
            if hits:
                problems.append(f'surface overlaps {other["lane"]} (expires '
                                f'{time.strftime("%H:%M", time.localtime(other["expires"]))}): '
                                f'{len(hits)} paths, e.g. {", ".join(hits[:3])}')
        owned = [t for t in tracked if matches(t, surface)]
        if not owned and not a.allow_empty:
            problems.append('surface matches no tracked file at master (typo?); --allow-empty for new dirs')
        if problems:
            reg.event('refuse', lane=a.lane, surface=surface, base=base, reasons=problems)
            for p in problems:
                print(f'lanes: REFUSED: {p}', file=sys.stderr)
            return 2
        now = time.time()
        claim = dict(lane=a.lane, base=base, surface=surface, forbid=forbid, branch=a.branch,
                     worktree=a.worktree, brief=a.brief, claimed=now, renewed=now,
                     expires=now + a.ttl * 3600, ttl_h=a.ttl, master_at_claim=master)
        reg.write(claim)
        reg.event('claim', **{k: claim[k] for k in ('lane', 'base', 'surface', 'forbid', 'branch')})
        reg.farm(farm_row(claim, outcome='claimed', tracked_paths=len(owned)))
    print(f'lanes: {a.lane} holds {", ".join(surface)} from {base[:10]} '
          f'({len(owned)} tracked paths) until {time.strftime("%H:%M", time.localtime(claim["expires"]))}')
    return 0


def cmd_renew(a, reg):
    with reg:
        reg.expire()
        c = reg.get(a.lane)
        if not c:
            print(f'lanes: {a.lane} holds no claim (expired or never made); claim again', file=sys.stderr)
            return 2
        c['renewed'] = time.time(); c['expires'] = c['renewed'] + c['ttl_h'] * 3600
        reg.write(c); reg.event('renew', lane=a.lane)
    print(f'lanes: {a.lane} renewed until {time.strftime("%H:%M", time.localtime(c["expires"]))}')
    return 0


def cmd_release(a, reg):
    with reg:
        c = reg.get(a.lane)
        if not c:
            print(f'lanes: {a.lane} holds no claim', file=sys.stderr); return 2
        reg.path(a.lane).unlink()
        reg.event('release', lane=a.lane, outcome=a.outcome, note=a.note, tip=a.tip)
        reg.farm(farm_row(c, outcome=a.outcome, note=a.note, tip=a.tip,
                          held_h=round((time.time() - c['claimed']) / 3600, 2)))
    print(f'lanes: {a.lane} released ({a.outcome})')
    return 0


def cmd_list(a, reg):
    now = time.time()
    rows = reg.claims()
    if a.json:
        print(json.dumps(rows, indent=1)); return 0
    if not rows:
        print('lanes: no claims')
    for c in sorted(rows, key=lambda c: c['claimed']):
        state = 'EXPIRED' if c['expires'] < now else f'until {time.strftime("%H:%M", time.localtime(c["expires"]))}'
        print(f'{c["lane"]:<22} {state:<12} base={c["base"][:10]} branch={c.get("branch") or "-"}  '
              f'{" ".join(c["surface"])}' + (f'  forbid={" ".join(c["forbid"])}' if c['forbid'] else ''))
    return 0


def cmd_reject(a, reg):
    repo = Path(a.repo)
    sha = rev(repo, a.sha)
    base = rev(repo, a.base) if a.base else rev(repo, sha + '^1')
    with reg:
        with open(reg.root / 'rejected.jsonl', 'a') as f:
            f.write(json.dumps(dict(sha=sha, base=base, reason=a.reason, at=time.time())) + '\n')
        reg.event('reject', sha=sha, base=base, reason=a.reason)
    print(f'lanes: rejected {sha[:10]} (paths introduced since {base[:10]}): {a.reason}')
    return 0


def blob(repo, tree, path):
    out = git(repo, 'ls-tree', '-z', tree, '--', path).stdout
    if not out:
        return None
    meta, _, _ = out.partition('\t')
    mode, _, oid = meta.split(' ')
    return mode, oid


def text(repo, oid):
    return git(repo, 'cat-file', 'blob', oid).stdout if oid else ''


def added_blocks(repo, a, b, path, min_lines):
    """Contiguous runs of added, non-blank lines from a..b at PATH, at least MIN_LINES long."""
    diff = git(repo, 'diff', '--no-renames', '-U0', a, b, '--', path).stdout.splitlines()
    blocks, cur = [], []
    for line in diff:
        if line.startswith('+') and not line.startswith('+++'):
            if line[1:].strip():
                cur.append(line[1:])
            continue
        if len(cur) >= min_lines:
            blocks.append('\n'.join(cur))
        cur = []
    if len(cur) >= min_lines:
        blocks.append('\n'.join(cur))
    return blocks


def squash(s):
    return '\n'.join(l for l in s.splitlines() if l.strip())


def rejected_paths_check(repo, rej, tip, master, min_lines=3):
    """Per-path ledger: does TIP carry what REJ introduced over its base? Enumerated, not grepped."""
    rows = []
    fields = [f for f in git(repo, 'diff', '--no-renames', '--name-status', '-z',
                             rej['base'], rej['sha']).stdout.split('\0') if f]
    pairs = list(zip(fields[0::2], fields[1::2]))
    for status, path in pairs:
        t, m, r = blob(repo, tip, path), blob(repo, master, path), blob(repo, rej['sha'], path)
        if status == 'A':
            bad = t is not None and m is None
            rows.append(dict(path=path, status='A', carried=bad,
                             why='rejected file present in candidate, absent on master' if bad else
                             ('absent' if t is None else 'also on master')))
        elif status == 'D':
            bad = t is None and m is not None
            rows.append(dict(path=path, status='D', carried=bad,
                             why='rejected deletion reproduced' if bad else 'present'))
        else:
            if t is None:
                rows.append(dict(path=path, status=status, carried=False, why='absent in candidate')); continue
            if r and t == r and t != m:
                rows.append(dict(path=path, status=status, carried=True, why='blob identical to rejected')); continue
            tip_txt, master_txt = squash(text(repo, t[1])), squash(text(repo, m[1]) if m else '')
            hits = [blk for blk in added_blocks(repo, rej['base'], rej['sha'], path, min_lines)
                    if squash(blk) in tip_txt and squash(blk) not in master_txt]
            rows.append(dict(path=path, status=status, carried=bool(hits),
                             why=f'{len(hits)} rejected block(s) of >={min_lines} lines present' if hits
                             else 'no rejected block present'))
    return rows


# Which gate tiers can certify a tree, strongest first. `full` is the
# acceptance gate; the others are narrower or exploratory runs.
MODE_RANK = {'full': 3, 'changed': 2, 'focused': 1}

# Paths the Rust gate provably never reads, so a tree differing from a
# certified tree ONLY in these is certified by the same run. Deliberately tiny
# and explicit: this is a safety signal, and anything broader turns a real
# verdict into a hand-wave. `scripts/gate` is NOT here -- it IS the harness.
NON_GATE_INPUTS = ('scripts/lanes', 'scripts/tests/', 'scripts/lane-run')


def _non_gate_only(repo, tree_a, tree_b):
    """Paths differing between two trees, and whether all are gate-irrelevant."""
    out = git(repo, 'diff', '--no-renames', '--name-only', '-z', tree_a, tree_b).stdout
    paths = [p for p in out.split('\0') if p]
    irrelevant = [p for p in paths
                  if p.startswith(NON_GATE_INPUTS) or p.endswith('.md')]
    return paths, (bool(paths) and len(irrelevant) == len(paths))


def certified_transitively(repo, tree):
    """A GREEN full receipt for a tree differing only in non-gate-input paths.

    Tooling-only and documentation-only commits land between gates constantly,
    and re-gating a tree whose Rust inputs are byte-identical buys nothing but
    twenty minutes of a scarce slot. This reports the delta explicitly so the
    claim can be checked rather than trusted, and refuses the moment a single
    path outside the allowlist appears.
    """
    for f in glob.glob(str(REAL_HOME / '.cache/emax-gate/runs/*/receipt.json')):
        try:
            r = json.loads(Path(f).read_text())
        except (OSError, ValueError):
            continue
        if r.get('verdict') != 'GREEN' or r.get('mode') != 'full' or not r.get('complete'):
            continue
        other = r.get('tree')
        if not other or other == tree:
            continue
        paths, ok = _non_gate_only(repo, other, tree)
        if ok:
            return (f, r, paths)
    return None


def find_receipt(tree, mode=None):
    """Most authoritative gate receipt for exactly this tree.

    Ranked by TIER first and recency second, not recency alone. A tree can
    carry several receipts from different tiers, and a later narrow run must
    not overrule an earlier acceptance gate: the vendor candidate had a GREEN
    mode=full receipt (core 12,591, display 5,371, zero failures) followed
    twelve minutes later by two RED mode=packages runs that execute no core or
    display tests at all. Picking the newest called a green tree NOT MERGEABLE.

    An unranked tier (`packages`, `oracle-live`, build probes) never certifies
    on its own; `other_tiers` reports it so a red exploratory run is still
    visible rather than silently dropped.
    """
    best, others = None, []
    for f in glob.glob(str(REAL_HOME / '.cache/emax-gate/runs/*/receipt.json')):
        try:
            r = json.loads(Path(f).read_text())
        except (OSError, ValueError):
            continue
        if r.get('tree') != tree:
            continue
        if mode and r.get('mode') != mode:
            continue
        m = os.path.getmtime(f)
        rank = MODE_RANK.get(r.get('mode'), 0)
        if rank == 0:
            others.append((m, f, r))
            continue
        key = (rank, m)
        if not best or key > best[0]:
            best = (key, (m, f, r))
    found = best[1] if best else None
    if found is not None:
        found = (*found, sorted(others, reverse=True))
    return found


def inventory_skipped(run_dir, suite):
    p = Path(run_dir) / f'{suite}-tests.json'
    try:
        inv = json.loads(p.read_text())['rust-suites']
    except (OSError, ValueError, KeyError):
        return None
    return sum(1 for b in inv.values() for t in b['testcases'].values() if t['ignored'])


def metrics(receipt, run_dir):
    out = {}
    for suite, o in (receipt.get('outcomes') or {}).items():
        out[suite] = dict(body_ok=o.get('ok'), failed=o.get('failed'), timeout=o.get('timeout'),
                          started=o.get('started'), receipt_selected=(receipt.get('selected') or {}).get(suite),
                          ignored_events=o.get('ignored'), inventory_skipped=inventory_skipped(run_dir, suite))
    return out


def cmd_check(a, reg):
    repo = Path(a.repo)
    c = reg.get(a.lane) if a.lane else None
    if a.lane and not c and not a.surface:
        print(f'lanes: {a.lane} holds no claim; pass --surface/--base to check unclaimed work', file=sys.stderr)
        return 2
    # Integration-time call: `check --tip X` for a finished lane whose claim is
    # already released has no claim and no --surface. That is the normal way to
    # vet a merge, and it used to crash here on c being None. With no declared
    # surface there is no surface constraint to violate, so the tip's own paths
    # are the surface and the remaining checks -- ancestry, conflicts, receipts,
    # other lanes' claims -- are the ones that matter.
    undeclared = False
    if a.surface:
        surface = [norm(q) for q in a.surface]
    elif c:
        surface = c['surface']
    else:
        # Nothing declared, so there is no containment to check. Do NOT use a
        # '*' sentinel: the matcher is path-segment aware, so '*' matches
        # nothing containing a slash and every path reads as "outside" -- a
        # spurious FAIL wearing the costume of a real one. say() is also not
        # defined until further down, so the note is deferred.
        surface = []
        undeclared = True
    forbid = [norm(p) for p in a.forbid] if a.forbid else (c['forbid'] if c else [])
    tipref = a.tip or (c and c.get('branch'))
    if not tipref:
        raise SystemExit('lanes: no --tip and the claim names no branch')
    tip = rev(repo, tipref)
    master = rev(repo, 'refs/heads/master')
    base = rev(repo, a.base) if a.base else (c['base'] if c else git(repo, 'merge-base', master, tip).stdout.strip())
    fails, warns, report = [], [], dict(lane=a.lane, tip=tip, master=master, base=base)

    def say(level, msg):
        (fails if level == 'FAIL' else warns if level == 'WARN' else []).append(msg)
        print(f'{level:<4} {msg}')

    # 0. the canonical checkout must be ON master, or integration commits land on a branch
    canon = git(Path(a.canonical), 'branch', '--show-current', check=False).stdout.strip()
    say('ok' if canon == 'master' else 'FAIL',
        f'canonical checkout {a.canonical} is on {canon or "(detached)"!r}'
        + ('' if canon == 'master' else ': every integration commit made there lands on that branch'))

    # 1. ancestry: the claimed base must be under the tip and on master
    say('ok' if is_ancestor(repo, base, master) else 'FAIL', f'base {base[:10]} is on refs/heads/master')
    say('ok' if is_ancestor(repo, base, tip) else 'FAIL', f'base {base[:10]} is an ancestor of tip {tip[:10]}')
    mb = git(repo, 'merge-base', master, tip).stdout.strip()
    behind = git(repo, 'rev-list', '--count', f'{mb}..{master}').stdout.strip()
    say('ok' if mb == master else 'WARN',
        f'tip {"is" if mb == master else "is NOT"} based on current master'
        + ('' if mb == master else f' (merge-base {mb[:10]}, master is {behind} commits ahead)'))

    # 2. merges in the lane's own range: a merge whose side parent is not on master imports foreign work
    merges = git(repo, 'rev-list', '--merges', '--parents', f'{mb}..{tip}').stdout.split('\n')
    foreign = []
    for line in filter(None, merges):
        commit, *parents = line.split()
        for p in parents[1:]:
            if not is_ancestor(repo, p, master):
                foreign.append((commit, p))
    report['foreign_merges'] = foreign
    say('FAIL' if foreign else 'ok',
        f'{len(foreign)} merge(s) in {mb[:10]}..{tip[:10]} import history not on master'
        + (': ' + ', '.join(f'{m[:10]}<-{p[:10]}' for m, p in foreign[:4])
           + ' -> rebuild on master with `lanes ledger`, do not rebase' if foreign else ''))
    nparents = len(git(repo, 'rev-list', '--parents', '-n1', tip).stdout.split()) - 1
    first = git(repo, 'rev-list', '--first-parent', '--reverse', f'{mb}..{tip}').stdout.split()
    root_parent = git(repo, 'rev-parse', first[0] + '^1').stdout.strip() if first else tip
    report.update(tip_parents=nparents, first_parent_root=root_parent)
    say('ok' if root_parent == mb else 'FAIL',
        f'first-parent chain of {len(first)} commit(s) starts on merge-base {mb[:10]}')

    # 3. rejected work, by enumerated paths of what it introduced
    rej_rows = []
    for r in reg.rejected():
        anc = is_ancestor(repo, r['sha'], tip)
        rows = rejected_paths_check(repo, r, tip, master, a.min_block)
        carried = [x for x in rows if x['carried']]
        rej_rows.append(dict(sha=r['sha'], ancestor=anc, paths=rows))
        say('FAIL' if anc else 'ok', f'rejected {r["sha"][:10]} is {"" if anc else "not "}an ancestor')
        say('FAIL' if carried else 'ok',
            f'rejected {r["sha"][:10]}: {len(carried)}/{len(rows)} of its paths carried'
            + (': ' + ', '.join(f'{x["path"]} ({x["why"]})' for x in carried[:5]) if carried else ''))
    report['rejected'] = rej_rows

    # 4. surface: every changed path is ours, shared, or a violation
    paths = changed(repo, mb, tip)
    others = [o for o in reg.claims() if o['lane'] != a.lane and o['expires'] > time.time()]
    outside = [p for p in paths if not matches(p, surface) and p not in SHARED]
    forbidden = [p for p in paths if matches(p, forbid)]
    shared = [p for p in paths if p in SHARED]
    trespass = {o['lane']: [p for p in paths if matches(p, o['surface']) and p not in SHARED] for o in others}
    trespass = {k: v for k, v in trespass.items() if v}
    report.update(changed=len(paths), outside=outside, forbidden=forbidden, trespass=trespass, shared=shared)
    if undeclared:
        say('note', f'{len(paths)} changed path(s); no surface declared, so containment is not checked '
                    "(ancestry, conflicts, receipts and other lanes' claims still are)")
    else:
        say('FAIL' if outside else 'ok', f'{len(paths) - len(outside)}/{len(paths)} changed paths inside the claimed surface'
            + (': outside ' + ', '.join(outside[:6]) + (' ...' if len(outside) > 6 else '') if outside else ''))
    say('FAIL' if forbidden else 'ok', f'{len(forbidden)} forbidden path(s) touched' +
        (': ' + ', '.join(forbidden[:6]) if forbidden else ''))
    for lane, ps in trespass.items():
        # The common case at integration time is not a trespass at all: the lane
        # whose work is being merged still holds the claim covering its own
        # paths. Refusing with no route forward is how a check earns a reputation
        # for crying wolf and starts being ignored, so name the remedy.
        # A claim whose branch IS this tip does not make the merge safe -- it
        # makes it premature. A live claim means that lane is still working, so
        # its current tip is exactly what must not be merged. An earlier version
        # of this check treated self-ownership as an exemption and let an
        # in-flight lane's branch straight onto master; the verdict below is
        # deliberately refusal either way, and only the reason differs.
        # A claim can outlive its branch: retiring a merged branch to a tag
        # leaves the claim pointing at a ref that no longer resolves, and that
        # used to abort the whole check -- so one stale claim could block an
        # unrelated lane's integration entirely. Treat an unresolvable ref as
        # 'not this tip' and carry on; the claim is still reported.
        owns = (reg.get(lane) or {}).get('branch')
        try:
            mine = bool(owns) and rev(repo, owns) == tip
        except Exception:
            mine = False
        say('FAIL',
            f'{len(ps)} path(s) inside {lane}\'s active claim: {", ".join(ps[:4])}'
            + (f'. That claim is on THIS tip: {lane} is still working. Wait for it '
               f'to finish, then `lanes release {lane}` before merging.' if mine
               else f'. If this tip IS {lane}\'s finished work, `lanes release {lane}` first.'))
    if shared:
        say('WARN', f'shared file(s) changed, integrator must union-resolve: {", ".join(shared)}')

    # 5. master moved under the lane: did it move INTO the lane's paths?
    if mb != master:
        moved = set(changed(repo, mb, master))
        hit = sorted(moved & set(paths))
        report['master_moved_into'] = hit
        say('FAIL' if [h for h in hit if h not in SHARED] else 'WARN' if hit else 'ok',
            f'master changed {len(moved)} paths since the lane\'s base; {len(hit)} also changed by the lane'
            + (': ' + ', '.join(hit[:6]) + ' -> merge master into the lane and re-gate' if hit else ''))

    # 6. merge preview against current master and against every other active tip
    p = git(repo, 'merge-tree', '--write-tree', '--name-only', '--no-messages', master, tip, check=False)
    if p.returncode == 0:
        say('ok', f'merge-tree master+tip is clean -> tree {p.stdout.split()[0][:10]}')
        report['merged_tree'] = p.stdout.split()[0]
    elif p.returncode == 1:
        say('FAIL', f'merge-tree master+tip conflicts: {", ".join(p.stdout.split()[1:7])}')
    else:
        say('FAIL', f'merge-tree error {p.returncode}: {p.stderr.strip()[:200]}')
    for o in others:
        ot = rev(repo, o['branch']) if o.get('branch') else ''
        if not ot:
            continue
        q = git(repo, 'merge-tree', '--write-tree', '--name-only', '--no-messages', ot, tip, check=False)
        say('ok' if q.returncode == 0 else 'WARN',
            f'pairwise with {o["lane"]} ({ot[:10]}): ' + ('clean' if q.returncode == 0 else
                                                          'CONFLICTS ' + ', '.join(q.stdout.split()[1:5])))

    # 7. gate evidence is for a tree, and says nothing about base
    tree = git(repo, 'rev-parse', tip + '^{tree}').stdout.strip()
    found = (find_receipt(tree) if not a.receipt
             else (0, a.receipt, json.loads(Path(a.receipt).read_text()), []))
    if not found:
        say('WARN', f'no gate receipt for tip tree {tree[:10]} (gate the exact tip before merging)')
    else:
        _, f, r, others = found
        ok = r.get('verdict') == 'GREEN' and r.get('complete') and r.get('tree') == tree
        m = metrics(r, Path(f).parent)
        report['receipt'] = dict(path=f, verdict=r.get('verdict'), mode=r.get('mode'), metrics=m)
        say('ok' if ok else 'FAIL', f'gate receipt {f} verdict={r.get("verdict")} mode={r.get("mode")} '
            f'tree {"==" if r.get("tree") == tree else "!="} tip tree; ' +
            '; '.join(f'{s}: body ok {x["body_ok"]}, started {x["started"]}, receipt-selected '
                      f'{x["receipt_selected"]}, skipped {x["inventory_skipped"]}' for s, x in m.items()))
        # An exploratory tier cannot certify, but a red one is still a finding:
        # report it so it is weighed, not silently dropped.
        for _m, of, orr in others:
            say('WARN', f'same tree also has mode={orr.get("mode")} verdict={orr.get("verdict")} '
                        f'({Path(of).parent.name}); that tier does not certify, but a RED one is '
                        f'unfinished work -- read it before merging')
        if mb != master:
            say('WARN', 'that receipt is for the lane tree, not for the merge result; gate the merged tree too')

    verdict = 'MERGEABLE' if not fails else 'NOT MERGEABLE'
    report.update(verdict=verdict, fails=fails, warns=warns)
    print(f'---- {verdict}: {len(fails)} fail, {len(warns)} warn')
    if a.json_out:
        Path(a.json_out).write_text(json.dumps(report, indent=1, sort_keys=True))
    return 0 if not fails else 1


def tree_map(repo, tree, paths):
    out = git(repo, 'ls-tree', '-r', '-z', tree, '--', *paths).stdout
    m = {}
    for ent in filter(None, out.split('\0')):
        meta, _, path = ent.partition('\t')
        mode, _, oid = meta.split(' ')
        m[path] = (mode, oid)
    return m


def cmd_ledger(a, reg):
    """Classify every path any of the three trees has under PATHS: the rebuild-on-master proof."""
    repo = Path(a.repo)
    paths = a.path or ['.']
    cand, donor, mast = (tree_map(repo, t, paths) for t in (a.candidate, a.donor, a.master))
    rows, counts = [], {}
    for p in sorted(set(cand) | set(donor) | set(mast)):
        c, d, m = cand.get(p), donor.get(p), mast.get(p)
        if c == d == m:
            counts['identical-all'] = counts.get('identical-all', 0) + 1
            continue                                   # untouched by either side: not evidence
        cls = ('donor-exact' if c == d and c != m else
               'master-exact' if c == m and c != d else
               'absent-both' if c is None and d is None else
               'dropped' if c is None else
               'reconciled-union' if d is not None and m is not None else
               'reconciled-new-file' if m is None else 'adapted-master-file')
        rows.append(dict(path=p, cls=cls, candidate=c, donor=d, master=m))
        counts[cls] = counts.get(cls, 0) + 1
    out = dict(candidate=a.candidate, donor=a.donor, master=a.master, paths=paths, counts=counts, rows=rows)
    if a.json_out:
        Path(a.json_out).write_text(json.dumps(out, indent=1))
    print(' '.join(f'{k}={v}' for k, v in sorted(counts.items())))
    for r in rows:
        if r['cls'] not in ('donor-exact', 'master-exact') or a.verbose:
            print(f'  {r["cls"]:<20} {r["path"]}')
    if a.outside:
        # Everything outside the lane's paths must be master-exact: that is the no-divergence claim.
        full_c, full_m = tree_map(repo, a.candidate, ['.']), tree_map(repo, a.master, ['.'])
        inside = [to_regex(norm(x if x.endswith(('/', '*')) else x + '/')) for x in paths]
        diff = [p for p in sorted(set(full_c) | set(full_m))
                if full_c.get(p) != full_m.get(p) and not any(rx.match(p) for rx in inside)]
        print(f'outside {",".join(paths)}: {len(diff)} path(s) differ from master'
              + (': ' + ', '.join(diff[:8]) if diff else ' (master-exact)'))
        return 1 if diff else 0
    return 0


def slot_rows():
    """Every slot-ledger row on the host. The runner keys its state on $HOME, so look in every lane HOME."""
    files = [REAL_HOME / '.cache/neomacs-slot/jobs.jsonl'] + \
        [Path(f) for f in glob.glob(str(REAL_HOME / '.cache/lanes/*/.cache/neomacs-slot/jobs.jsonl'))]
    for f in files:
        try:
            for line in f.read_text().splitlines():
                r = json.loads(line); r['_ledger'] = str(f); yield r
        except (OSError, ValueError):
            continue


def scope_usage(unit):
    p = subprocess.run(['journalctl', '--user', '-u', unit + '.scope', '-o', 'json', '--no-pager'],
                       capture_output=True, text=True, timeout=20)
    use = {}
    for line in p.stdout.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        for k in ('MEMORY_PEAK', 'CPU_USAGE_NSEC'):
            if k in e:
                use[k.lower()] = int(e[k])
    return use


@functools.lru_cache(maxsize=1)
def tree_commits(repo=str(DEFAULT_REPO)):
    """tree -> commits, so a receipt (which records only a tree) can be tied back to history."""
    out = git(repo, 'log', '--all', '--format=%H %T').stdout.split('\n')
    m = {}
    for line in filter(None, out):
        c, t = line.split()
        m.setdefault(t, []).append(c)
    return m


def run_row(run_dir, lane=None, claim=None, slot=None):
    run_dir = Path(run_dir)
    r = json.loads((run_dir / 'receipt.json').read_text())
    heads = tree_commits().get(r.get('tree'), [])
    if slot is None:
        slot = next((s for s in slot_rows() if str(run_dir.name) in ' '.join(s.get('mode') or [])), None)
    row = dict(kind='gate', run=str(run_dir), lane=lane or (slot or {}).get('lane'), tree=r.get('tree'),
               verdict=r.get('verdict'), complete=r.get('complete'), mode=r.get('mode'),
               metrics=metrics(r, run_dir), heads=heads[:3],
               committed=bool(heads))
    if heads:
        master = rev(DEFAULT_REPO, 'refs/heads/master')
        row['master_merge_base'] = git(DEFAULT_REPO, 'merge-base', master, heads[0]).stdout.strip()
    if claim:
        row.update(base=claim['base'], surface=claim['surface'], claim_lane=claim['lane'])
    if slot:
        row.update(slot_lane=slot.get('lane'), slot_group=slot.get('group'), slot_index=slot.get('slot_index'),
                   slot_ledger=slot['_ledger'], rc=slot.get('rc'),
                   wait_s=round((slot.get('admitted') or 0) - slot['created'], 1),
                   run_s=round((slot.get('finished') or 0) - (slot.get('admitted') or 0), 1),
                   private_slot_state='/.cache/lanes/' in slot['_ledger'], unit=slot.get('unit'))
        try:
            row.update(scope_usage(slot['unit']))
        except (OSError, subprocess.SubprocessError):
            pass
    return row


def cmd_record(a, reg):
    c = reg.get(a.lane)
    row = run_row(a.run, lane=a.lane, claim=c)
    row.update(loadavg=loadavg(), at=time.time(), at_iso=time.strftime('%Y-%m-%dT%H:%M:%S%z'))
    with reg:
        reg.farm(row)
        if c:
            c['renewed'] = time.time(); c['expires'] = c['renewed'] + c['ttl_h'] * 3600; reg.write(c)
    print(json.dumps(row, sort_keys=True))
    return 0


def cmd_farm(a, reg):
    rows = []
    p = reg.root / 'farm.jsonl'
    if p.exists():
        rows = [json.loads(l) for l in p.read_text().splitlines() if l.strip()]
    runs = reg.root / 'runs.jsonl'                      # written by lane-run for unslotted work
    if runs.exists():
        rows += [dict(json.loads(l), at=json.loads(l)['start']) for l in runs.read_text().splitlines() if l.strip()]
    if a.backfill:
        since = time.time() - a.backfill * 3600
        seen = {r.get('run') for r in rows}
        for s in sorted(slot_rows(), key=lambda s: s['created']):
            if s['created'] < since:
                continue
            mode = s.get('mode') or []
            run = next((m.rsplit('/', 1)[0] for m in mode if m.endswith('/gate') and '/runs/' in m), None)
            if not run or run in seen or not (Path(run) / 'receipt.json').exists():
                rows.append(dict(kind='slot', lane=s.get('lane'), rc=s.get('rc'), slot_ledger=s['_ledger'],
                                 at=s['created'], run_s=round((s.get('finished') or 0) - (s.get('admitted') or 0), 1),
                                 private_slot_state='/.cache/lanes/' in s['_ledger'], run=run))
                continue
            rr = run_row(run, slot=s); rr['at'] = s['created']; rows.append(rr)
    rows.sort(key=lambda r: r.get('at', 0))
    if a.json:
        print(json.dumps(rows, indent=1)); return 0
    for r in rows:
        when = time.strftime('%m-%d %H:%M', time.localtime(r.get('at', 0)))
        if r.get('kind') == 'run':
            print(f'{when} {str(r.get("lane")):<24} rc={r.get("rc"):<5} wall={r.get("wall_s")}s '
                  f'rss={r.get("max_rss_kb", 0) / 2**20:.1f}G load={r.get("load_start")}->{r.get("load_end")} '
                  f'{" ".join(r.get("argv") or [])[:60]}')
            continue
        if r.get('kind') in ('gate', 'slot'):
            m = r.get('metrics') or {}
            mm = ' '.join(f'{s}={x["body_ok"]}/{x["started"]}/{x["receipt_selected"]}' for s, x in m.items())
            mem = f'{r["memory_peak"] / 2**30:.1f}G' if r.get('memory_peak') else '-'
            print(f'{when} {str(r.get("lane")):<24} {r.get("verdict") or "rc=" + str(r.get("rc")):<8} '
                  f'run={r.get("run_s")}s mem={mem} slot={"PRIVATE" if r.get("private_slot_state") else "shared"} '
                  f'base={(r.get("base") or "-")[:10]} head={((r.get("heads") or ["uncommitted"])[0])[:10]} {mm}')
        else:
            print(f'{when} {str(r.get("lane")):<24} {r.get("outcome"):<8} base={(r.get("base") or "")[:10]} '
                  f'load={r.get("loadavg")} {" ".join(r.get("surface") or [])}')
    return 0


def derived_artifacts(repo):
    """Paths regenerated by a committed generator, parsed from check-derived.

    A collision on a derived index is not a conflict: it is regenerated from
    its sources by `tools/*_index.py` and must never be hand-merged. Counting
    those paths as overlap inflated every forecast pair for four reports and
    buried the pairs that are real. Parsed from scripts/check-derived so the
    two cannot drift apart.
    """
    out = set()
    try:
        txt = (Path(repo) / 'scripts/check-derived').read_text()
    except OSError:
        return out
    for m in re.finditer(r"artifact=['\"]([^'\"]+)['\"]", txt):
        out.add(m.group(1))
    return out


def parked_patterns(repo):
    """Globs for branches the owner has parked: listed, never actioned.

    A parked branch drifts from master by design, so emitting "rebase now" for
    it every run trains the reader to skim ACTIONS -- and a review whose
    actions are skimmed is worth nothing. The list lives in a file rather than
    in this script so unparking is an edit, not a patch.
    """
    f = Path(repo) / 'scripts/lanes-parked'
    pats = []
    try:
        for line in f.read_text().splitlines():
            line = line.split('#', 1)[0].strip()
            if line:
                pats.append(line)
    except OSError:
        pass
    return pats


def is_parked(name, pats):
    return any(fnmatch.fnmatch(name, p) for p in pats)


def open_branches(repo, master):
    """Every head not already merged into master, with its divergence measured."""
    names = [n for n in git(repo, 'for-each-ref', '--format=%(refname:short)',
                            'refs/heads').stdout.split() if n != 'master']
    out = []
    for b in names:
        if is_ancestor(repo, b, master):
            continue
        mb = git(repo, 'merge-base', 'master', b).stdout.strip()
        if not mb:
            continue
        mine = set(changed(repo, mb, b))
        theirs = set(changed(repo, mb, master))
        out.append(dict(
            name=b, base=mb, mine=mine,
            ahead=int(git(repo, 'rev-list', '--count', f'{mb}..{b}').stdout.strip() or 0),
            behind=int(git(repo, 'rev-list', '--count', f'{mb}..master').stdout.strip() or 0),
            rebase_risk=sorted(mine & theirs),
            age_days=(time.time() - int(git(repo, 'log', '-1', '--format=%ct', b).stdout.strip() or 0)) / 86400.0))
    return out


def cmd_merge(a, reg):
    """Run check, then merge only if it passed.

    This exists because of a real mistake: I ran `lanes check`, it printed
    NOT MERGEABLE, and the next line of my script ran `git merge` regardless.
    A verification whose verdict the caller has to remember to honour has the
    same defect as a pipeline that swallows an exit status -- the safe path
    has to be the easy one, so here the only route to the merge is through
    the check.
    """
    import subprocess as sp
    argv = [sys.executable, str(Path(__file__).resolve()), 'check']
    if a.lane:
        argv.append(a.lane)
    argv += ['--tip', a.tip, '--canonical', a.canonical]
    for s in (a.surface or []):
        argv += ['--surface', s]
    if a.base:
        argv += ['--base', a.base]
    rc = sp.run(argv).returncode
    if rc != 0 and not a.force:
        print(f'\nlanes: NOT merging; check exited {rc}. Fix it, or pass '
              f'--force --reason "..." and the reason goes into the merge commit.',
              file=sys.stderr)
        return 2
    if rc != 0 and not a.reason:
        print('lanes: --force requires --reason', file=sys.stderr)
        return 2
    repo = Path(a.canonical)
    tip = rev(repo, a.tip)
    msg = a.message or f'Merge {a.tip}'
    if rc != 0:
        msg += f'\n\nMerged over a failing lane check, deliberately: {a.reason}'
    out = git(repo, 'merge', '--no-ff', '-S', tip, '-m', msg, check=False)
    print((out.stdout or out.stderr).strip()[-300:])
    return out.returncode


def cmd_review(a, reg):
    """Periodic self-audit: what is open, what will collide, what is stale.

    Written because every integration failure in this repo so far came from one
    of three things a human eye misses: merging a tree no gate ever saw, two
    lanes writing one surface, and a lane whose base drifted so far that its
    rebase was a rewrite. Each gets a line here, and anything needing action
    sets a non-zero exit so a scheduled run is silent only when all is well.
    """
    repo = Path(a.repo)
    master = rev(repo, 'refs/heads/master')
    actions, note = [], []
    print(f'lanes review  {time.strftime("%Y-%m-%d %H:%M")}  repo {repo}')

    # ---- master and whether a gate ever certified exactly this tree
    tree = git(repo, 'rev-parse', 'master^{tree}').stdout.strip()
    sig = git(repo, 'log', '-1', '--format=%G?', 'master').stdout.strip()
    print(f'master {master[:10]}  signed={sig or "-"}')
    found = find_receipt(tree)
    if not found:
        trans = certified_transitively(repo, tree)
        if trans:
            tf, tr, paths = trans
            m = metrics(tr, Path(tf).parent)
            per = '  '.join(f'{s} {v["body_ok"]} ok' for s, v in sorted(m.items()))
            print(f'  gate: GREEN by transitive certification  {per}')
            print(f'        this tree differs from the certified one only in '
                  f'{len(paths)} gate-irrelevant path(s): {", ".join(paths[:4])}')
            note.append(f'master tree itself is ungated; it is certified via {Path(tf).parent.name} '
                        f'because the only delta is {", ".join(paths[:3])}. Re-gate if that '
                        f'reasoning ever stops holding.')
        else:
            print('  gate: NO RECEIPT for this exact tree')
            actions.append('master tree has no gate receipt: gate master before merging onto it')
    else:
        mtime, path, r, other_tiers = found
        m = metrics(r, Path(path).parent)
        for _m, of, orr in other_tiers:
            if orr.get('verdict') != 'GREEN':
                note.append(f'master tree also has a {orr.get("mode")} receipt at '
                            f'{orr.get("verdict")} ({Path(of).parent.name}) -- unfinished, not certifying')
        per = '  '.join(f'{s} {v["body_ok"]} ok' + (f' / {v["failed"]} FAILED' if v['failed'] else '')
                        for s, v in sorted(m.items()))
        print(f'  gate: {r.get("verdict")}  {per}  ({(time.time()-mtime)/3600:.1f}h ago)')
        if r.get('verdict') != 'GREEN':
            actions.append(f'master gate is {r.get("verdict")}: fix before any further merge')
    if sig not in ('G', 'U'):
        actions.append(f'master tip signature is {sig or "absent"}: expected a good signature')

    # ---- open work, its drift, and whether a claim covers it
    branches = open_branches(repo, master)
    parked_pats = parked_patterns(repo)
    derived = derived_artifacts(repo)
    for b in branches:
        b['parked'] = is_parked(b['name'], parked_pats)
        b['risk_src'] = [p for p in b['rebase_risk'] if p not in derived]
        b['risk_derived'] = [p for p in b['rebase_risk'] if p in derived]
    live = {c['lane']: c for c in reg.claims()}
    claimed_branches = {c.get('branch') for c in live.values() if c.get('branch')}
    print(f'\nopen branches ({len(branches)}):')
    print(f'  {"branch":<34} {"ahead":>5} {"behind":>6} {"rebase":>6} {"age/d":>6}  claim')
    for b in sorted(branches, key=lambda x: -len(x['rebase_risk'])):
        held = next((ln for ln, c in live.items() if c.get('branch') == b['name']), '-')
        if b['parked']:
            held = 'PARKED' if held == '-' else held + ' PARKED'
        print(f'  {b["name"]:<34} {b["ahead"]:>5} {b["behind"]:>6} '
              f'{len(b["rebase_risk"]):>6} {b["age_days"]:>6.1f}  {held}')
        if b['parked']:
            pass
        elif b['risk_src']:
            extra = (f' (+{len(b["risk_derived"])} derived, regenerate)' if b['risk_derived'] else '')
            actions.append(f'{b["name"]}: {len(b["risk_src"])} source paths changed by BOTH it and master '
                           f'since its base{extra} (e.g. {", ".join(b["risk_src"][:2])}) -- rebase now, '
                           f'before the overlap grows')
        elif b['risk_derived']:
            note.append(f'{b["name"]}: overlaps master only in {len(b["risk_derived"])} derived '
                        f'artifact(s) ({", ".join(b["risk_derived"])}); rebase is mechanical, '
                        f'regenerate them, never hand-merge')
        elif b['behind'] > 200:
            note.append(f'{b["name"]}: base is {b["behind"]} commits behind but overlaps nothing; '
                        f'rebasing is mechanical')
        if b['age_days'] > 7 and b['ahead'] > 0 and not b['parked']:
            note.append(f'{b["name"]}: {b["age_days"]:.0f} days old, {b["ahead"]} commits unlanded -- '
                        f'land, park with a tag, or delete it')

    # ---- the collision forecast: pairs of open branches writing the same files
    print('\ncollision forecast (open branches touching the same paths):')
    pairs = []
    landable = [b for b in branches if not b['parked']]
    for i, x in enumerate(landable):
        for y in landable[i + 1:]:
            both = (x['mine'] & y['mine']) - derived
            if both:
                pairs.append((len(both), x['name'], y['name'], sorted(both)))
    for n, xn, yn, paths in sorted(pairs, reverse=True)[:12]:
        print(f'  {n:>4} source paths  {xn}  <->  {yn}     e.g. {", ".join(paths[:2])}')
        if n >= a.min_pair:
            actions.append(f'{xn} and {yn} both change {n} source paths: serialise them, '
                           f'they cannot both land unreconciled')
    if not pairs:
        print('  none -- every open branch writes a disjoint set of source files')
    if derived:
        print(f'  (derived artifacts excluded from every count: {", ".join(sorted(derived))})')
    nparked = len(branches) - len(landable)
    if nparked:
        print(f'  ({nparked} parked branch(es) excluded: they reconcile once, at unpark)')

    # ---- claims that no longer describe reality
    print(f'\nclaims: {len(live)} live')
    for ln, c in sorted(live.items()):
        left = (c['expires'] - time.time()) / 3600
        br = c.get('branch') or '-'
        print(f'  {ln:<10} {br:<34} {left:>5.1f}h left  base={c["base"][:10]}')
        if not is_ancestor(repo, c['base'], master):
            actions.append(f'claim {ln}: base {c["base"][:10]} is no longer on master')
        if left < 0.5:
            note.append(f'claim {ln} expires in under 30 min; renew it or it stops protecting the surface')
    unclaimed = [b['name'] for b in branches
                 if b['name'] not in claimed_branches and b['ahead'] > 0 and not b['parked']]
    if unclaimed and a.strict_claims:
        actions.append(f'{len(unclaimed)} open branches hold no claim: {", ".join(unclaimed[:4])}')

    # ---- lane scratch directories with nothing left to protect
    lanes_dir = REAL_HOME / '.cache/lanes'
    dirs = sorted(d for d in glob.glob(str(lanes_dir / '*')) if Path(d).is_dir())
    keep = {c['lane'] for c in live.values()} | {b['name'].split('/')[-1] for b in branches}
    stale = [d for d in dirs if Path(d).name.split('-target')[0] not in keep]
    print(f'\ndisk: {len(dirs)} lane dirs under {lanes_dir}, {len(stale)} with no live claim and no open branch')
    if len(stale) > 20:
        note.append(f'{len(stale)} reclaimable lane dirs; prune the oldest once their gates are done')

    if note:
        print(f'\nnotes ({len(note)}):')
        for n in note:
            print(f'  - {n}')
    print(f'\nACTIONS ({len(actions)}):')
    for x in actions:
        print(f'  ! {x}')
    if not actions:
        print('  none -- lanes are disjoint, master is gated and signed')
    reg.event('review', master=master, actions=len(actions), branches=len(branches), pairs=len(pairs))
    return 1 if actions else 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog='lanes', description=__doc__.split('\n')[0])
    ap.add_argument('--registry', default=os.environ.get('LANES_REGISTRY', str(REAL_HOME / '.cache/romacs-lanes')))
    ap.add_argument('--repo', default=str(DEFAULT_REPO))
    sub = ap.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('claim'); s.add_argument('lane'); s.add_argument('--base', required=True)
    s.add_argument('--surface', action='extend', nargs='+', required=True, default=None)
    s.add_argument('--forbid', action='extend', nargs='*', default=None)
    s.add_argument('--branch'); s.add_argument('--worktree'); s.add_argument('--brief')
    s.add_argument('--ttl', type=float, default=DEFAULT_TTL_H); s.add_argument('--allow-empty', action='store_true')
    s = sub.add_parser('renew'); s.add_argument('lane')
    s = sub.add_parser('release'); s.add_argument('lane'); s.add_argument('--outcome', required=True, choices=OUTCOMES)
    s.add_argument('--note'); s.add_argument('--tip')
    s = sub.add_parser('list'); s.add_argument('--json', action='store_true')
    s = sub.add_parser('reject'); s.add_argument('sha'); s.add_argument('--base'); s.add_argument('--reason', required=True)
    s = sub.add_parser('check'); s.add_argument('lane', nargs='?'); s.add_argument('--tip'); s.add_argument('--base')
    s.add_argument('--surface', action='extend', nargs='*', default=None)
    s.add_argument('--forbid', action='extend', nargs='*', default=None)
    s.add_argument('--canonical', default=str(DEFAULT_REPO)); s.add_argument('--receipt')
    s.add_argument('--min-block', type=int, default=3); s.add_argument('--json-out')
    s = sub.add_parser('ledger'); s.add_argument('--candidate', required=True); s.add_argument('--donor', required=True)
    s.add_argument('--master', required=True); s.add_argument('--path', nargs='*')
    s.add_argument('--outside', action='store_true'); s.add_argument('--verbose', action='store_true'); s.add_argument('--json-out')
    s = sub.add_parser('record'); s.add_argument('lane'); s.add_argument('--run', required=True)
    s = sub.add_parser('farm'); s.add_argument('--backfill', type=float); s.add_argument('--json', action='store_true')
    s = sub.add_parser('merge'); s.add_argument('lane', nargs='?'); s.add_argument('--tip', required=True)
    s.add_argument('--base'); s.add_argument('--surface', action='append'); s.add_argument('--message')
    s.add_argument('--force', action='store_true'); s.add_argument('--reason')
    s.add_argument('--canonical', default=str(DEFAULT_REPO))
    s = sub.add_parser('review'); s.add_argument('--min-pair', type=int, default=1)
    s.add_argument('--strict-claims', action='store_true')
    import lanes_queue
    lanes_queue.add_parser(sub)
    a = ap.parse_args(argv)
    reg = Registry(a.registry)
    if a.cmd == 'queue':
        return lanes_queue.cmd_queue(a, reg, sys.modules[__name__])
    return globals()['cmd_' + a.cmd](a, reg)


if __name__ == '__main__':
    sys.exit(main())

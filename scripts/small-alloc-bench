#!/usr/bin/env python3
"""Run inside an admitted slot. Seven alternating constructor/oracle repeats."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import statistics
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SLOT = Path.home() / 'cockpit/bin/neomacs-slot'
SHAPES = ('cons', 'string8', 'string16', 'string32', 'vector4', 'symbol')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', required=True)
    parser.add_argument('--output', required=True)
    parser.add_argument('--baseline', help='optional exact-base executable')
    parser.add_argument('--gnu', default='/usr/bin/emacs')
    parser.add_argument('--repeats', type=int, default=7)
    args = parser.parse_args()
    if args.repeats < 7:
        parser.error('at least seven repeats required')
    rows = []
    with tempfile.TemporaryDirectory(prefix='small-alloc.', dir=os.environ['TMPDIR']) as td:
        source = Path(td) / 'small-alloc-gnu.el'
        shutil.copyfile(ROOT / 'crates/romacs-mem/bench/small-alloc-gnu.el', source)
        gnu = [str(SLOT), 'memalloc', '--light', '--group', 'romacs-core', '--priority', '70',
               '--', args.gnu, '-Q', '--batch']
        subprocess.run([*gnu, '-f', 'batch-byte-compile', str(source)], check=True)
        binaries = {'rust': args.binary, 'gnu': shutil.which(args.gnu)}
        if args.baseline:
            binaries['baseline'] = args.baseline
        metadata = dict(repeats=args.repeats, units='ns/object', warmups=1,
                        gnu_version=subprocess.check_output([*gnu, '--version'], text=True).splitlines()[0],
                        affinity=sorted(os.sched_getaffinity(0)),
                        fixture_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
                        binaries={engine: dict(path=str(Path(path).resolve()),
                                               sha256=hashlib.sha256(Path(path).read_bytes()).hexdigest())
                                  for engine, path in binaries.items()})
        Path(args.output + '.meta.json').write_text(json.dumps(metadata, indent=2) + '\n')
        for n in (100000, 1000000):
            for mode in ('nogc', 'gc'):
                for shape in SHAPES:
                    commands = {'rust': [args.binary, shape, str(n), mode],
                                'gnu': [*gnu, '-l', str(source) + 'c', '-f', 'small-alloc-run',
                                        shape, str(n), mode]}
                    if args.baseline:
                        commands['baseline'] = [args.baseline, shape, str(n), mode]
                    samples = {engine: [] for engine in commands}
                    order = list(commands)
                    for rep in range(args.repeats):
                        for engine in (order if rep % 2 == 0 else order[::-1]):
                            proc = subprocess.run(commands[engine], check=True, capture_output=True,
                                                  text=True, timeout=300)
                            ns = int(proc.stdout.strip())
                            assert ns > 0
                            samples[engine].append(ns / n)
                    row = dict(shape=shape, n=n, mode=mode, samples_ns=samples)
                    row['summary_ns'] = {engine: {'median': statistics.median(values),
                                                  'min': min(values), 'max': max(values)}
                                         for engine, values in samples.items()}
                    rows.append(row)
                    Path(args.output).write_text(json.dumps(rows, indent=2) + '\n')
                    print(shape, n, mode, row['summary_ns'], flush=True)
    assert len(rows) == 24


if __name__ == '__main__':
    main()

#!/usr/bin/env python3
"""Explicit GNU oracle refresh; ordinary Rust tests never launch Emacs."""
from pathlib import Path
import subprocess
root = Path(__file__).resolve().parent.parent
import argparse
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--calls-only', action='store_true', help='retain machine records; no batch quit probes')
parser.add_argument('--admission-only', action='store_true', help='retain other records; no batch quit probes')
args = parser.parse_args()
if args.calls_only and args.admission_only:
    parser.error('choose one fixture subset')
files = ('admission.el',) if args.admission_only else (
    ('calls.el',) if args.calls_only else ('machine.el', 'calls.el', 'admission.el'))
output = b''.join(subprocess.run(
    ['/usr/bin/emacs', '-Q', '--batch', '-l', str(root / 'test/gnudiff/eval' / file)],
    check=True, capture_output=True).stdout for file in files)
expected = root / 'test/gnudiff/eval/expected.eld'
if args.calls_only or args.admission_only:
    names = {line.split(b' . ', 1)[0] for line in output.splitlines()}
    retained = [line for line in expected.read_bytes().splitlines() if line.split(b' . ', 1)[0] not in names]
    output = b'\n'.join(retained) + b'\n' + output
expected.write_bytes(output)
print(output.decode(), end='')

 # from M_OLD to NEW; refuses rather than overwriting local edits.
--- a/romacs-land-fast.sh
+++ b/romacs-land-fast.sh
@@ -41,7 +41,8 @@
 NEW="$LANE_C"
 [ "$(mainenv git -C "$R" rev-parse "$NEW^{tree}")" = "$TREE" ] || die "check tree: publication tree differs"
 refuse_if_frozen
-mainenv git -C "$R" update-ref -m "romacs-land: Fast-forward $BR (tree $TREE)" refs/heads/master "$NEW" "$M_OLD" 9>&- || die "check CAS: master moved during publication; nothing landed"
+mainenv python3 "$SELF_DIR/master-reference-guard.py" publish --repo "$R" --old "$M_OLD" --new "$NEW" \

@@ -429,7 +429,8 @@
 mainenv env PYTHONDONTWRITEBYTECODE=1 python3 "$RECORD_ROOT/reference/record_committed.py" \
   --root "$RECORD_ROOT" --code-repository "$R" --landing-target "$NEW" \
   || die "candidate invalidates written-record claims or procedural review"
-mainenv git -C "$R" update-ref -m "romacs-land: Merge $BR (tree $TREE)" refs/heads/master "$NEW" "$M_OLD" \

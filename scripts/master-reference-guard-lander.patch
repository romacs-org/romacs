 mainenv git -C "$R" read-tree -m -u "$M_OLD" "$NEW" 9>&- || die "LANDED BUT CHECKOUT SYNC FAILED: master=$NEW; run git -C $R read-tree -m -u $M_OLD $NEW"
 exec 9>&-

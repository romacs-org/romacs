;;; -*- lexical-binding: t; -*-
(load (expand-file-name "lisp/emacs-lisp/pcase.el"
                        (or (getenv "ROMACS_GNU_SOURCE")
                            (error "Set ROMACS_GNU_SOURCE to the pinned GNU checkout")))
      nil t t)
(defun oracle-original (states)
  (pcase-dolist (`(,variable ,local ,value) states)
    (if local (set variable value) (kill-local-variable variable))))
(defun oracle-plain (states)
  (dolist (state states)
    (let ((variable (car state)) (local (car (cdr state)))
          (value (car (cdr (cdr state)))))
      (if local (set variable value) (kill-local-variable variable)))))
(defun oracle-safe (states)
  (dolist (state states)
    (let ((variable (car-safe state))
          (local (car-safe (cdr-safe state)))
          (value (car-safe (cdr-safe (cdr-safe state)))))
      (if local (set variable value) (kill-local-variable variable)))))
(princ (format "runtime=%s executable=%s\n" emacs-version invocation-directory))
(princ (format "expansion=%S\n" (macroexpand-all '(pcase-dolist (`(,variable ,local ,value) states) (if local (set variable value) (kill-local-variable variable))))))
(defvar oracle-a 'default-a)
(defvar oracle-b 'default-b)
(dolist (case '((valid-set ((oracle-a t restored)))
                (valid-kill ((oracle-a nil ignored)))
                (short-one ((oracle-a)))
                (short-two-local ((oracle-a t)))
                (short-two-nonlocal ((oracle-a nil)))
                (long ((oracle-a t restored extra)))
                (nil-entry (nil))
                (atom-entry (atom))
                (number-entry (7))
                (dotted-first ((oracle-a . tail)))
                (dotted-second-local ((oracle-a t . tail)))
                (dotted-second-nonlocal ((oracle-a nil . tail)))
                (dotted-after-value ((oracle-a t restored . tail)))
                (nil-states nil)
                (atom-states atom)
                (dotted-states ((oracle-a t restored) . tail))
                (effect-before-atom ((oracle-a t restored) atom (oracle-b t later)))
                (effect-before-short ((oracle-a t restored) (oracle-b)))
                (nil-variable-local ((nil t restored)))))
  (dolist (fn '(oracle-original oracle-plain oracle-safe))
    (with-temp-buffer
      (set (make-local-variable 'oracle-a) 'initial-a)
      (set (make-local-variable 'oracle-b) 'initial-b)
      (let ((result (condition-case err (list 'return (funcall fn (cadr case))) (error (list 'error err)))))
        (princ (format "%S %S => %S a=%S/%S b=%S/%S\n" (car case) fn result (symbol-value 'oracle-a) (local-variable-p 'oracle-a) (symbol-value 'oracle-b) (local-variable-p 'oracle-b)))))))

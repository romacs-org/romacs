#!/usr/bin/env python3
"""Exercise the real generator in an isolated Git clone; never change source refs.

Keep CARGO_TARGET_DIR when reusing a build cache. Fixtures/evidence stay outside the
worktree. --mutant restores volatile provenance and accepts only the invariant's
own assertion, never a build failure or an arbitrary nonzero exit, as a kill.
"""
import tempfile as _portable_tempfile
from pathlib import Path as _PortablePath
import argparse
import os
from pathlib import Path
import subprocess
import tempfile
import time

LIVE = 'crates/romacs-introspect-live/data/registry.json'
EMBEDDED = 'crates/romacs-introspect/data/registry.json'
DIVERGENCES = 'DIVERGENCES.json'
ARTIFACTS = (LIVE, EMBEDDED, DIVERGENCES, 'PRIMITIVES.json')
IDENTICAL = 'identical-input regeneration must be byte-identical'
FIXED_POINT = 'regenerate-commit cycle must reach a fixed point'


def run(root, *args):
    result = subprocess.run(args, cwd=root, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    if result.returncode:
        raise RuntimeError(f'{args!r} exited {result.returncode}:\n{result.stdout}')
    return result.stdout.strip()


def exercise(root):
    def generate():
        print(run(root, 'cargo', 'run', '-q', '-p', 'romacs-introspect-live',
                  '--', '--write'), flush=True)
        print(run(root, 'python3', 'tools/lib/divergence_index.py'), flush=True)
        print(run(root, 'python3', 'tools/lib/primitive_index.py'), flush=True)
        return {path: (root / path).read_bytes() for path in ARTIFACTS}

    # Cover regeneration before the source edit is committed, not only clean
    # inputs. History-based input identity fails when this and its output are
    # subsequently committed together, exactly as the lander does.
    ledger = root / 'DIVERGENCES.md'
    ledger.write_bytes(ledger.read_bytes() + b'\n<!-- convergence fixture -->\n')
    vm2_input = 'crates/romacs-vm/src/prim.rs'
    path = root / vm2_input
    path.write_bytes(path.read_bytes() + b'\n')
    first = generate()
    # Today's bug uses whole seconds. Cross a tick rather than permitting a
    # false green from two generations in the same clock second.
    time.sleep(1.1)
    second = generate()
    assert first == second, IDENTICAL
    assert second[EMBEDDED] == second[LIVE], 'both snapshots must be regenerated identically'
    print(f'PASS: {IDENTICAL}: {", ".join(ARTIFACTS)}', flush=True)
    run(root, 'git', 'add', *ARTIFACTS, 'DIVERGENCES.md', vm2_input)
    run(root, 'git', '-c', 'user.name=Snapshot test', '-c',
        'user.email=snapshot-test@example.invalid', '-c', 'commit.gpgsign=false',
        'commit', '--allow-empty', '-m', 'Commit regenerated snapshots in isolated fixture')
    committed = run(root, 'git', 'rev-parse', 'HEAD^{tree}')
    time.sleep(1.1)
    generate()
    run(root, 'git', 'add', *ARTIFACTS)
    regenerated = run(root, 'git', 'write-tree')
    assert committed == regenerated, FIXED_POINT
    print(f'PASS: {FIXED_POINT}: {committed} == {regenerated}', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument('--commit', default='HEAD', help='exact candidate commit/ref, resolved before cloning')
    parser.add_argument('--mutant', action='store_true')
    args = parser.parse_args()
    source = args.source.resolve()
    commit = run(source, 'git', 'rev-parse', '--verify', args.commit + '^{commit}')
    tree = run(source, 'git', 'rev-parse', commit + '^{tree}')
    print(f'candidate commit={commit} tree={tree}', flush=True)
    scratch = Path(str(_PortablePath(_portable_tempfile.gettempdir()) / ''))
    with tempfile.TemporaryDirectory(prefix='snapshot-regeneration-', dir=scratch) as tmp:
        root = Path(tmp) / 'repo'
        run(scratch, 'git', 'clone', '--quiet', '--shared', '--no-hardlinks',
            str(source), str(root))
        run(root, 'git', 'checkout', '--quiet', '--detach', commit)
        if run(root, 'git', 'rev-parse', 'HEAD^{tree}') != tree:
            raise RuntimeError('fixture tree differs from the pinned candidate')
        if args.mutant:
            try:
                exercise(root)
            except (AssertionError, RuntimeError) as exc:
                raise RuntimeError('baseline not green; no kill claimed') from exc
            print('BASELINE GREEN on pinned candidate; applying mutant', flush=True)
            run(root, 'git', 'reset', '--hard', commit)
            path = root / 'crates/romacs-introspect-live/src/main.rs'
            text = path.read_text()
            anchor = 'serde_json::to_string_pretty(&live.to_json())'
            if anchor not in text:
                raise RuntimeError('mutant anchor missing; no kill claimed')
            text = text.replace(anchor, '''serde_json::to_string_pretty(&{
                let mut json = live.to_json();
                json["provenance"]["mutant_wall_clock"] = serde_json::json!(
                    std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos().to_string());
                json
            })''')
            path.write_text(text)
        try:
            exercise(root)
        except AssertionError as exc:
            if args.mutant and str(exc) == IDENTICAL:
                print(f'MUTANT KILLED at target assertion: {exc}')
                return 0
            raise
        if args.mutant:
            raise AssertionError('mutant survived; deterministic regression is ineffective')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

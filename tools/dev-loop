#!/usr/bin/env python3
"""Run focused crate tests. Defaults to library tests; full acceptance is scripts/gate full."""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent


def select(package, tests=(), library=False):
    targets = package["targets"]
    available = {t["name"] for t in targets if t["kind"] == ["test"]}
    missing = set(tests) - available
    if missing:
        raise ValueError(f"unknown test targets: {', '.join(sorted(missing))}")
    if not tests:
        library = True
    if library and not any("lib" in t["kind"] and t.get("test", True) for t in targets):
        raise ValueError(f"{package['name']}: no library tests; select --test TARGET")
    flags = ["--lib"] if library else []
    for test in dict.fromkeys(tests):
        flags.extend(["--test", test])
    return flags


def private_tmpdir(env):
    """A fresh TMPDIR for one run, removed after it: tests share nothing a
    run before left, and it is short, as a socket path under it is capped at
    108 bytes. It is under the cache directory, on disk: a tmpfs /tmp fills
    with the worlds tests build."""
    base = Path(env.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    base.mkdir(parents=True, exist_ok=True)
    return tempfile.TemporaryDirectory(prefix="rdl-", dir=base)


def positive(value):
    number = int(value)
    if number < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return number


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("crate", help="exact workspace package name")
    parser.add_argument("--test", action="append", default=[], metavar="TARGET")
    parser.add_argument("--lib", action="store_true", help="include library tests")
    parser.add_argument("-E", "--filter", help="nextest filter expression")
    parser.add_argument("--jobs", type=positive, help="Cargo build jobs")
    parser.add_argument("--profile", choices=("dev-fast", "gate"), default="dev-fast",
                        help="use gate for compute-heavy GNU loading/oracle tests")
    parser.add_argument("--threads", type=positive, default=1, help="test workers (default: 1)")
    parser.add_argument("--list", action="store_true", help="show selection without building")
    args = parser.parse_args()
    started = time.monotonic()
    status = 1
    try:
        env = os.environ.copy()
        metadata = json.loads(subprocess.check_output(
            ["cargo", "metadata", "--no-deps", "--locked", "--offline", "--format-version", "1"],
            cwd=ROOT, env=env))
        members = set(metadata["workspace_members"])
        matches = [p for p in metadata["packages"] if p["id"] in members and p["name"] == args.crate]
        if len(matches) != 1:
            raise ValueError(f"unknown workspace crate: {args.crate}")
        targets = select(matches[0], args.test, args.lib)
        config = ["--config", str(ROOT / ".cargo/dev.toml")] if args.profile == "dev-fast" else []
        command = ["cargo", "nextest", "run", *config,
                   "--cargo-profile", args.profile, "--locked", "--offline", "-p", args.crate,
                   *targets, "--test-threads", str(args.threads), "--no-fail-fast", "--retries", "0",
                   "--no-tests=fail", "--status-level", "fail", "--final-status-level", "fail"]
        if args.filter:
            command.extend(["-E", args.filter])
        if args.jobs is not None:
            command.extend(["--build-jobs", str(args.jobs)])
        print("dev-loop:", shlex.join(command), flush=True)
        print(f"dev-loop: target={env.get('CARGO_TARGET_DIR', str(ROOT / 'target'))}", flush=True)
        if not args.list:
            overrides = [key for key in env if key in {"RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS"}
                         or (key.startswith("CARGO_TARGET_") and key.endswith("_RUSTFLAGS"))]
            if overrides and args.profile == "dev-fast":
                raise ValueError("unset rustflag overrides so the dev linker config is effective: "
                                 + ", ".join(sorted(overrides)))
            with private_tmpdir(env) as tmpdir:
                print(f"dev-loop: TMPDIR={tmpdir}", flush=True)
                subprocess.run(command, cwd=ROOT, env={**env, "TMPDIR": tmpdir}, check=True)
        status = 0
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"dev-loop: {error}", file=sys.stderr)
    finally:
        result = "selection only" if args.list else "focused tests only"
        print(f"dev-loop: elapsed {time.monotonic() - started:.3f}s; "
              f"{'PASS' if status == 0 else 'FAIL'} ({result})", flush=True)
    return status


if __name__ == "__main__":
    sys.exit(main())

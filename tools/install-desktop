#!/usr/bin/env python3
"""Install a checkout launcher symlink and generate its desktop entry.

The checkout must remain at its current location. Existing unrelated files
are refused; --replace permits replacing this install's two destinations.
"""
import argparse
import os
from pathlib import Path
import tempfile


def exec_quote(path):
    value = str(path)
    if any(char in value for char in "\n\r\x00"):
        raise ValueError("desktop executable paths cannot contain line breaks or NUL")
    if "%" in value:
        raise ValueError("desktop install prefix cannot contain a percent sign")
    for char in ('\\', '"', '`', '$'):
        value = value.replace(char, '\\' + char)
    return '"' + value.replace('\\', '\\\\') + '"'


def install(prefix, applications, replace=False):
    root = Path(__file__).resolve().parent.parent
    launcher = prefix.absolute() / "bin/romacs"
    desktop = applications.absolute() / "romacs.desktop"
    if not replace and any(p.exists() or p.is_symlink() for p in (launcher, desktop)):
        raise FileExistsError("install destinations exist; inspect them before using --replace")
    contents = (root / "assets/romacs.desktop").read_text()
    command = exec_quote(launcher)
    contents = contents.replace("Exec=romacs", "Exec=" + command)
    launcher.parent.mkdir(parents=True, exist_ok=True)
    desktop.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=launcher.parent) as pending:
        link = Path(pending) / "romacs"
        link.symlink_to(root / "tools/romacs")
        os.replace(link, launcher)
    with tempfile.NamedTemporaryFile(mode="w", dir=desktop.parent, delete=False) as pending:
        pending.write(contents)
        temporary = Path(pending.name)
    try:
        temporary.chmod(0o644)
        os.replace(temporary, desktop)
    finally:
        temporary.unlink(missing_ok=True)
    print(launcher)
    print(desktop)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--prefix", type=Path, default=Path.home() / ".local")
    parser.add_argument("--applications-dir", type=Path)
    parser.add_argument("--replace", action="store_true")
    args = parser.parse_args()
    applications = args.applications_dir or Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "applications"
    install(args.prefix, applications, args.replace)


if __name__ == "__main__":
    main()

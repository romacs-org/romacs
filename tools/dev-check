#!/usr/bin/env python3
"""Check a branch before it is submitted: what would send it back, cheapest first.

  forecast    the merge with the trunk, made in memory. A conflicting file is
              `additive` (both sides add at the same place: keep both), an
              `overlap` (both rewrote the same lines) or `whole` (one side
              deleted or moved it), with how many recent landings touched it:
              one in twenty makes it a hot file.
  generated   no tracked file a tool of ours makes (tools/lib/generated_files.py).
  agents      every AGENTS.md names only what exists (tools/lib/agents_md.py).
  lint        tools/romacs-lint on the runtime Lisp files the change touches:
              what it adds since the merge-base, as the queue's Lisp tier holds
              it. It runs a Romacs: --binary, else what tools/romacs-lint finds.
  epoch       etc/romacs-runtime-epoch holds a whole number, and a change that
              raises it (the newest of its own changes to it, committed or not,
              ends above what it changed) ends above the trunk tip's: two
              changes raised to one number would merge without a conflict and
              ship two contracts as one generation. A change of lisp/vm/ beside
              romacs-vm's Rust may be one contract between them: unless it
              raises the epoch, it is named, to raise it if the Lisp needs the
              Rust (lisp/vm/AGENTS.md). Which it is the stage cannot tell, so
              that finding fails nothing.
  loaddefs    lisp/'s loaddefs files are what tools/lisp-loaddefs makes of the tree,
              when the change touches a .el under lisp/ or etc/themes. It runs the
              pinned GNU binary; without one the stage cannot run.
  tests       the Rust tests the change can reach, by tools/lib/impact.py (the
              packages and test files it selects, and the structural rules),
              run on this tree into CARGO_TARGET_DIR. The rules that run the
              compiler (SLOW_RULES) and the live harnesses are the queue's, and
              the summary names them. A change the map cannot place reaches
              everything, which is the queue's full check: the stage says so
              and does not pass. --no-tests leaves the stage out.

One line a stage and one a finding, each with its fix. Exit 1 when a stage
fails, 2 when one could not run.

cargo and cargo-nextest are looked for on PATH, then in the host's pins
ROMACS_TOOLCHAIN_BIN and ROMACS_NEXTEST_BIN, which an agent's shell has even
where its PATH lacks the toolchain. Found there, they are put on PATH for what
this check runs.
"""
import argparse
from collections import Counter
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/lib'))
import agents_md  # noqa: E402
import lisp_layout  # noqa: E402
import generated_files  # noqa: E402
import impact  # noqa: E402
import test_modules  # noqa: E402

LANDINGS = 150
ADVICE = {'additive': 'both sides add at the same place; fix: merge the trunk in and keep both sides\' lines',
          'overlap': 'both sides rewrote the same lines; fix: merge the trunk in and resolve it',
          'whole': 'one side deleted or moved it; fix: merge the trunk in and carry the change to where it went'}


def load_gate(root=ROOT):
    """tools/gate as a module: the trunk and the paths a branch changes are its to name."""
    loader = importlib.machinery.SourceFileLoader('romacs_gate', str(root / 'tools/gate'))
    gate = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(gate)
    return gate


# The forecast.

def merged(output):
    """(TREE, FILES) of `git merge-tree -z --write-tree --name-only --no-messages` OUTPUT.
    NUL-delimited: git quotes a path with a quote, a backslash or a byte past ASCII otherwise."""
    tree, *files = [field for field in output.split('\0') if field]
    return tree, files


def hunks(text):
    """The conflict hunks of diff3-marked TEXT, each (OURS, BASE, THEIRS) as line lists."""
    found, sides, side = [], None, None
    for line in text.splitlines():
        if line.startswith('<<<<<<< '):
            sides, side = ([], [], []), 0
        elif sides is not None and line.startswith('||||||| '):
            side = 1
        elif sides is not None and line == '=======':
            side = 2
        elif sides is not None and line.startswith('>>>>>>> '):
            found.append(sides)
            sides = None
        elif sides is not None:
            sides[side].append(line)
    return found


def within(part, whole):
    """Whether the lines PART are in WHOLE, in order."""
    rest = iter(whole)
    return all(line in rest for line in part)


def kind(text):
    """How a conflicting file's merged TEXT conflicts: additive, overlap or whole."""
    found = hunks(text)
    if not found:
        return 'whole'
    return 'additive' if all(within(base, ours) and within(base, theirs) for ours, base, theirs in found) else 'overlap'


def landings(log):
    """How many landings touched each file, from `git log -z --first-parent -m --name-only --format=tformat:` LOG:
    its fields are paths, the first of a landing after a newline."""
    return Counter(field.lstrip('\n') for field in log.split('\0') if field.strip('\n'))


def conflict(path, how, touched):
    """The finding for PATH conflicting as HOW, TOUCHED of the last landings having changed it.
    A file one landing in twenty changes is hot: it will have moved again by the next attempt."""
    hot = touched * 20 >= LANDINGS
    return (f'conflict {path}: {how}{" in a hot file" if hot else ""} ({touched} of the last {LANDINGS} landings touched it), '
            f'{ADVICE[how]}{", then submit at once: it moves often" if hot else ""}')


def git(root, *args, check=True):
    done = subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True, errors='replace')
    if check and done.returncode:
        raise RuntimeError(f'git {" ".join(args)}: {done.stderr.strip()}')
    return done


def forecast(root, trunk):
    """(STATUS, SUMMARY, FINDINGS) of merging ROOT's HEAD with TRUNK."""
    tip = git(root, 'rev-parse', '--short=12', trunk).stdout.strip()
    behind = git(root, 'rev-list', '--count', '--first-parent', f'HEAD..{trunk}').stdout.strip()
    dirty = len(git(root, 'status', '--porcelain').stdout.splitlines())
    notes = [f'{dirty} uncommitted path(s) are not in the forecast; fix: commit them first'] if dirty else []
    done = git(root, '-c', 'merge.conflictStyle=diff3', 'merge-tree', '-z', '--write-tree', '--name-only', '--no-messages',
               trunk, 'HEAD', check=False)
    if done.returncode == 0:
        return 'ok', f'merges cleanly with {trunk} {tip} ({behind} landing(s) behind)', notes
    if done.returncode != 1:
        raise RuntimeError(f'git merge-tree: {done.stderr.strip()}')
    tree, files = merged(done.stdout)
    touched = landings(git(root, 'log', '-z', '--first-parent', '-m', '--name-only', '--format=tformat:', '-n', str(LANDINGS), trunk).stdout)
    findings = [conflict(path, kind(git(root, 'show', f'{tree}:{path}', check=False).stdout), touched[path]) for path in files]
    return 'FAIL', f'{len(files)} conflict(s) with {trunk} {tip} ({behind} landing(s) behind)', findings + notes


# Generated files.

def generated(root):
    """(STATUS, SUMMARY, FINDINGS): no generator's output is tracked."""
    found = generated_files.tracked(root)
    findings = [f'{name} is tracked; {generated_files.OUTPUTS[name]} makes it; fix: git rm it' for name in found]
    return ('FAIL', f'{len(found)} generated file(s) tracked', findings) if found else ('ok', 'no generated file is tracked', [])


# The runtime tree's generation.

EPOCH = 'etc/romacs-runtime-epoch'


def generation(text):
    """The whole number TEXT, an epoch file's contents, holds; None for no text or another."""
    return int(text.strip()) if text is not None and text.strip().isdigit() else None


def rank(found):
    """A generation FOUND, to compare: none is below every one."""
    return -1 if found is None else found


def last_change(lines, value):
    """Whether the newest commit of LINES that changes the generation raises it, or None
    when none changes it. LINES are `git rev-list --topo-order --parents` lines split,
    newest first; VALUE maps each commit to its generation. A commit changes it when it
    differs from every parent's, so a merge that takes the trunk's does not; it raises it
    when it ends above them all, so a revert does not."""
    for commit, *parents in lines:
        if all(value[commit] != value[parent] for parent in parents):
            return all(rank(value[commit]) > rank(value[parent]) for parent in parents)
    return None


def epoch_history(root, trunk):
    """(RAISED, OURS, TIP): whether ROOT's change since TRUNK raises the epoch, by its
    uncommitted tree or else by the newest of its own commits that changes it, and the
    epoch file's text in ROOT's tree and at TRUNK's tip (None where there is none).
    On a merged tree the changed paths cannot show a raise: the trunk's equal one hides it."""
    lines = [line.split() for line in git(root, 'rev-list', '--topo-order', '--parents', f'{trunk}..HEAD').stdout.splitlines()]
    commits = sorted({commit for line in lines for commit in line})
    asked = subprocess.run(['git', '-C', str(root), 'cat-file', '--batch-check=%(objectname)'], capture_output=True,
                           text=True, check=True, input=''.join(f'{commit}:{EPOCH}\n' for commit in commits))
    blob = {commit: None if found.endswith(' missing') else found
            for commit, found in zip(commits, asked.stdout.splitlines())}
    text = {found: git(root, 'cat-file', 'blob', found).stdout for found in set(blob.values()) if found}
    value = {commit: generation(text.get(found)) for commit, found in blob.items()}

    def shown(rev):
        done = git(root, 'show', f'{rev}:{EPOCH}', check=False)
        return done.stdout if done.returncode == 0 else None

    file = root / EPOCH
    ours = file.read_text() if file.exists() else None
    now, head = generation(ours), generation(shown('HEAD'))
    raised = rank(now) > rank(head) if now != head else bool(last_change(lines, value))
    return raised, ours, shown(trunk)


def epoch(names, raised, ours, tip):
    """(STATUS, SUMMARY, FINDINGS) of the runtime tree's generation. NAMES are the
    change's paths; RAISED, whether it raises the epoch; OURS and TIP, the epoch file's
    text in its tree and at the trunk's tip, None where there is none. The file holds a
    whole number, and a raised epoch ends above TIP's. A change of lisp/vm/ beside
    romacs-vm's Rust that leaves the epoch alone may be one contract, and is named."""
    here, top = generation(ours), generation(tip)
    if ours is not None and here is None:
        return 'FAIL', f'{EPOCH} holds no whole number', [f'{EPOCH}: {ours.strip()!r}; fix: write the generation as one whole number']
    if raised and top is not None and rank(here) <= top:
        return 'FAIL', f"{EPOCH} is raised to {here}, not above the trunk's {top}", [
            f'{EPOCH}: the trunk holds generation {top} already, and a merge of two equal raises '
            f'shows no conflict; fix: merge the trunk in and raise it to {top + 1}']
    if raised:
        return 'ok', f"{EPOCH} is raised to {here}" + (f", above the trunk's {top}" if top is not None else ''), []
    lisp = sorted(n for n in names if n.startswith('lisp/vm/') and n.endswith('.el'))
    rust = [n for n in names if n.startswith('crates/romacs-vm/src/') and n.endswith('.rs')]
    if not (lisp and rust):
        return 'ok', "no lisp/vm/ change beside romacs-vm's Rust", []
    return 'ok', f"lisp/vm/ and romacs-vm change together, {EPOCH} unchanged", [
        f'{", ".join(lisp)}: if it needs the Rust beside it, raise {EPOCH} (lisp/vm/AGENTS.md)']


# The AGENTS.md files.

def agents(root):
    """(STATUS, SUMMARY, FINDINGS): every AGENTS.md names only what the tree has."""
    found = agents_md.check(root)
    count = len(agents_md.files(root))
    if found:
        return 'FAIL', f'{len(found)} stale line(s) in the AGENTS.md files', found
    return 'ok', f'{count} AGENTS.md file(s) name nothing missing', []


# The lint.

def lisp_files(names, root, moved=()):
    """The runtime Lisp among the changed paths NAMES that ROOT still has: every .el under
    lisp/ but the bundled packages' and the MOVED ones, renamed with their text unchanged
    (the lint reports only what the change adds, and a move adds none)."""
    packages = 'lisp/' + lisp_layout.layout(root)['packages'] + '/'
    return sorted(name for name in names if name.startswith('lisp/') and name.endswith('.el')
                  and not name.startswith(packages) and name not in moved and (root / name).is_file())


def moved_unchanged(root, base):
    """The paths ROOT's working tree has from BASE by an exact rename."""
    done = git(root, 'diff', '-z', '--name-only', '--diff-filter=R', '-M100%', base)
    return set(filter(None, done.stdout.split('\0')))


def lint_stage(status, output, errors):
    """(STATUS, SUMMARY, FINDINGS) of a tools/romacs-lint run that exited with STATUS:
    its closing line is the summary, the lines before it the findings. Exit 2
    with a closing line judged some files and left others unjudged: the stage
    is incomplete, with what it found and the files it could not judge."""
    lines = output.splitlines()
    if status == 2 and lines and lines[-1].startswith('romacs-lint: '):
        unjudged = [line for line in errors.splitlines() if line.startswith('romacs-lint: ')]
        return 'SKIP', lines[-1].removeprefix('romacs-lint: '), lines[:-1] + unjudged
    if status not in (0, 1) or not lines:
        why = (errors.strip().splitlines() or ['no output'])[-1]
        return 'SKIP', 'tools/romacs-lint gave no result', [f'{why}; fix: pass --binary HOST, or build one (cargo build --profile gate -p romacs-vm-gui)']
    return ('FAIL' if status else 'ok'), lines[-1].removeprefix('romacs-lint: '), lines[:-1]


def lint_command(root, files, base, binary):
    """The tools/romacs-lint run of FILES against the revision BASE, by the host BINARY or the lint's own choice."""
    return [sys.executable, '-B', str(root / 'tools/romacs-lint'), '--base', base, *(['--binary', binary] if binary else []), *files]


def lint(root, names, trunk, binary):
    """(STATUS, SUMMARY, FINDINGS) of the lint on the Lisp among the changed paths NAMES:
    what the branch adds since its merge-base with TRUNK, the base the paths were taken from."""
    base = git(root, 'merge-base', 'HEAD', trunk).stdout.strip()
    files = lisp_files(names, root, moved_unchanged(root, base))
    if not files:
        return 'ok', 'no runtime Lisp file changed', []
    done = subprocess.run(lint_command(root, files, base, binary), cwd=root, capture_output=True, text=True,
                          errors='replace', stdin=subprocess.DEVNULL)
    return lint_stage(done.returncode, done.stdout, done.stderr)


# The loaddefs files.

def loaddefs(root, names):
    """(STATUS, SUMMARY, FINDINGS) of tools/lisp-loaddefs --check, for a change that can move them."""
    touched = [n for n in names if (n.startswith('lisp/') and n.endswith('.el')) or n.startswith('etc/themes/')]
    if not touched:
        return 'ok', 'no Lisp or theme file changed', []
    done = subprocess.run([sys.executable, '-B', str(root / 'tools/lisp-loaddefs'), '--check'], cwd=root,
                          capture_output=True, text=True)
    if done.returncode == 0:
        return 'ok', 'the loaddefs files are current', []
    findings = [line for line in done.stdout.splitlines() if line.startswith('lisp/')]
    if findings:
        return 'FAIL', f'{len(findings)} loaddefs file(s) out of date', findings
    why = (done.stderr.strip().splitlines() or ['no output'])[-1]
    return 'SKIP', 'tools/lisp-loaddefs could not run', [f'{why}; fix: set ROMACS_GNU_ORACLE to the pinned GNU binary']



# The tests a change can reach.

def plan(answer, root):
    """IMPACT's runs for ANSWER, one a package, less what only the queue can run:
    the rules that run the compiler, and the tests that need the gate's own
    evidence. None when the change reaches everything."""
    runs = impact.runs(answer, root, leave=impact.SLOW_RULES)
    return runs and [(package, flags, f'({rule}) & not {impact.GATE_ONLY}') for package, flags, rule in runs]


def queue_runs(answer):
    """What the queue runs of ANSWER that this check does not, as text."""
    slow = ', '.join(name.split('::')[1] for name in impact.SLOW_RULES)
    harnesses = ', '.join(sorted(answer['harnesses']))
    return f'the queue runs {slow}, the parity ratchets' + (f' and the harnesses {harnesses}' if harnesses else '')


def toolchain_path(env):
    """The PATH ENV's commands find cargo and cargo-nextest on: ENV's own, with
    the pinned directories (ROMACS_TOOLCHAIN_BIN, ROMACS_NEXTEST_BIN) after it
    when it lacks either; None when neither way has both. Cargo looks for a
    subcommand in its home's bin before PATH unless PATH names that directory,
    so the PATH ends with it: the cargo-nextest found here is the one run."""
    path = env.get('PATH', '')
    pins = [env[name] for name in ('ROMACS_TOOLCHAIN_BIN', 'ROMACS_NEXTEST_BIN') if env.get(name)]
    home = os.path.join(env.get('CARGO_HOME') or os.path.join(env.get('HOME', ''), '.cargo'), 'bin')
    for candidate in (path, os.pathsep.join([path, *pins]) if pins else None):
        if candidate is not None and all(shutil.which(tool, path=candidate) for tool in ('cargo', 'cargo-nextest')):
            return candidate if home in candidate.split(os.pathsep) else os.pathsep.join([candidate, home])
    return None


def failures(log):
    """The failing tests of a nextest LOG, each (TEST, WHY): WHY the lines its panic printed."""
    found, lines = {}, log.splitlines()
    for index, line in enumerate(lines):
        failed = re.match(r'\s+(?:FAIL|TIMEOUT|SIGABRT|SIGSEGV|SIGKILL)\b.*?\]\s+(?:\(.*?\)\s+)?(\S+ \S+)\s*$', line)
        if failed:
            found.setdefault(failed[1], [])
        panic = re.match(r"\s+thread '([^']+)' \(\d+\) panicked at ", line)
        if panic:
            why = []
            for after in lines[index + 1:index + 12]:
                if not after.strip() or 'RUST_BACKTRACE' in after:
                    break
                why.append(after.strip())
            for test in found:
                if test.endswith(panic[1]) and not found[test]:
                    found[test] = why
    return sorted(found.items())


def build_errors(log, limit=4):
    """The compiler's errors in a nextest LOG, each its message and where it is: what a
    run that did not build says, rather than leaving the log to be read."""
    lines, found = log.splitlines(), []
    for index, line in enumerate(lines):
        # nextest's own closing words are no compiler error.
        if re.match(r'error(\[E\d+\])?: ', line) and not line.startswith(('error: could not compile', 'error: command', 'error: test run failed')):
            at = next((after.strip().removeprefix('--> ') for after in lines[index + 1:index + 4] if '-->' in after), '')
            found.append(f'{at}: {line}' if at else line)
    return list(dict.fromkeys(found))[:limit]


def log_path(root):
    cache = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'romacs/dev-check'
    cache.mkdir(parents=True, exist_ok=True)
    return cache / (re.sub(r'[^A-Za-z0-9_.-]', '-', str(root).strip('/')) + '-tests.log')


def tests(root, names, threads):
    """(STATUS, SUMMARY, FINDINGS) of the tests a change to the paths NAMES can reach, on ROOT's tree."""
    path = toolchain_path(os.environ)
    if path is None:
        return 'SKIP', 'incomplete: no cargo (neither PATH nor ROMACS_TOOLCHAIN_BIN and ROMACS_NEXTEST_BIN has cargo and cargo-nextest)', [
            'fix: set ROMACS_TOOLCHAIN_BIN and ROMACS_NEXTEST_BIN to the pinned toolchain, or put it on PATH']
    # What the stage runs finds the toolchain on PATH; its caller's PATH is put back.
    before = os.environ.get('PATH')
    os.environ['PATH'] = path
    try:
        return run_tests(root, names, threads)
    finally:
        if before is None:
            del os.environ['PATH']
        else:
            os.environ['PATH'] = before


def test_environment(scratch, environ=os.environ):
    """The tests' environment: ENVIRON less the gate's EDITOR_LAUNCH (a
    running editor's own launch variables and a desktop session's, which
    no test may see), its TMPDIR SCRATCH."""
    launch = load_gate().EDITOR_LAUNCH
    return {k: v for k, v in environ.items() if k not in launch} | {'TMPDIR': scratch}


# The editor runs these programs from beside its own binary (romacs-keeper.el,
# romacs-agent.el). Cargo builds a package's own binaries for its tests, never
# another package's, so a run of the editor's tests builds them first.
HOST = 'romacs-vm-gui'
COMPANIONS = {'romacs-mcp': ('romacs-mcp', 'romacs-agent-host'), 'romacs-keeper': ('romacs-keeper',)}


def companion_build(runs):
    """The command that builds the editor's companions into the gate profile's
    directory before RUNS, or None when no run is the editor's. Cargo makes it
    a no-op once they are built."""
    if all(package != HOST for package, _, _ in runs):
        return None
    return ['cargo', 'build', '--profile', 'gate', '--locked', '--offline',
            *(flag for package in COMPANIONS for flag in ('-p', package)),
            *(flag for names in COMPANIONS.values() for name in names for flag in ('--bin', name))]


def commands(runs, threads):
    """The commands the tests stage runs for RUNS, in order."""
    build = companion_build(runs)
    return ([build] if build else []) + [
        ['cargo', 'nextest', 'run', '--cargo-profile', 'gate', '--locked', '--offline', '-p', package, *flags,
         '--test-threads', str(threads), '--no-fail-fast', '--retries', '0', '--no-tests=fail',
         '--status-level', 'fail', '--final-status-level', 'fail', '-E', rule]
        for package, flags, rule in runs]


def run_tests(root, names, threads):
    """The tests stage on ROOT's tree, with the toolchain on PATH."""
    answer = impact.select(names, root, impact.metadata_of(root))
    runs = plan(answer, root)
    if runs is None:
        why = ', '.join(answer['reasons'][:3]) + (' ...' if len(answer['reasons']) > 3 else '')
        return 'SKIP', f'the change reaches everything ({why}): the queue runs the full check', [
            'fix: none needed; submit, or run `python3 tools/gate full` for the whole suite here']
    log, started, status = log_path(root), time.monotonic(), 0
    with log.open('w') as sink, tempfile.TemporaryDirectory(prefix='rdc-', dir=log.parent) as scratch:
        env = test_environment(scratch)
        for command in commands(runs, threads):
            sink.write(f'$ {" ".join(command)}\n')
            sink.flush()
            status |= subprocess.run(command, cwd=root, env=env, stdin=subprocess.DEVNULL,
                                     stdout=sink, stderr=subprocess.STDOUT).returncode
    reached = f'{len(answer["packages"])} package(s) and {len(answer["files"])} test file(s) reached'
    spent = f'{time.monotonic() - started:.0f} s, log {log}'
    if status == 0:
        return 'ok', f'{reached} hold ({spent}); {queue_runs(answer)}', []
    return failed_runs(log.read_text(errors='replace'), spent)


def failed_runs(log, spent):
    """(STATUS, SUMMARY, FINDINGS) of runs that failed, from their nextest LOG: the
    tests that failed and the compiler's errors, either or both."""
    failed, errors = failures(log), build_errors(log)
    findings = [f'{test}: {" ".join(why)[:400] or "see the log"}' for test, why in failed] + \
               [f'{error}; fix: make it compile' for error in errors]
    if not failed:
        return 'FAIL', f'the tests did not build or run ({spent})', findings or ['fix: read the log']
    built = '; and a package did not build' if errors else ''
    return 'FAIL', f'{len(failed)} test(s) failed of what the change reaches{built} ({spent})', findings


def report(stages):
    """The lines for STAGES, (NAME, STATUS, SUMMARY, FINDINGS): failures first, and the verdict."""
    order = {'FAIL': 0, 'SKIP': 1, 'ok': 2}
    lines = []
    for name, status, summary, findings in sorted(stages, key=lambda stage: order[stage[1]]):
        lines.append(f'{name}: {status} {summary}')
        lines.extend(f'  {finding}' for finding in findings)
    failed = [name for name, status, _, _ in stages if status == 'FAIL']
    skipped = [name for name, status, _, _ in stages if status == 'SKIP']
    verdict = f'FAIL ({", ".join(failed)})' if failed else f'INCOMPLETE ({", ".join(skipped)} did not run)' if skipped else 'ok'
    return lines + [f'dev-check: {verdict}'], 1 if failed else 2 if skipped else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--trunk', default=os.environ.get('ROMACS_BASE', 'beta'), help='the branch this one lands on (default beta)')
    parser.add_argument('--no-tests', action='store_true', help='leave the tests out: they build test targets')
    parser.add_argument('--threads', type=int, default=8, help='test workers of the tests stage')
    parser.add_argument('--binary', help='the Romacs the lint runs; default as tools/romacs-lint: $ROMACS_TEST_BINARY, else the gate build')
    args = parser.parse_args()
    gate = load_gate()
    trunk = gate.trunk(ROOT, args.trunk)
    names = gate.changed_names(ROOT, trunk)
    stages = [('forecast', *forecast(ROOT, trunk)), ('generated', *generated(ROOT)), ('agents', *agents(ROOT)),
              ('epoch', *epoch(names, *epoch_history(ROOT, trunk))), ('lint', *lint(ROOT, names, trunk, args.binary)),
              ('loaddefs', *loaddefs(ROOT, names))]
    if not args.no_tests:
        stages.append(('tests', *tests(ROOT, names, args.threads)))
    lines, status = report(stages)
    print('\n'.join(lines))
    return status


if __name__ == '__main__':
    sys.exit(main())

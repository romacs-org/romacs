#!/usr/bin/env python3
"""Check a branch before it is submitted: what would send it back, cheapest first.

  forecast    the merge with the trunk, made in memory. A conflicting file is
              `additive` (both sides add at the same place: keep both), an
              `overlap` (both rewrote the same lines) or `whole` (one side
              deleted or moved it), with how many recent landings touched it:
              one in twenty makes it a hot file.
  generated   no tracked file a tool of ours makes (tools/lib/generated_files.py).
  agents      every AGENTS.md names only what exists (tools/lib/agents_md.py).
  lint        tools/romacs-lint on the files of lisp/romacs the change touches:
              what it adds since the merge-base, as the queue's Lisp tier holds
              it. It runs a Romacs: --binary, else what tools/romacs-lint finds.
  tests       the Rust tests the change can reach, by tools/lib/impact.py (the
              packages and test files it selects, and the structural rules),
              run on this tree into CARGO_TARGET_DIR. The rules that run the
              compiler (SLOW_RULES) and the live harnesses are the queue's, and
              the summary names them. A change the map cannot place reaches
              everything, which is the queue's full check: the stage says so
              and does not pass. --no-tests leaves the stage out.

One line a stage and one a finding, each with its fix. Exit 1 when a stage
fails, 2 when one could not run.
"""
import argparse
from collections import Counter
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/lib'))
import agents_md  # noqa: E402
import generated_files  # noqa: E402
import impact  # noqa: E402
import test_modules  # noqa: E402

LANDINGS = 150
ADVICE = {'additive': 'both sides add at the same place; fix: merge the trunk in and keep both sides\' lines',
          'overlap': 'both sides rewrote the same lines; fix: merge the trunk in and resolve it',
          'whole': 'one side deleted or moved it; fix: merge the trunk in and carry the change to where it went'}


def load_gate(root=ROOT):
    """tools/gate as a module: the trunk and the paths a branch changes are its to name."""
    loader = importlib.machinery.SourceFileLoader('romacs_gate', str(root / 'tools/gate'))
    gate = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(gate)
    return gate


# The forecast.

def merged(output):
    """(TREE, FILES) of `git merge-tree -z --write-tree --name-only --no-messages` OUTPUT.
    NUL-delimited: git quotes a path with a quote, a backslash or a byte past ASCII otherwise."""
    tree, *files = [field for field in output.split('\0') if field]
    return tree, files


def hunks(text):
    """The conflict hunks of diff3-marked TEXT, each (OURS, BASE, THEIRS) as line lists."""
    found, sides, side = [], None, None
    for line in text.splitlines():
        if line.startswith('<<<<<<< '):
            sides, side = ([], [], []), 0
        elif sides is not None and line.startswith('||||||| '):
            side = 1
        elif sides is not None and line == '=======':
            side = 2
        elif sides is not None and line.startswith('>>>>>>> '):
            found.append(sides)
            sides = None
        elif sides is not None:
            sides[side].append(line)
    return found


def within(part, whole):
    """Whether the lines PART are in WHOLE, in order."""
    rest = iter(whole)
    return all(line in rest for line in part)


def kind(text):
    """How a conflicting file's merged TEXT conflicts: additive, overlap or whole."""
    found = hunks(text)
    if not found:
        return 'whole'
    return 'additive' if all(within(base, ours) and within(base, theirs) for ours, base, theirs in found) else 'overlap'


def landings(log):
    """How many landings touched each file, from `git log -z --first-parent -m --name-only --format=tformat:` LOG:
    its fields are paths, the first of a landing after a newline."""
    return Counter(field.lstrip('\n') for field in log.split('\0') if field.strip('\n'))


def conflict(path, how, touched):
    """The finding for PATH conflicting as HOW, TOUCHED of the last landings having changed it.
    A file one landing in twenty changes is hot: it will have moved again by the next attempt."""
    hot = touched * 20 >= LANDINGS
    return (f'conflict {path}: {how}{" in a hot file" if hot else ""} ({touched} of the last {LANDINGS} landings touched it), '
            f'{ADVICE[how]}{", then submit at once: it moves often" if hot else ""}')


def git(root, *args, check=True):
    done = subprocess.run(['git', '-C', str(root), *args], capture_output=True, text=True, errors='replace')
    if check and done.returncode:
        raise RuntimeError(f'git {" ".join(args)}: {done.stderr.strip()}')
    return done


def forecast(root, trunk):
    """(STATUS, SUMMARY, FINDINGS) of merging ROOT's HEAD with TRUNK."""
    tip = git(root, 'rev-parse', '--short=12', trunk).stdout.strip()
    behind = git(root, 'rev-list', '--count', '--first-parent', f'HEAD..{trunk}').stdout.strip()
    dirty = len(git(root, 'status', '--porcelain').stdout.splitlines())
    notes = [f'{dirty} uncommitted path(s) are not in the forecast; fix: commit them first'] if dirty else []
    done = git(root, '-c', 'merge.conflictStyle=diff3', 'merge-tree', '-z', '--write-tree', '--name-only', '--no-messages',
               trunk, 'HEAD', check=False)
    if done.returncode == 0:
        return 'ok', f'merges cleanly with {trunk} {tip} ({behind} landing(s) behind)', notes
    if done.returncode != 1:
        raise RuntimeError(f'git merge-tree: {done.stderr.strip()}')
    tree, files = merged(done.stdout)
    touched = landings(git(root, 'log', '-z', '--first-parent', '-m', '--name-only', '--format=tformat:', '-n', str(LANDINGS), trunk).stdout)
    findings = [conflict(path, kind(git(root, 'show', f'{tree}:{path}', check=False).stdout), touched[path]) for path in files]
    return 'FAIL', f'{len(files)} conflict(s) with {trunk} {tip} ({behind} landing(s) behind)', findings + notes


# Generated files.

def generated(root):
    """(STATUS, SUMMARY, FINDINGS): no generator's output is tracked."""
    found = generated_files.tracked(root)
    findings = [f'{name} is tracked; {generated_files.OUTPUTS[name]} makes it; fix: git rm it' for name in found]
    return ('FAIL', f'{len(found)} generated file(s) tracked', findings) if found else ('ok', 'no generated file is tracked', [])


# The AGENTS.md files.

def agents(root):
    """(STATUS, SUMMARY, FINDINGS): every AGENTS.md names only what the tree has."""
    found = agents_md.check(root)
    count = len(agents_md.files(root))
    if found:
        return 'FAIL', f'{len(found)} stale line(s) in the AGENTS.md files', found
    return 'ok', f'{count} AGENTS.md file(s) name nothing missing', []


# The lint.

def lisp_files(names, root):
    """The files of Romacs's own Lisp among the changed paths NAMES that ROOT still has."""
    return sorted(name for name in names if name.startswith('lisp/romacs/') and name.endswith('.el') and (root / name).is_file())


def lint_stage(status, output, errors):
    """(STATUS, SUMMARY, FINDINGS) of a tools/romacs-lint run that exited with STATUS:
    its closing line is the summary, the lines before it the findings."""
    lines = output.splitlines()
    if status not in (0, 1) or not lines:
        why = (errors.strip().splitlines() or ['no output'])[-1]
        return 'SKIP', 'tools/romacs-lint gave no result', [f'{why}; fix: pass --binary HOST, or build one (cargo build --profile gate -p romacs-vm-gui)']
    return ('FAIL' if status else 'ok'), lines[-1].removeprefix('romacs-lint: '), lines[:-1]


def lint_command(root, files, base, binary):
    """The tools/romacs-lint run of FILES against the revision BASE, by the host BINARY or the lint's own choice."""
    return [sys.executable, '-B', str(root / 'tools/romacs-lint'), '--base', base, *(['--binary', binary] if binary else []), *files]


def lint(root, names, trunk, binary):
    """(STATUS, SUMMARY, FINDINGS) of the lint on the Lisp among the changed paths NAMES:
    what the branch adds since its merge-base with TRUNK, the base the paths were taken from."""
    files = lisp_files(names, root)
    if not files:
        return 'ok', 'no file of lisp/romacs changed', []
    base = git(root, 'merge-base', 'HEAD', trunk).stdout.strip()
    done = subprocess.run(lint_command(root, files, base, binary), cwd=root, capture_output=True, text=True,
                          errors='replace', stdin=subprocess.DEVNULL)
    return lint_stage(done.returncode, done.stdout, done.stderr)


# The tests a change can reach.

def plan(answer, root):
    """IMPACT's runs for ANSWER, one a package, less what only the queue can run:
    the rules that run the compiler, and the tests that need the gate's own
    evidence. None when the change reaches everything."""
    runs = impact.runs(answer, root, leave=impact.SLOW_RULES)
    return runs and [(package, flags, f'({rule}) & not {impact.GATE_ONLY}') for package, flags, rule in runs]


def queue_runs(answer):
    """What the queue runs of ANSWER that this check does not, as text."""
    slow = ', '.join(name.split('::')[1] for name in impact.SLOW_RULES)
    harnesses = ', '.join(sorted(answer['harnesses']))
    return f'the queue runs {slow}, the parity ratchets' + (f' and the harnesses {harnesses}' if harnesses else '')


def failures(log):
    """The failing tests of a nextest LOG, each (TEST, WHY): WHY the lines its panic printed."""
    found, lines = {}, log.splitlines()
    for index, line in enumerate(lines):
        failed = re.match(r'\s+(?:FAIL|TIMEOUT|SIGABRT|SIGSEGV|SIGKILL)\b.*?\]\s+(?:\(.*?\)\s+)?(\S+ \S+)\s*$', line)
        if failed:
            found.setdefault(failed[1], [])
        panic = re.match(r"\s+thread '([^']+)' \(\d+\) panicked at ", line)
        if panic:
            why = []
            for after in lines[index + 1:index + 12]:
                if not after.strip() or 'RUST_BACKTRACE' in after:
                    break
                why.append(after.strip())
            for test in found:
                if test.endswith(panic[1]) and not found[test]:
                    found[test] = why
    return sorted(found.items())


def build_errors(log, limit=4):
    """The compiler's errors in a nextest LOG, each its message and where it is: what a
    run that did not build says, rather than leaving the log to be read."""
    lines, found = log.splitlines(), []
    for index, line in enumerate(lines):
        if re.match(r'error(\[E\d+\])?: ', line) and not line.startswith(('error: could not compile', 'error: command')):
            at = next((after.strip().removeprefix('--> ') for after in lines[index + 1:index + 4] if '-->' in after), '')
            found.append(f'{at}: {line}' if at else line)
    return list(dict.fromkeys(found))[:limit]


def log_path(root):
    cache = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'romacs/dev-check'
    cache.mkdir(parents=True, exist_ok=True)
    return cache / (re.sub(r'[^A-Za-z0-9_.-]', '-', str(root).strip('/')) + '-tests.log')


def tests(root, names, threads):
    """(STATUS, SUMMARY, FINDINGS) of the tests a change to the paths NAMES can reach, on ROOT's tree."""
    if not shutil.which('cargo'):
        return 'SKIP', 'cargo is not on PATH', ['fix: run tools/dev-check from a shell with the toolchain']
    answer = impact.select(names, root, impact.metadata_of(root))
    runs = plan(answer, root)
    if runs is None:
        why = ', '.join(answer['reasons'][:3]) + (' ...' if len(answer['reasons']) > 3 else '')
        return 'SKIP', f'the change reaches everything ({why}): the queue runs the full check', [
            'fix: none needed; submit, or run `python3 tools/gate full` for the whole suite here']
    log, started, status = log_path(root), time.monotonic(), 0
    with log.open('w') as sink, tempfile.TemporaryDirectory(prefix='rdc-', dir=log.parent) as scratch:
        for package, flags, rule in runs:
            command = ['cargo', 'nextest', 'run', '--cargo-profile', 'gate', '--locked', '--offline', '-p', package, *flags,
                       '--test-threads', str(threads), '--no-fail-fast', '--retries', '0', '--no-tests=fail',
                       '--status-level', 'fail', '--final-status-level', 'fail', '-E', rule]
            sink.write(f'$ {" ".join(command)}\n')
            sink.flush()
            status |= subprocess.run(command, cwd=root, env=dict(os.environ, TMPDIR=scratch), stdin=subprocess.DEVNULL,
                                     stdout=sink, stderr=subprocess.STDOUT).returncode
    reached = f'{len(answer["packages"])} package(s) and {len(answer["files"])} test file(s) reached'
    spent = f'{time.monotonic() - started:.0f} s, log {log}'
    if status == 0:
        return 'ok', f'{reached} hold ({spent}); {queue_runs(answer)}', []
    return failed_runs(log.read_text(errors='replace'), spent)


def failed_runs(log, spent):
    """(STATUS, SUMMARY, FINDINGS) of runs that failed, from their nextest LOG: the
    tests that failed and the compiler's errors, either or both."""
    failed, errors = failures(log), build_errors(log)
    findings = [f'{test}: {" ".join(why)[:400] or "see the log"}' for test, why in failed] + \
               [f'{error}; fix: make it compile' for error in errors]
    if not failed:
        return 'FAIL', f'the tests did not build or run ({spent})', findings or ['fix: read the log']
    built = '; and a package did not build' if errors else ''
    return 'FAIL', f'{len(failed)} test(s) failed of what the change reaches{built} ({spent})', findings


def report(stages):
    """The lines for STAGES, (NAME, STATUS, SUMMARY, FINDINGS): failures first, and the verdict."""
    order = {'FAIL': 0, 'SKIP': 1, 'ok': 2}
    lines = []
    for name, status, summary, findings in sorted(stages, key=lambda stage: order[stage[1]]):
        lines.append(f'{name}: {status} {summary}')
        lines.extend(f'  {finding}' for finding in findings)
    failed = [name for name, status, _, _ in stages if status == 'FAIL']
    skipped = [name for name, status, _, _ in stages if status == 'SKIP']
    verdict = f'FAIL ({", ".join(failed)})' if failed else f'INCOMPLETE ({", ".join(skipped)} did not run)' if skipped else 'ok'
    return lines + [f'dev-check: {verdict}'], 1 if failed else 2 if skipped else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--trunk', default=os.environ.get('ROMACS_BASE', 'beta'), help='the branch this one lands on (default beta)')
    parser.add_argument('--no-tests', action='store_true', help='leave the tests out: they build test targets')
    parser.add_argument('--threads', type=int, default=8, help='test workers of the tests stage')
    parser.add_argument('--binary', help='the Romacs the lint runs; default as tools/romacs-lint: $ROMACS_TEST_BINARY, else the gate build')
    args = parser.parse_args()
    gate = load_gate()
    trunk = gate.trunk(ROOT, args.trunk)
    names = gate.changed_names(ROOT, trunk)
    stages = [('forecast', *forecast(ROOT, trunk)), ('generated', *generated(ROOT)), ('agents', *agents(ROOT)),
              ('lint', *lint(ROOT, names, trunk, args.binary))]
    if not args.no_tests:
        stages.append(('tests', *tests(ROOT, names, args.threads)))
    lines, status = report(stages)
    print('\n'.join(lines))
    return status


if __name__ == '__main__':
    sys.exit(main())

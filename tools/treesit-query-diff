#!/usr/bin/env python3
"""Build and compare the pinned C query engine and this checkout."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile

ROOT = Path(__file__).resolve().parent.parent
SUPPORT = Path("tools/lib/treesit-query")
sys.path.insert(0, str(ROOT / SUPPORT))
from corpus import build as corpus
from corpus import check_cases, freeze_cases, grammar_samples, sha256
from records import canonical, compare

NATIVE = Path("crates/romacs-vm/src/treesit/native.rs")
RECORDER = NATIVE.with_name("query_oracle.rs")
QUIT = Path("crates/romacs-vm/src/quit.rs")
POLLS = QUIT.with_suffix("") / "query_polls.rs"
GR_JSON = Path("crates/romacs-grammars/sources.json")
C_ENGINE = Path("crates/vendor/tree-sitter/src/query.c")
C_BINDINGS = C_ENGINE.parent.parent / "binding_rust/bindings.rs"
TEST = "treesit::native::query_oracle::query_oracle_"


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT)


def digest(path):
    return sha256(path.read_bytes())


def archive(ref, dest):
    dest.mkdir()
    with subprocess.Popen(["git", "archive", ref], cwd=ROOT, stdout=subprocess.PIPE) as job:
        with tarfile.open(fileobj=job.stdout, mode="r|") as contents:
            contents.extractall(dest, filter="data")
        if job.wait():
            raise ValueError(f"could not extract {ref}")
    return dest


def archive_reference(revision, dest):
    reference = archive(revision, dest)
    if not (reference / C_ENGINE).is_file():
        raise ValueError(f"C reference {revision} has no {C_ENGINE}")
    return reference


def insert_before(path, anchor, source):
    text = path.read_text()
    if source in text:
        return
    if text.count(anchor) != 1:
        raise ValueError(f"missing or ambiguous C reference anchor in {path}: {anchor.strip()}")
    path.write_text(text.replace(anchor, source + anchor))


def require_methods(path, owner, *required):
    impl = re.search(rf"^impl {owner} \{{\n(.*?)^\}}", path.read_text(), re.M | re.S)
    if impl is None:
        raise ValueError(f"missing C reference impl {owner} in {path}")
    methods = set(re.findall(r"^ +(?:pub(?:\(crate\))? )?fn (\w+)\(", impl[1], re.M))
    for method in required:
        if method not in methods:
            raise ValueError(f"missing C reference method {owner}::{method} in {path}")
    return methods


def require_capture_count_binding(reference, native):
    text = native.read_text()
    for declaration in ("use tree_sitter::ffi;", "struct Query(*mut ffi::TSQuery);"):
        if declaration not in text:
            raise ValueError(f"missing C reference declaration in {native}: {declaration}")
    for path, declaration in (
        (reference / C_ENGINE, r"^uint32_t ts_query_capture_count\("),
        (reference / C_BINDINGS, r"^ +pub fn ts_query_capture_count\("),
    ):
        if not path.is_file() or not re.search(declaration, path.read_text(), re.M):
            raise ValueError(f"missing C reference symbol ts_query_capture_count in {path}")


def add_reference_query_tests(reference, support):
    native = reference / NATIVE
    methods = require_methods(native, "Query", "new", "matches", "pattern_count", "capture_name", "predicates")
    anchor = "    /// Every match of the query under NODE"
    if "capture_count" not in methods:
        require_capture_count_binding(reference, native)
        insert_before(native, anchor, (support / "c-capture-count.rs").read_text() + "\n")
    insert_before(native, anchor, (support / "c-matches.rs").read_text() + "\n")
    insert_before(native, "pub(crate) use ffi::{",
                  '#[cfg(test)]\n#[path = "query_oracle.rs"]\nmod query_oracle;\n\n')


def add_reference_tests(reference, subject):
    """Use the same recorder and test-only poll observer on the pinned C arm."""
    require_methods(reference / NATIVE, "Language", "from_function", "abi_version")
    require_methods(reference / NATIVE, "Node", "ts", "identity")
    require_methods(reference / QUIT, "NativeStop", "never", "armed", "due")
    require_methods(reference / QUIT, "QuitSignal", "new")
    add_reference_query_tests(reference, subject / SUPPORT)
    shutil.copyfile(subject / RECORDER, reference / RECORDER)
    (reference / POLLS).parent.mkdir(exist_ok=True)
    shutil.copyfile(subject / POLLS, reference / POLLS)
    insert_before(reference / QUIT, "    /// Whether it may ever say to stop:",
                  (subject / SUPPORT / "test-stop.rs").read_text() + "\n")
    insert_before(reference / QUIT, "/// A loop's quit probe, taken from the VM before the loop",
                  '#[cfg(test)]\n#[path = "quit/query_polls.rs"]\npub(crate) mod query_polls;\n\n')
    insert_before(reference / QUIT,
                  "        if self.quit.is_some() { crate::gap_probe::safepoint(None); }",
                  "        #[cfg(test)]\n        if let Some(due) = query_polls::record() { return due; }\n")
    manifest = reference / "crates/romacs-vm/Cargo.toml"
    dependency = 'romacs-grammars = { path = "../romacs-grammars" }\n'
    if dependency not in manifest.read_text():
        insert_before(manifest, "# This crate with its test hooks, for its own tests.\n", dependency)
        subprocess.run(["cargo", "update", "--workspace", "--offline"], cwd=reference, check=True)


def build(root, dest, args, testing=False):
    # The archives have no index and are the only inputs being compiled.
    for path in root.rglob("*"):
        if path.is_file() and not path.is_symlink():
            path.touch(exist_ok=True)
    flags = ["--profile", "gate", "--locked", "--offline", "--message-format=json"]
    report = dest.with_suffix(".build.jsonl")
    with report.open("w") as log:
        subprocess.run(["cargo", *args, *flags], cwd=root, check=True, stdout=log)
    with report.open() as log:
        executables = [row["executable"] for line in log if (row := json.loads(line)).get("executable")
                       and row["profile"]["test"] == testing]
    if len(executables) != 1:
        raise ValueError(f"expected one executable, found {executables}")
    shutil.copy2(executables[0], dest)
    print(f"{digest(dest)}  {dest}", flush=True)
    return dest


def build_editor(source, dest):
    return build(source, dest, ["build", "-p", "romacs-vm-gui", "--bin", "romacs-vm-gui"])


def build_oracle(source, dest):
    return build(source, dest, ["test", "-p", "romacs-vm", "--lib", "--no-run"], testing=True)


def extract(editor, subject, work, *, reference=None):
    samples = json.loads((subject / SUPPORT / "samples.json").read_bytes())
    selected = grammar_samples(reference or subject, samples)
    (work / "samples.json").write_text(canonical(selected) + "\n")
    symbols = subprocess.check_output(["nm", "--defined-only", editor], text=True)
    if not {"ts_query_new", "ts_query_cursor_next_match"} <= {
        line.rsplit(maxsplit=1)[-1] for line in symbols.splitlines() if line
    }:
        raise ValueError("corpus editor is missing the linked C query engine")
    home = work / "editor-home"
    home.mkdir()
    env = {key: value for key, value in os.environ.items() if not key.startswith("ROMACS_")}
    env.update(HOME=str(home), ROMACS_RUNTIME_ROOT=str(subject),
               ROMACS_SOURCE_DIRECTORY=str(subject), ROMACS_LISP_DIR=str(subject / "lisp"),
               ROMACS_QUERY_SCRATCH=str(work))
    for kind in ("CACHE", "CONFIG", "DATA", "STATE"):
        env[f"XDG_{kind}_HOME"] = str(home / kind.lower())
    with (work / "extract.log").open("w") as log:
        subprocess.run([editor, "-Q", "--batch", "--load", subject / SUPPORT / "extract.el"],
                       cwd=subject, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)


def freeze_manifest(work, reference, subject, tree, c_editor_sha256, c_revision):
    # Use the pinned C lockfile to locate the grammar packages' query sources.
    cases = freeze_cases(corpus(reference, work))
    check_cases(cases)
    mode_files = sorted({origin for case in cases for origin in case["origins"][:case["shipped"]]
                         if origin.startswith("lisp/")})
    if not mode_files:
        raise ValueError("no mode source paths in the extracted corpus")
    manifest = dict(format=1, c_revision=c_revision, subject_tree=tree, c_editor_sha256=c_editor_sha256,
                    grammar_pins_sha256=digest(subject / GR_JSON),
                    mode_sources={path: digest(subject / path) for path in mode_files},
                    cases=cases)
    path = work / "corpus.json"
    path.write_text(canonical(manifest) + "\n")
    path.chmod(0o444)
    return path


def check_digest(path, expected):
    manifest = json.loads(path.read_bytes())
    if not isinstance(manifest, dict):
        raise ValueError(f"expected a manifest object: {path}")
    content = {key: value for key, value in manifest.items() if key != "c_editor_sha256"}
    actual = sha256((canonical(content) + "\n").encode())
    if actual != expected:
        raise ValueError(f"frozen manifest digest changed: {path} (expected {expected}, got {actual})")
    return manifest


def load_manifest(path, expected):
    manifest = check_digest(path, expected)
    revision = manifest.get("c_revision")
    if manifest.get("format") != 1 or not isinstance(revision, str) or not revision:
        raise ValueError("unexpected manifest format or C reference")
    cases = manifest["cases"]
    check_cases(cases)
    return cases


def record(oracle, manifest, expected):
    check_digest(manifest, expected)
    subprocess.run([oracle, TEST, "--skip", TEST + "record", "--nocapture"], check=True)
    path = oracle.with_suffix(".records")
    env = dict(os.environ, ROMACS_QUERY_CORPUS=str(manifest), ROMACS_QUERY_RECORDS=str(path))
    subprocess.run([oracle, "--ignored", "--exact", TEST + "record"], env=env, check=True)
    check_digest(manifest, expected)
    if not path.is_file() or not path.stat().st_size:
        raise ValueError(f"{oracle} produced no records")
    return path


def run(work, expected, c_reference):
    if work == ROOT or ROOT in work.parents:
        raise ValueError("--out must be outside the source tree")
    if not os.environ.get("CARGO_TARGET_DIR") or not Path(os.environ["CARGO_TARGET_DIR"]).is_absolute():
        raise ValueError("set CARGO_TARGET_DIR to the assigned absolute target path")
    subprocess.run(["git", "diff", "--exit-code"], cwd=ROOT, check=True)
    work.mkdir(parents=True)
    tree = git("write-tree").decode().strip()
    revision = git("rev-parse", "--verify", "--end-of-options", f"{c_reference}^{{commit}}").decode().strip()
    reference = archive_reference(revision, work / "reference")
    subject = archive(tree, work / "subject")
    if (reference / GR_JSON).read_bytes() != (subject / GR_JSON).read_bytes():
        raise ValueError("the pinned C arm uses different grammar sources")
    c_editor = build_editor(reference, work / "c-editor")
    extract(c_editor, subject, work, reference=reference)
    c_editor_sha256 = digest(c_editor)
    manifest = freeze_manifest(work, reference, subject, tree, c_editor_sha256, revision)
    cases = load_manifest(manifest, expected)
    print(f"Frozen before candidate build: {expected}  {manifest}", flush=True)
    add_reference_tests(reference, subject)
    c_records = record(build_oracle(reference, work / "oracle-c"), manifest, expected)
    rust = not (subject / C_ENGINE).is_file()
    candidate_records = record(build_oracle(subject, work / "oracle-candidate"), manifest, expected)
    compare(c_records, candidate_records, cases, rust)
    build_editor(subject, work / "candidate-editor")
    receipt = dict(corpus_digest=expected, c_editor_sha256=c_editor_sha256)
    (work / "receipt.json").write_text(canonical(receipt) + "\n")


def main():
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE"):
        os.environ.pop(key, None)
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    build_run = commands.add_parser("run", help="build both editors and freeze the corpus using C")
    build_run.add_argument("--out", type=Path, required=True)
    build_run.add_argument("--c-reference", required=True, metavar="REV",
                           help="C-backed editor revision to archive and compare against")
    check = commands.add_parser("compare", help="validate existing records against a frozen corpus")
    check.add_argument("--manifest", type=Path, required=True)
    check.add_argument("--reference", type=Path, required=True)
    check.add_argument("--candidate", type=Path, required=True)
    check.add_argument("--expect-c", action="store_true")
    for command in (build_run, check):
        command.add_argument("--corpus-digest", required=True, metavar="SHA256",
                             help="expected corpus content digest excluding the C editor fingerprint")
    args = parser.parse_args()
    if args.command == "run":
        run(args.out.resolve(), args.corpus_digest, args.c_reference)
    else:
        cases = load_manifest(args.manifest, args.corpus_digest)
        compare(args.reference, args.candidate, cases, not args.expect_c)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))

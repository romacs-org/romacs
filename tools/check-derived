#!/usr/bin/env python3
"""The tree's source-derived records and ratchets, before the expensive gate.

No file a tool of ours makes from the repository's sources is tracked
(tools/lib/generated_files.py); the ledgers and floors agree with the sources
they record, no smell rises above the merge-base's, and the Python unit tests pass.
"""
import pathlib
import subprocess
import sys

def main():
    root = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else '.').resolve()
    if not (root / '.git').exists():
        sys.exit(f'check-derived: {root} is not a worktree')
    sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / 'lib'))
    generated = subprocess.run([sys.executable, '-B', 'tools/lib/generated_files.py', 'check', '--root', str(root)], cwd=root)
    tests = subprocess.run([sys.executable, '-B', 'tools/lib/python_tests.py', '--root', str(root)], cwd=root)
    oracle = subprocess.run([sys.executable, 'tools/lib/lisp_oracle.py', 'check', '--root', str(root)], cwd=root)
    import lisp_oracle
    gnu_pin = subprocess.run([sys.executable, '-B', 'test/gnu/run.py', 'verify-pin', '--gnu', lisp_oracle.GNU_SOURCE], cwd=root)
    ratchet = subprocess.run([sys.executable, 'tools/lib/parity_ratchet.py', 'verify', '--candidate', '--root', str(root)], cwd=root)
    arity = subprocess.run([sys.executable, 'tools/lib/gnu_arity.py', 'check', '--root', str(root)], cwd=root)
    defvars = subprocess.run([sys.executable, '-B', 'tools/lib/gnu_defvars.py', 'check', '--root', str(root)], cwd=root)
    fonts = subprocess.run([sys.executable, '-B', 'tools/lib/bundled_fonts.py', 'check', '--root', str(root)], cwd=root)
    grammars = subprocess.run([sys.executable, '-B', 'tools/lib/treesit_grammars.py', 'check', '--root', str(root)], cwd=root)
    unsafe = subprocess.run([sys.executable, '-B', 'tools/lib/unsafe_census.py', 'check', '--root', str(root)], cwd=root)
    smells = subprocess.run([sys.executable, '-B', 'tools/lib/smells.py', 'check', '--root', str(root)], cwd=root)
    names = subprocess.run([sys.executable, '-B', 'tools/lib/divergence_index.py', '--names'], cwd=root)
    tree = subprocess.run([sys.executable, '-B', 'tools/lib/lisp_tree.py', 'check', str(root)], cwd=root)
    if generated.returncode or tests.returncode or oracle.returncode or gnu_pin.returncode or ratchet.returncode or arity.returncode or defvars.returncode or fonts.returncode or grammars.returncode or unsafe.returncode or smells.returncode or names.returncode or tree.returncode:
        return 1
    print('check-derived: ok, no generated file is tracked; the Python unit tests pass; lisp/gnu and test/gnu/test are the GNU pin less its declared exclusions; parity floors, GNU DEFUN arities and DEFVARs, the bundled fonts, the bundled grammars\' sources, every package denying unsafe_op_in_unsafe_fn, no smell or unsafe site above the merge-base's, the divergence file names and the Lisp trees\' names verified')
    return 0


if __name__ == '__main__':
    sys.exit(main())

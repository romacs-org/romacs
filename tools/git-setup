#!/usr/bin/env python3
"""Set up a Romacs repository's local Git: once per repository.

Installs the reference-transaction hook (tools/hooks/) that keeps the trunk
to the merge queue, unless core.hooksPath points Git elsewhere, and removes
the merge drivers earlier versions installed for ledgers that are gone. Only
the repository's own config and hooks change.
"""
from pathlib import Path
import subprocess
import sys

RETIRED = ('merge.romacs-derived', 'merge.romacs-floors', 'merge.romacs-unsafe-floors')


def git(root, *args, check=True):
    return subprocess.run(['git', '-C', str(root), *args], check=check,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def setup(root):
    # What retired drivers installed: the derived artifacts' (bundled autoloads are no longer
    # committed) and the floors files' (the smells ratchet now measures the merge-base).
    for section in RETIRED:
        git(root, 'config', '--local', '--remove-section', section, check=False)
    git(root, 'config', '--local', '--unset', 'alias.merge-derived', check=False)
    hooks_path = git(root, 'config', 'core.hooksPath', check=False).stdout.strip()
    if hooks_path:
        print(f'core.hooksPath is {hooks_path}, so the reference-transaction hook is not installed.')
        return
    hook = Path(git(root, 'rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip()) / 'hooks/reference-transaction'
    hook.parent.mkdir(exist_ok=True)
    hook.write_bytes((Path(__file__).resolve().parent / 'hooks/reference-transaction').read_bytes())
    hook.chmod(0o755)
    print(f'Installed the hook {hook}; no global config changed.')


def main():
    if sys.argv[1:] not in ([], ['setup']):
        sys.exit(__doc__)
    try:
        setup(Path(git(Path.cwd(), 'rev-parse', '--show-toplevel').stdout.strip()))
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f'git-setup: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

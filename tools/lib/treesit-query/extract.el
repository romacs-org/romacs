;;; extract.el --- Record queries from the real ts modes -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(require 'treesit)
(setq treesit-enabled-modes t)
(with-temp-buffer
  (insert "1")
  (let ((captures (treesit-query-capture
                   (treesit-parser-root-node (treesit-parser-create 'json))
                   "(number) @a @b @c @d")))
    (unless (equal (mapcar #'car captures) '(a b c))
      (error "Corpus extraction requires the pinned C query engine"))
    (message "Verified pinned C query behavior before extracting mode queries")))
(defvar q-probe-queries (make-hash-table :test 'eq))
(defvar q-probe-owner nil)

(defun q-probe-record (language query)
  (let* ((source (if (treesit-compiled-query-p query) (treesit-query-source query) query))
         (expanded (if (stringp source) source (treesit-query-expand source))))
    (unless (assoc expanded (gethash language q-probe-queries))
      (push (list expanded q-probe-owner) (gethash language q-probe-queries)))))

(defun q-probe-capture (node query &rest _)
  (q-probe-record
   (cond ((treesit-compiled-query-p query) (treesit-query-language query))
         ((treesit-node-p node) (treesit-parser-language (treesit-node-parser node)))
         ((treesit-parser-p node) (treesit-parser-language node))
         ((symbolp node) node))
   query))

(defun q-probe-mode (mode text)
  (autoload-do-load (symbol-function mode) mode)
  (let ((q-probe-owner (file-relative-name
                        (symbol-file mode 'defun) (getenv "ROMACS_RUNTIME_ROOT"))))
    (with-temp-buffer
      (insert text)
      (funcall mode)
      (unless (eq major-mode mode)
        (error "Mode %s fell back to %s" mode major-mode))
      (dolist (setting treesit-font-lock-settings)
        (q-probe-record (treesit-font-lock-setting-language setting)
                        (treesit-font-lock-setting-query setting)))
      (dotimes (treesit-font-lock-level 5)
        (treesit-font-lock-recompute-features)
        (dolist (run (romacs-treesit--font-lock-runs))
          (q-probe-record (car run) (cadr run))))
      (indent-region (point-min) (point-max)))))

(let* ((directory (getenv "ROMACS_QUERY_SCRATCH"))
       (samples (with-temp-buffer
                  (insert-file-contents (expand-file-name "samples.json" directory))
                  (json-parse-buffer)))
       (modes '((bash . bash-ts-mode) (c . c-ts-mode) (cpp . c++-ts-mode)
                (css . css-ts-mode) (go . go-ts-mode) (html . mhtml-ts-mode)
                (java . java-ts-mode) (javascript . js-ts-mode)
                (json . json-ts-mode) (python . python-ts-mode)
                (rust . rust-ts-mode) (toml . toml-ts-mode)
                (tsx . tsx-ts-mode) (typescript . typescript-ts-mode)
                (yaml . yaml-ts-mode))))
  (advice-add 'treesit-query-capture :before #'q-probe-capture)
  (dolist (entry modes)
    (message "q-probe %s" (cdr entry))
    (q-probe-mode (cdr entry) (gethash (symbol-name (car entry)) samples)))
  (advice-remove 'treesit-query-capture #'q-probe-capture)
  (let ((out (make-hash-table :test 'equal)))
    (maphash (lambda (grammar queries)
               (when grammar
                 (puthash (symbol-name grammar) (vconcat (mapcar #'vconcat (reverse queries))) out)))
             q-probe-queries)
    (with-temp-file (expand-file-name "mode-queries.json" directory)
      (insert (json-serialize out)))))

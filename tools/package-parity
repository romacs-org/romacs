#!/usr/bin/env python3
"""Third-party package parity: Romacs against pinned GNU.

    package-parity fetch                 mirror every package's repository
    package-parity pin [NAME ...]        move revs to upstream's default branch
    package-parity run --romacs BIN --gnu BIN --out DIR [--only NAME ...]
    package-parity report RESULTS.json   the table
    package-parity compare OLD NEW       Romacs regressions from OLD to NEW (exit 1)

Packages and their pins: test/package-parity/packages.toml.  Mirrors live in
--cache (default $XDG_CACHE_HOME/romacs-package-parity), so a run installs
offline.  Every editor process gets a private HOME, XDG directories and TMPDIR.
"""
import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
import package_parity as pp


def git(*args, check=True):
    return subprocess.run(['git', *args], check=check, capture_output=True, text=True,
                          env=dict(os.environ, GIT_TERMINAL_PROMPT='0')).stdout.strip()


def has_commit(path, rev):
    return subprocess.run(['git', '-C', str(path), 'cat-file', '-e', rev + '^{commit}'],
                          capture_output=True).returncode == 0


def cache_dir(args):
    base = os.environ.get('XDG_CACHE_HOME') or str(Path.home() / '.cache')
    return Path(args.cache or Path(base) / 'romacs-package-parity').resolve()


def mirrors(packages, cache, fetch_missing):
    """Mirror paths by URL.  A missing mirror or pinned revision is fetched
    only when FETCH_MISSING; otherwise the run refuses, so it stays offline."""
    found = {}
    for url in sorted({p['url'] for p in packages.values()}):
        path = cache / 'mirrors' / pp.mirror_name(url)
        revs = {p['rev'] for p in packages.values() if p['url'] == url and p['rev']}
        if not path.is_dir():
            if not fetch_missing:
                raise SystemExit(f'no mirror of {url}: run package-parity fetch')
            path.parent.mkdir(parents=True, exist_ok=True)
            git('clone', '--quiet', '--mirror', url, str(path))
        elif not all(has_commit(path, rev) for rev in revs):
            if not fetch_missing:
                raise SystemExit(f'{url}: a pinned revision is missing from its mirror: run package-parity fetch')
            git('-C', str(path), 'fetch', '--quiet', '--prune', 'origin')
        missing = [rev for rev in revs if not has_commit(path, rev)]
        if missing:
            raise SystemExit(f'{url}: no commit {missing} upstream')
        found[url] = str(path)
    return found


def command_fetch(args):
    packages = pp.load_manifest(pp.MANIFEST.read_text())
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        urls = sorted({p['url'] for p in packages.values()})
        subsets = [{n: p for n, p in packages.items() if p['url'] == url} for url in urls]
        for url, result in zip(urls, pool.map(lambda s: mirrors(s, cache_dir(args), True), subsets)):
            print(f'{url} -> {result[url]}')
    return 0


def command_pin(args):
    text = pp.MANIFEST.read_text()
    packages = pp.load_manifest(text)
    found = mirrors(packages, cache_dir(args), True)
    names = args.names or sorted(packages)
    revisions = {}
    for name in names:
        path = found[packages[name]['url']]
        git('-C', path, 'fetch', '--quiet', '--prune', 'origin')
        revisions[name] = git('-C', path, 'rev-parse', 'HEAD^{commit}')
        print(f'{name:20} {packages[name]["rev"][:12] or "-":12} -> {revisions[name][:12]}')
    pp.MANIFEST.write_text(pp.set_revisions(text, revisions))
    return 0


def command_run(args):
    packages = pp.load_manifest(pp.MANIFEST.read_text())
    unpinned = [n for n, p in packages.items() if not p['rev']]
    if unpinned:
        raise SystemExit(f'unpinned packages: {unpinned}; run package-parity pin')
    order = pp.install_order(packages, args.only or None)
    found = mirrors({n: packages[n] for n in order}, cache_dir(args), args.fetch)
    out = Path(args.out).resolve()
    if out.exists() and any(out.iterdir()):
        # Reused checkouts would meet package-vc's overwrite prompt.
        raise SystemExit(f'{out} is not empty: each run takes a new --out')
    out.mkdir(parents=True, exist_ok=True)
    scratch = out / 'scratch'
    romacs = Path(args.romacs).resolve()
    lisp_dir = romacs.parent / 'lisp/gnu'
    editors = [dict(name='romacs', binary=str(romacs), lisp_dir=str(lisp_dir) if lisp_dir.is_dir() else None),
               dict(name='gnu', binary=str(Path(args.gnu).resolve()))]
    started = time.monotonic()
    results = dict(manifest=pp.MANIFEST.read_text(), editors={e['name']: pp.identity(e) for e in editors},
                   selector=pp.SELECTOR, packages={n: {} for n in order})
    print(f'installing {len(order)} packages in both editors', flush=True)
    with concurrent.futures.ThreadPoolExecutor(2) as pool:
        installs = list(pool.map(lambda e: pp.install_all(e, packages, order, found, scratch, args.timeout),
                                 editors))
    elpas = {}
    for editor, (elpa, result) in zip(editors, installs):
        elpas[editor['name']] = elpa
        for name, entry in result.items():
            results['packages'][name][editor['name']] = dict(install=entry)
    jobs = [(e, n) for n in order for e in editors
            if results['packages'][n][e['name']]['install'].get('ok')]
    print(f'measuring {len(jobs)} package/editor pairs, {args.jobs} at a time', flush=True)
    with concurrent.futures.ThreadPoolExecutor(args.jobs) as pool:
        futures = {pool.submit(pp.measure_package, e, packages[n], elpas[e['name']], scratch, args.timeout,
                               args.journey_timeout): (e, n)
                   for e, n in jobs}
        for future in concurrent.futures.as_completed(futures):
            editor, name = futures[future]
            results['packages'][name][editor['name']].update(future.result())
            print(f"  {editor['name']:6} measured {name}", flush=True)
    results['elapsed'] = round(time.monotonic() - started, 1)
    (out / 'results.json').write_text(json.dumps(results, indent=1, sort_keys=True))
    table = pp.report(results)
    (out / 'report.txt').write_text(table + '\n')
    print(table)
    return 0


def command_report(args):
    print(pp.report(json.loads(Path(args.results).read_text())))
    return 0


def command_compare(args):
    found = pp.regressions(json.loads(Path(args.old).read_text()), json.loads(Path(args.new).read_text()))
    print('\n'.join(found) if found else 'no Romacs regressions')
    return 1 if found else 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--cache', help='where the mirrors live')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('fetch')
    pin = sub.add_parser('pin')
    pin.add_argument('names', nargs='*')
    run = sub.add_parser('run')
    run.add_argument('--romacs', required=True)
    run.add_argument('--gnu', required=True)
    run.add_argument('--out', required=True)
    run.add_argument('--only', nargs='*', default=[])
    run.add_argument('--jobs', type=int, default=4)
    run.add_argument('--timeout', type=float, default=900, help='seconds per editor process')
    run.add_argument('--journey-timeout', type=float, default=180,
                     help='seconds per journey: one waiting for input must not hold the run')
    run.add_argument('--fetch', action='store_true', help='fetch a missing mirror or revision instead of refusing')
    rep = sub.add_parser('report')
    rep.add_argument('results')
    cmp = sub.add_parser('compare')
    cmp.add_argument('old')
    cmp.add_argument('new')
    args = parser.parse_args()
    return dict(fetch=command_fetch, pin=command_pin, run=command_run, report=command_report,
                compare=command_compare)[args.command](args)


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env python3
"""Run bundled Lisp packages' ERT suites on a prebuilt host, without Cargo.

As GNU's test/Makefile.in runs its own: each test file in a fresh process with
a private HOME, under SELECTOR, the default leaving out expensive and unstable
tests.  With neither --module nor --file, every bundled package with suites
runs.  A suite is a file under test/lisp that defines a test; the rest are
support files its suites require.
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
import json
import math
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'gnu-tests'))
sys.path.insert(0, str(ROOT / 'tools/lib'))
from ert_report import PREFIX, ReportError, parse_report
from bundled_autoloads import directories

SELECTOR_DEFAULT = '(not (or (tag :expensive-test) (tag :unstable)))'
TIMEOUT_DEFAULT = 600.0
TESTS = ROOT / 'test/lisp'
SCRUBBED = ('DISPLAY', 'WAYLAND_DISPLAY', 'DBUS_SESSION_BUS_ADDRESS', 'EMACSLOADPATH',
            'EMACS_TEST_JUNIT_REPORT', 'MAIL', 'MAILDIR', 'NOTMUCH_CONFIG', 'NOTMUCH_DATABASE')
EMPTY_SELECTION = 'empty or invalid selection inventory'
NOTHING = dict(selected=0, started=0, completed=0, passed=0, failed=0, skipped=0)
XDG = ('XDG_CONFIG_HOME', 'XDG_CACHE_HOME', 'XDG_DATA_HOME', 'XDG_STATE_HOME')


def is_suite(path):
    return b'(ert-deftest' in path.read_bytes()


def suites_under(directory):
    return sorted(p for p in directory.rglob('*.el') if is_suite(p))


def bundled_names(bases):
    """What a test directory or MODULE may name: bundled packages and libraries."""
    return {base.name for base in bases} | {p.stem for base in bases for p in base.glob('*.el')}


def packages(bases):
    """Test directories of bundled code; GNU's own run under gnu-tests."""
    names = bundled_names(bases)
    gnu = {p.name for p in (ROOT / 'lisp/gnu').iterdir()}
    return sorted(d for d in TESTS.iterdir() if d.is_dir() and d.name in names and d.name not in gnu)


def module_suites(module, bases):
    """Suites of a package directory, or of one library by the naming convention:
    NAME-tests.el, or PACKAGE-test-REST.el for the library PACKAGE-REST."""
    if module not in bundled_names(bases):
        return []
    if TESTS / module in packages(bases):
        return suites_under(TESTS / module)
    patterns = [module + '-tests.el', module + '-*-tests.el']
    package, _, rest = module.partition('-')
    if rest:
        patterns += [f'{package}-test-{rest}.el', f'{package}-test-{rest}-*.el']
    return sorted({p for pattern in patterns for p in TESTS.rglob(pattern) if is_suite(p)})


def all_suites(bases):
    return [p for d in packages(bases) for p in suites_under(d)]


def driver(path, selector):
    quote = json.dumps(str(path), ensure_ascii=False)
    reporter = (ROOT / 'gnu-tests/harness/romacs-real-ert-reporter.el').read_text()
    return (f"(setq load-prefer-newer t)\n(require 'ert)\n(load {quote} nil t t)\n"
            f"(setq ert-scoreboard-selector '{selector})\n(kill-emacs (progn {reporter}))\n")


def host_environment(home, binary):
    env = {k: v for k, v in os.environ.items() if k not in SCRUBBED}
    runtime = binary.parent / 'lisp/gnu'
    env.setdefault('ROMACS_LISP_DIR', str(runtime if runtime.is_dir() else ROOT / 'lisp/gnu'))
    env.update(HOME=str(home), TMPDIR=str(home), ROMACS_WORLD='off', ROMACS_COMPILED_LISP='off')
    for key in XDG:
        directory = home / key.lower()
        directory.mkdir()
        env[key] = str(directory)
    return env


def run_host(command, env, log, timeout):
    """The host's status, or None when it ran out of TIMEOUT.  Its output goes to
    a file: a descendant keeping it open cannot hold the run."""
    with log.open('wb') as sink:
        process = subprocess.Popen(command, stdout=sink, stderr=subprocess.STDOUT, env=env,
                                   cwd=ROOT, start_new_session=True)
    try:
        return process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        return None
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def verdict(output, status):
    """A file's result: its class, why when it did not finish, and its counts."""
    try:
        report = parse_report(output, status)
    except ReportError as error:
        # The selector left this file nothing to run: every test expensive, say.
        empty = str(error) == EMPTY_SELECTION
        return dict(NOTHING, status='empty' if empty else 'incomplete', reason=None if empty else str(error))
    counts, execution = report['summary'], report['execution']
    return dict(status='pass' if status == 0 else 'fail', reason=None,
                selected=execution['selected'], started=execution['started'],
                completed=execution['terminal'], passed=counts['passed'],
                failed=counts['failed'], skipped=counts['skipped'])


def run_suite(path, selector, binary, timeout, load_paths):
    with tempfile.TemporaryDirectory(prefix='romacs-ert-') as temp:
        home = Path(temp)
        script = home / 'driver.el'
        script.write_text(driver(path, selector))
        env = host_environment(home, binary)
        command = [str(binary), '-Q', '--batch']
        for directory in load_paths + [path.parent]:
            command += ['-L', str(directory)]
        started = time.monotonic()
        status = run_host(command + ['-l', str(script)], env, home / 'output', timeout)
        output = (home / 'output').read_text(encoding='utf-8', errors='replace')
    result = (dict(NOTHING, status='timeout', reason=f'no result within {timeout:g}s')
              if status is None else verdict(output, status))
    return dict(result, path=path, output=output, elapsed=time.monotonic() - started)


def shown(path):
    return path.relative_to(ROOT) if path.is_relative_to(ROOT) else path


def report(result, logs):
    """One line per file, its output too when it did not pass."""
    path = result['path']
    print(f"{result['status'].upper():10} {shown(path)}  {result['passed']}/{result['selected']}"
          f" skipped={result['skipped']} {result['elapsed']:.1f}s", flush=True)
    if logs:
        target = logs / (str(shown(path)).replace('/', '_') + '.log')
        target.write_text(result['output'], encoding='utf-8')
    if result['status'] not in ('pass', 'empty'):
        lines = [l for l in result['output'].split('\n') if not l.startswith(PREFIX)]
        print('\n'.join(lines), flush=True)
        if result['reason']:
            print(f"ERT incomplete: {shown(path)}: {result['reason']}", file=sys.stderr, flush=True)


def selection(args, bases):
    files = args.file or [Path(p) for p in shlex.split(os.environ.get('TEST_FILES', ''))]
    if files:
        return sorted({p.resolve() for p in files})
    if args.module:
        return module_suites(args.module, bases)
    return all_suites(bases)


def main():
    started = time.monotonic()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--module', default=os.environ.get('MODULE', ''))
    parser.add_argument('--list', action='store_true')
    parser.add_argument('--binary', default=os.environ.get('ROMACS_TEST_BINARY'))
    parser.add_argument('--selector', default=os.environ.get('SELECTOR') or SELECTOR_DEFAULT)
    parser.add_argument('--file', action='append', type=Path, default=[])
    parser.add_argument('--timeout', type=float, default=float(os.environ.get('EMACS_TEST_TIMEOUT') or TIMEOUT_DEFAULT),
                        help='Seconds for each test file')
    parser.add_argument('--jobs', type=int, default=int(os.environ.get('JOBS') or min(8, os.cpu_count() or 1)))
    parser.add_argument('--logs', type=Path, help='Keep each file\'s output in this directory')
    args = parser.parse_args()
    bases = directories(ROOT)
    if args.list:
        names = {d.name for d in packages(bases)}
        names |= {name for name in bundled_names(bases) if module_suites(name, bases)}
        print('\n'.join(sorted(names)))
        return 0
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        parser.error('timeout must be positive and finite')
    if args.jobs < 1:
        parser.error('jobs must be positive')
    files = selection(args, bases)
    if not files:
        parser.error('No suites selected; make check-list names the modules')
    if any(not p.is_file() or p.suffix != '.el' for p in files):
        parser.error('Every selected suite must be an existing .el file')
    target = Path(os.environ.get('CARGO_TARGET_DIR', ROOT / 'target'))
    binary = Path(args.binary or target / 'gate/romacs-vm-gui').expanduser().resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        parser.error('Prebuilt host missing; set ROMACS_TEST_BINARY to its executable')
    if args.logs:
        args.logs.mkdir(parents=True, exist_ok=True)
    print(f'ERT module={args.module or "all"} files={len(files)} selector={args.selector} '
          f'jobs={args.jobs} timeout={args.timeout:g}s host={binary}', flush=True)
    load_paths = directories(ROOT)
    with ThreadPoolExecutor(args.jobs) as pool:
        futures = [pool.submit(run_suite, p, args.selector, binary, args.timeout, load_paths) for p in files]
        results = []
        for future in futures:
            results.append(future.result())
            report(results[-1], args.logs)
    total = {key: sum(r[key] for r in results) for key in ('selected', 'started', 'completed', 'passed', 'failed', 'skipped')}
    classes = {name: sum(r['status'] == name for r in results) for name in ('fail', 'timeout', 'incomplete')}
    print(f"ERT complete: files={len(results)} selected={total['selected']} started={total['started']} "
          f"completed={total['completed']} passed={total['passed']} failed={total['failed']} "
          f"skipped={total['skipped']} failing-files={classes['fail']} timeouts={classes['timeout']} "
          f"incomplete={classes['incomplete']} elapsed={time.monotonic() - started:.2f}s")
    if any(classes.values()):
        return 1
    if total['selected'] == total['skipped']:
        print('ERT incomplete: All selected tests skipped; no test bodies completed', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

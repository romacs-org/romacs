;;; complete-gnu.el --- Full collector shape -*- lexical-binding: t; -*-
(setq gc-cons-threshold most-positive-fixnum gc-cons-percentage 1.0)
(defvar bench-head nil)
(defvar bench-keys nil)
(defvar bench-native nil)
(defvar bench-legacy nil)
(defvar bench-finalized 0)
(dotimes (_ 4096) (push (vector (make-string 1024 ?x) 17) bench-head))
(defun bench-seed ()
  (setq bench-keys nil bench-finalized 0 buffer-undo-list nil
        bench-native (make-hash-table :test 'eq :weakness 'key)
        bench-legacy (make-hash-table :test 'eq :weakness 'key))
  (dotimes (i 48)
    (let ((key (cons nil nil)) (value (vector i)))
      (when (< i 16) (push key bench-keys))
      (when (>= i 32) (make-finalizer (lambda () (ignore key) (setq bench-finalized (1+ bench-finalized)))))
      (puthash key value bench-native) (puthash key value bench-legacy)))
  (dotimes (i 16)
    (let ((marker (make-marker)))
      (when (= 0 (mod i 2)) (push marker bench-keys))
      (push (cons marker i) buffer-undo-list)
      (vector nil)))
  nil)
(with-temp-buffer
  (let (times live)
    (dotimes (_ 7)
      (bench-seed)
      (let ((start (float-time)))
        (setq live (garbage-collect))
        (push (- (float-time) start) times))
      (unless (and (= 32 (hash-table-count bench-native)) (= 32 (hash-table-count bench-legacy))
                   (= 8 (length buffer-undo-list)) (= 16 bench-finalized))
        (error "special phases not exercised: %S" (list (hash-table-count bench-native) (hash-table-count bench-legacy) (length buffer-undo-list) bench-finalized))))
    (setq times (sort times #'<))
    (let ((bytes 0))
      (dolist (row live) (setq bytes (+ bytes (* (nth 1 row) (nth 2 row)))))
      (princ (format "GNU complete full: accounted=%d median_ns=%.0f ns_per_live_mib=%.0f cycles=7 weak=2x48 undo=16 doomed=16\n" bytes (* 1e9 (nth 3 times)) (/ (* 1e9 (nth 3 times)) (/ bytes 1048576.0)))))))

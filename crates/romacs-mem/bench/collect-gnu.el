;; Preliminary strong-only shape: 4096 strings(1024), two-slot vectors, cons spine.
(setq gc-cons-threshold most-positive-fixnum gc-cons-percentage 1.0)
(defvar bench-head nil)
(dotimes (_ 4096) (push (vector (make-string 1024 ?x) 17) bench-head))
(let (times live)
  (dotimes (_ 7)
    (let ((start (float-time)))
      (setq live (garbage-collect))
      (push (- (float-time) start) times)))
  (setq times (sort times #'<))
  (let ((bytes 0))
    (dolist (row live) (setq bytes (+ bytes (* (nth 1 row) (nth 2 row)))))
    (princ (format "GNU strong-only full: accounted=%d median_ns=%.0f ns_per_live_mib=%.0f\n" bytes (* 1e9 (nth 3 times)) (/ (* 1e9 (nth 3 times)) (/ bytes 1048576.0))))))

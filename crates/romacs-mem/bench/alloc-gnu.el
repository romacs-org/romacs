;;; GNU constructor reference, not an equivalence gate for S2 raw storage.
(setq gc-cons-threshold most-positive-fixnum gc-cons-percentage 1.0)
(let ((n 10000000))
  (dolist (shape '((cons 0) (string 6) (vector 2)))
    (garbage-collect)
    (let* ((kind (car shape)) (slot (cadr shape))
           (before (nth slot (memory-use-counts))) (start (current-time)))
      (dotimes (_ n)
        (pcase kind ('cons (cons nil nil)) ('string (make-string 16 ?x)) ('vector (make-vector 2 nil))))
      (let ((elapsed (float-time (time-subtract (current-time) start)))
            (count (- (nth slot (memory-use-counts)) before)))
        (unless (>= count n) (error "No constructor allocations: %S %S" kind count))
        (princ (format "gnu-constructor\t%s\t%d\t%.6f\t%d\n" kind n elapsed count))))))

;;; S5 oracle -*- lexical-binding: t; -*-
;; Seeding helpers return before GC to avoid conservative local roots.
(setq gc-cons-threshold most-positive-fixnum gc-cons-percentage 1.0)
(defvar s5-live nil)
(defvar s5-table nil)
(defun s5-seed-undo (mask nonfix dotted)
  (setq s5-live nil buffer-undo-list (if dotted 99 nil))
  (dotimes (j 4)
    (let* ((i (- 3 j)) (m (make-marker))
           (data (if nonfix (list i) i)))
      (when (/= 0 (logand mask (ash 1 i))) (push m s5-live))
      (push (cons m data) buffer-undo-list)))
  nil)
(with-temp-buffer
  (dolist (mask '(0 1 2 5 6 8 15))
    (dolist (nonfix '(nil t))
      (dolist (dotted '(nil t))
        (s5-seed-undo mask nonfix dotted)
        (garbage-collect)
        (let ((tail buffer-undo-list) (out nil))
          (while (consp tail)
            (push (if nonfix (car (cdar tail)) (cdar tail)) out)
            (setq tail (cdr tail)))
          (unless (equal tail (if dotted 99 nil)) (error "lost dotted tail"))
          (princ (format "undo %d %d %d %s\n" mask (if nonfix 1 0) (if dotted 1 0)
                         (mapconcat #'number-to-string (nreverse out) ","))))))))
(defun s5-seed-weak (policy mask)
  (setq s5-live nil s5-table (make-hash-table :test 'eq :weakness policy))
  (let ((key (make-symbol "key")) (value (make-symbol "value")))
    (puthash key value s5-table)
    (when (/= 0 (logand mask 1)) (push key s5-live))
    (when (/= 0 (logand mask 2)) (push value s5-live)))
  nil)
(dolist (policy '(key value key-or-value key-and-value))
  (dotimes (mask 4)
    (s5-seed-weak policy mask)
    (garbage-collect)
    (princ (format "weak %s %d %d\n" policy mask (hash-table-count s5-table)))))
(defvar s5-other nil)
(defun s5-seed-chain ()
  (let ((a (cons nil nil)) (b (cons nil nil)) (c (cons nil nil))
        (late (make-hash-table :test 'eq :weakness 'key)))
    (setq s5-live (list a) s5-table (make-hash-table :test 'eq :weakness 'key)
          s5-other (make-hash-table :test 'eq :weakness 'key))
    (puthash b c late) (puthash a b s5-other) (puthash a late s5-table))
  nil)
(defun s5-chain-count () (hash-table-count (gethash (car s5-live) s5-table)))
(s5-seed-chain)
(garbage-collect)
(princ (format "chain live %d %d %d\n" (hash-table-count s5-table) (hash-table-count s5-other) (s5-chain-count)))
(setq s5-live nil)
(garbage-collect)
(princ (format "chain dead %d %d\n" (hash-table-count s5-table) (hash-table-count s5-other)))
(defvar s5-ran 0)
(defun s5-seed-finalizers ()
  (setq s5-ran 0)
  (let* ((cell (vector nil))
         (first (make-finalizer (lambda () (ignore (aref cell 0)) (setq s5-ran (1+ s5-ran))))))
    (aset cell 0 (make-finalizer (lambda () (ignore first) (setq s5-ran (1+ s5-ran))))))
  nil)
(s5-seed-finalizers)
(garbage-collect)
(princ (format "finalizers first %d\n" s5-ran))
(setq s5-ran 0)
(garbage-collect)
(princ (format "finalizers again %d\n" s5-ran))

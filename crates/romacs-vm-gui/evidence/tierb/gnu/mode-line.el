;; GNU 32.0.50 mode-line oracle for the VM2 mode-line engine (tty, -Q).
;; Run: OUT=file emacs -Q -nw -l gtb-gnu-ml-wrap.el   (writes after startup)
(defun ml-out (fmt &rest args)
  (append-to-file (concat (apply #'format fmt args) "\n") nil (getenv "OUT")))
(defun ml (fmt) (substring-no-properties (format-mode-line fmt)))
(defvar ml-specs
  '("%b" "%f" "%*" "%+" "%&" "%l" "%c" "%C" "%p" "%P" "%o" "%q" "%i" "%I" "%n" "%m"
    "%z" "%Z" "%@" "%e" "%[" "%]" "%%" "%s" "%M" "%F"
    "%5l|" "%3c|" "%8p|" "%2b|" "%12b|" "%6i|" "%6I|" "%-8l" "x%7%y"))
;; Pin the probe window to 23 lines (22 text + mode line) whatever the tty.
(delete-other-windows)
(split-window nil 23)
(switch-to-buffer (get-buffer-create "probe"))
(fundamental-mode)
(dotimes (i 200) (insert (if (= i 2) "κόσμε\tx\n" (format "line %d\n" (1+ i)))))
(set-buffer-modified-p nil)
(ml-out "GEOMETRY body=%S total=%S" (window-body-height) (window-total-height))
(defun ml-case (label start-line point-line &optional eol)
  (set-window-start nil (save-excursion (goto-char (point-min)) (forward-line (1- start-line)) (point)))
  (goto-char (point-min)) (forward-line (1- point-line)) (when eol (end-of-line))
  (redisplay t)
  (ml-out "CASE %s start=%S point=%S window-end=%S" label (window-start) (point) (window-end))
  (dolist (s ml-specs) (ml-out "  %S => %S" s (ml s))))
(ml-case "A" 1 3 t)
(ml-case "B" 94 100)
(ml-case "C" 190 201)
(insert "z")
(ml-case "D-modified" 94 100)
(let ((buffer-read-only t)) (ml-out "  RO-modified %S" (ml "%*%+%&")))
(set-buffer-modified-p nil)
(let ((buffer-read-only t)) (ml-out "  RO-clean %S" (ml "%*%+%&")))
(narrow-to-region 20 60)
(ml-case "E-narrow" 1 2)
(widen)
(narrow-to-region 200 1500)
(ml-case "F-narrow-scrolled" 30 40)
(widen)
(ml-out "CONSTRUCTS")
(defvar ml-risky-free (list "R" (list :eval "E") (list :propertize "P" 'face 'bold)))
(defvar ml-risky-marked (list "R" (list :eval "E") (list :propertize "P" 'face 'bold)))
(put 'ml-risky-marked 'risky-local-variable t)
(defvar ml-str "%b")
(dolist (f '(("a" "b" "c")
             (buffer-read-only "RO" "RW")
             (ml-unbound-var "yes" "no")
             (ml-unbound-var "yes")
             (t "T" "F")
             (nil "T" "F")
             (-5 "abcdefgh")
             (5 "ab")
             (-3 "%b")
             (12 "%b")
             (3 . "ab")
             ("" (-4 "%b") "|" (6 "x") "|")
             ("" (8 (-3 "abcdef")) "|")
             ("" (-6 (10 "ab")) "|")
             (:eval (concat "E" "V"))
             (:propertize "P" face bold)
             ("" ml-str)
             ("" ml-risky-free)
             ("" ml-risky-marked)
             42
             ("" 42)
             (foo . bar)
             ("" (:eval 7))
             ("%-" "|")
             ("" mode-name)))
  (ml-out "  %S => %S" f (ml f)))
(ml-out "MODE-NAME %S" mode-name)
(kill-emacs 0)

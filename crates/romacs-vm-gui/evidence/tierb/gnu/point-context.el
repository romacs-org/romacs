;; Run: OUT=file emacs -Q -nw -l point-context.el (tty; writes, then exits).
(switch-to-buffer (get-buffer-create "point-probe"))
(insert "aaa\nbbb\nccc\nddd\n")
(goto-char 1)
(setq real-window (selected-window) lower (split-window-below))
(set-window-point lower 9)
(setq seen nil mode-line-format '((:eval (progn (push (format "%d/%d" (point) (window-point)) seen) "SELF"))))
(force-mode-line-update t)
(run-with-timer 1 nil (lambda ()
  (let ((observed seen) (restored (list (eq real-window (selected-window)) (point) (window-point) (window-point lower))))
    (setq mode-line-format nil)
    (with-temp-file (getenv "OUT")
      (prin1 (list :revision emacs-repository-version :seen observed :restored restored) (current-buffer)) (terpri)))
  (kill-emacs 0)))

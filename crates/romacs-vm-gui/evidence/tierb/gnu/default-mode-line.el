;; GNU -Q default mode line, *scratch* and a fundamental-mode buffer, tty 80x25.
(with-temp-file (getenv "OUT")
  (let ((w (selected-window)))
    (insert (format "scratch: %S\n" (substring-no-properties (format-mode-line mode-line-format nil w))))
    (insert (format "line-number-mode=%S column-number-mode=%S\n" line-number-mode column-number-mode))
    (with-current-buffer (get-buffer-create "probe")
      (dotimes (i 200) (insert (format "line %d\n" (1+ i))))
      (goto-char (point-min)) (forward-line 99))
    (set-window-buffer w "probe")
    (with-selected-window w (goto-char (point-min)) (forward-line 99) (recenter))
    (redisplay t)
    (insert (format "probe@100: %S\n" (substring-no-properties (format-mode-line mode-line-format nil w (get-buffer "probe")))))
    (split-window-below)
    (redisplay t)
    (insert (format "split-below: heights %S %S total %S\n" (window-total-height w) (window-total-height (next-window w)) (frame-height)))
    (delete-other-windows w)
    (split-window-right)
    (redisplay t)
    (insert (format "split-right: widths %S %S total %S\n" (window-total-width w) (window-total-width (next-window w)) (frame-width)))
    (insert (format "other-mode-line: %S\n" (substring-no-properties (format-mode-line mode-line-format nil (next-window w)))))))
(kill-emacs 0)

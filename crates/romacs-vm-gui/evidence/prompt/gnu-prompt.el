(require 'ert-x)
(defvar seen nil)
(defun rec () (push (buffer-string) seen))
(add-hook 'minibuffer-setup-hook (lambda () (rec) (add-hook 'post-command-hook #'rec nil t)))
(let ((r (ert-simulate-keys (kbd "a b c RET") (read-from-minibuffer "Name: "))))
  (princ (format "RESULT %S\nCONTENTS %S\n" r (reverse seen))))
(setq seen nil)
(let ((r (condition-case q (ert-simulate-keys (kbd "a C-g") (read-from-minibuffer "P: ")) (quit (list 'quit q)))))
  (princ (format "CG %S\nCONTENTS %S\n" r (reverse seen))))
(setq seen nil)
(let ((r (ert-simulate-keys (kbd "x DEL y RET") (read-string "S: "))))
  (princ (format "DEL %S\nCONTENTS %S\n" r (reverse seen))))

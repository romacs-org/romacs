;;; gnudiff.el --- Stage-P oracle transport -*- lexical-binding: t; -*-
;; Flat tab-delimited typed tokens, no Lisp reader on the Rust side.
;; Cases and evaluated arguments must be acyclic finite value trees.

(defun gnudiff-hex (bytes)
  (mapconcat (lambda (b) (format "%02x" b)) (string-to-list bytes) ""))

(defun gnudiff-float-bits (v)
  ;; frexp/ldexp preserve every finite binary64 bit, including subnormals.
  ;; Lisp cannot inspect NaN payloads: refuse rather than invent parity.
  (when (isnan v) (error "gnudiff: NaN payload transport unsupported"))
  (let* ((negative (string-prefix-p "-" (number-to-string v)))
         (v (abs v))
         (parts (frexp v))
         (exponent (+ 1022 (cdr parts)))
         (bits (cond ((= v 1.0e+INF) (ash 2047 52))
                     ((= v 0.0) 0)
                     ((<= exponent 0) (truncate (ldexp v 1074)))
                     (t (logior (ash exponent 52)
                                (- (truncate (ldexp (car parts) 53)) (ash 1 52)))))))
    (format "f%016x" (logior bits (if negative (ash 1 63) 0)))))

(defun gnudiff-internal-bytes (string)
  ;; `emacs-internal' writes eight-bit chars as single bytes; GNU stores C0/C1 xx.
  (if (not (multibyte-string-p string))
      string
    (mapconcat (lambda (c)
                 (if (> c #x3fff7f)
                     (unibyte-string (logior #xc0 (logand (ash c -6) 1))
                                     (logior #x80 (logand c #x3f)))
                   (encode-coding-string (string c) 'utf-8-emacs t)))
               string "")))

(defun gnudiff-encode (v &optional parents)
  (cond
   ((integerp v)
    (unless (fixnump v) (error "gnudiff: bignum unsupported"))
    (list (format "i%d" v)))
   ((floatp v) (list (gnudiff-float-bits v)))
   ((stringp v)
    (list (concat "s" (if (multibyte-string-p v) "m" "u")
                  (gnudiff-hex (gnudiff-internal-bytes v)))))
   ((symbolp v) (list (concat "y" (gnudiff-hex (encode-coding-string (symbol-name v) 'utf-8 t)))))
   ((or (consp v) (vectorp v))
    (when (memq v parents) (error "gnudiff: circular argument/result unsupported at stage P"))
    (let ((parents (cons v parents)))
      (if (vectorp v)
          (cons (format "v%d" (length v))
                (apply #'append (mapcar (lambda (x) (gnudiff-encode x parents)) v)))
        ;; A cons token also preserves dotted lists, unlike a length encoding.
        (append '("c") (gnudiff-encode (car v) parents) (gnudiff-encode (cdr v) parents)))))
   (t (error "gnudiff: unsupported value %S" v))))

(defun gnudiff-file (file)
  (with-temp-buffer
    (set-syntax-table emacs-lisp-mode-syntax-table)
    (insert-file-contents file)
    (goto-char (point-min))
    (while (progn (forward-comment (point-max)) (not (eobp)))
      (let ((form (read (current-buffer))))
        (unless (and (eq (car-safe form) 'case) (symbolp (nth 1 form)) (symbolp (nth 2 form)))
          (error "gnudiff: expected (case NAME FN ARG...)"))
        (let* ((args (mapcar (lambda (arg) (eval arg t)) (nthcdr 3 form)))
               (argument-tokens (apply #'append (mapcar #'gnudiff-encode args)))
               (result (condition-case err (cons 'ok (apply (nth 2 form) args))
                         (error (cons 'error err))))
               (tokens (append (list "case" (gnudiff-hex (encode-coding-string (symbol-name (nth 1 form)) 'utf-8 t))
                                     (gnudiff-hex (encode-coding-string (symbol-name (nth 2 form)) 'utf-8 t))
                                     (format "%d" (length args)))
                               argument-tokens
                               (if (eq (car result) 'ok)
                                   (cons "ok" (gnudiff-encode (cdr result)))
                                 (append '("error") (gnudiff-encode (cadr result))
                                         (gnudiff-encode (cddr result)))))))
          (princ (mapconcat #'identity tokens "\t")) (princ "\n"))))))

(defun gnudiff-text-run (mb init ops)
  (with-temp-buffer
    (set-buffer-multibyte mb) (insert init)
    (let ((markers nil) (results nil) (tick (buffer-modified-tick))
          (ctick (buffer-chars-modified-tick)))
      (dolist (op ops)
        (let ((a (nth 1 op)) (b (nth 2 op)) (c (nth 3 op)))
          (pcase (car op)
            ('ins (goto-char a) (insert b))
            ('ins-bm (goto-char a) (insert-before-markers b))
            ('del (delete-region a b))
            ('rep (goto-char a) (looking-at (regexp-quote (buffer-substring a b)))
                  (replace-match c t t))
            ('mk (setq markers (append markers (list (copy-marker a b)))))
            ('mset (set-marker (nth a markers) b))
            ('mtype (set-marker-insertion-type (nth a markers) b))
            ('fl (goto-char a) (let ((short (forward-line b)))
                                (push (vector short (point)) results)))
            ('b2p (push (byte-to-position a) results)))))
      (let ((positions (number-sequence 1 (point-max))))
        (vector (gnudiff-internal-bytes (buffer-string))
                (vconcat (mapcar #'marker-position markers))
                (vconcat (mapcar #'position-bytes positions))
                (- (buffer-modified-tick) tick) (- (buffer-chars-modified-tick) ctick)
                (vconcat (mapcar #'line-number-at-pos positions))
                (vconcat (nreverse results)))))))

;; A header makes stale/incompatible cache data fail closed.
(princ "gnudiff-1\n")
(dolist (file command-line-args-left) (gnudiff-file file))
(setq command-line-args-left nil)

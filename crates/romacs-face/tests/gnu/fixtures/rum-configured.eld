;; GNU oracle: the configured Rum look; tests/gnu/rum-configured.el.
(:emacs-version "32.0.50"
 :modus-version "5.3.0"
 :notmuch-version "0.40"
 :enabled (rum)
 :init-only (org-modern-symbol variable-pitch)
 :default (:family "Iosevka" :foundry "default" :width normal :height 120 :weight normal :slant normal :underline nil :overline nil :extend nil :strike-through nil :box nil :inverse-video nil :foreground "#d4c5a0" :background "#000000" :stipple nil :inherit nil)

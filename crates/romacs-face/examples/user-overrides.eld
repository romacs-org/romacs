;; One explicit user override value, composed when building any theme.
;; Ported face preferences only; no Custom variables or Custom forms.
((default :height 120 :family "Iosevka")
 (fringe :background "#000000" :foreground "#000000")
 (italic :inherit default :family "Iosevka" :slant italic)
 (org-modern-symbol :inherit default :family "Iosevka Aile")
 (variable-pitch :inherit default :family "Iosevka")
 (window-divider :background "#000000" :foreground "#000000")
 (window-divider-first-pixel :background "#000000" :foreground "#000000")
 (window-divider-last-pixel :background "#000000" :foreground "#000000"))

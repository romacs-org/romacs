romacs-padding|Romacs padding bytes,
    cols#80, lines#24, colors#8, pb#1, pad=.,
romacs-padding-flow|Romacs flow control suppresses optional padding,
    xon, use=romacs-padding,
romacs-padding-high|Romacs padding baud threshold,
    pb#19200, use=romacs-padding,
romacs-padding-sleep|Romacs padding without pad character,
    npc, use=romacs-padding,
romacs-padding-other|Romacs different padding character,
    pad=+, use=romacs-padding,

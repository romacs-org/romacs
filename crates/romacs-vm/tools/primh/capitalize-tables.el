;;; capitalize-tables.el --- GNU's case and word tables as Rust data
;;
;; Run by the pinned GNU, so the tables are GNU's and not the host's Unicode
;; tables: `CAPITALIZE_TABLE_OUTPUT=src/prims/capitalize-tables.in emacs
;; --batch -l tools/primh/capitalize-tables.el' from crates/romacs-vm.
(let ((coding-system-for-write 'utf-8-unix)
      (print-escape-nonascii t))
  (with-temp-buffer
    (insert "// Generated by capitalize-tables.el against GNU 45b0f7699df.\n")
    (insert "// (code, simple title, full title, full lowercase).\n")
    (insert "pub(super) const CASES: &[(u32, u32, &[u32], &[u32])] = &[\n")
    (dotimes (c #x110000)
      (let* ((s (string c)) (title (capitalize s)) (lower (downcase s)) (single (capitalize c)))
        (unless (and (equal s title) (equal s lower) (= c single))
          (insert (format "    (%d, %d, &[%s], &[%s]),\n" c single
                          (mapconcat #'number-to-string (string-to-list title) ", ")
                          (mapconcat #'number-to-string (string-to-list lower) ", "))))))
    (insert "];\n")
    (insert "pub(super) const WORD_RANGES: &[(u32, u32, u8)] = &[\n")
    (let ((start 0) (last nil))
      (dotimes (c #x400000)
        (let* ((syntax (char-syntax c))
               (class (cond ((= syntax ?w) 1) ((= syntax ?_) 2) (t 0))))
          (unless (equal class last)
            (when last (insert (format "    (%d, %d, %d),\n" start (1- c) last)))
            (setq start c last class))))
      (insert (format "    (%d, %d, %d),\n" start #x3fffff last)))
    (insert "];\n")
    (write-region (point-min) (point-max) (getenv "CAPITALIZE_TABLE_OUTPUT") nil 'silent)))

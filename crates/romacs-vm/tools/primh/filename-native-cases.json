[
  {
    "id": "directory-sorted",
    "source": "(directory-files \"@ROOT@\")"
  },
  {
    "id": "directory-full",
    "source": "(directory-files \"@ROOT@/\" t)"
  },
  {
    "id": "directory-regex",
    "source": "(directory-files \"@ROOT@\" nil \"\\\\.el\\\\'\")"
  },
  {
    "id": "directory-case-sensitive",
    "source": "(let ((case-fold-search t)) (directory-files \"@ROOT@\" nil \"ALPHA\"))"
  },
  {
    "id": "directory-count-zero",
    "source": "(directory-files \"@ROOT@\" nil nil nil 0)"
  },
  {
    "id": "directory-count-one",
    "source": "(length (directory-files \"@ROOT@\" nil nil nil 1))"
  },
  {
    "id": "directory-nosort-count",
    "source": "(length (directory-files \"@ROOT@\" nil nil t 3))"
  },
  {
    "id": "directory-bad-count",
    "source": "(directory-files \"@ROOT@\" nil nil nil -1)"
  },
  {
    "id": "directory-bad-match",
    "source": "(directory-files \"@ROOT@\" nil 2)"
  },
  {
    "id": "directory-bad-directory",
    "source": "(directory-files 2)"
  },
  {
    "id": "directory-missing",
    "source": "(directory-files \"@ROOT@/missing\")"
  },
  {
    "id": "directory-not-directory",
    "source": "(directory-files \"@ROOT@/alpha\")"
  },
  {
    "id": "directory-nosort-set",
    "source": "(sort (directory-files \"@ROOT@\" nil nil t) 'string-lessp)"
  },
  {
    "id": "directory-match-data",
    "source": "(progn (string-match \"b\" \"abc\") (directory-files \"@ROOT@\" nil \"alpha\") (match-data))"
  },
  {
    "id": "substitute-0",
    "source": "(substitute-in-file-name \"plain\")"
  },
  {
    "id": "substitute-1",
    "source": "(substitute-in-file-name \"a//b\")"
  },
  {
    "id": "substitute-2",
    "source": "(substitute-in-file-name \"a///b\")"
  },
  {
    "id": "substitute-3",
    "source": "(substitute-in-file-name \"a/~b\")",
    "unsupported": "named-user embedded filename lookup"
  },
  {
    "id": "substitute-4",
    "source": "(substitute-in-file-name \"a/~\")"
  },
  {
    "id": "substitute-5",
    "source": "(substitute-in-file-name \"a/~/b\")"
  },
  {
    "id": "substitute-6",
    "source": "(substitute-in-file-name \"/a//b/~user/c\")",
    "unsupported": "named-user embedded filename lookup"
  },
  {
    "id": "substitute-7",
    "source": "(substitute-in-file-name \"$$HOME\")"
  },
  {
    "id": "substitute-8",
    "source": "(substitute-in-file-name \"$HOME\")"
  },
  {
    "id": "substitute-9",
    "source": "(substitute-in-file-name \"${HOME}\")"
  },
  {
    "id": "substitute-10",
    "source": "(substitute-in-file-name \"/a/./b/../c\")"
  },
  {
    "id": "substitute-11",
    "source": "(substitute-in-file-name \"//root\")"
  },
  {
    "id": "substitute-12",
    "source": "(substitute-in-file-name \"a/~~x\")",
    "unsupported": "named-user embedded filename lookup"
  },
  {
    "id": "substitute-identity",
    "source": "(let ((s (copy-sequence \"plain\"))) (eq s (substitute-in-file-name s)))"
  },
  {
    "id": "substitute-type",
    "source": "(substitute-in-file-name 2)"
  },
  {
    "id": "directory-missing-trailing",
    "source": "(directory-files \"@ROOT@/missing/\")"
  },
  {
    "id": "directory-nul",
    "source": "(condition-case e (directory-files (string 47 0)) (wrong-type-argument (list (car e) (car (cdr e)) (equal (car (cdr (cdr e))) (string 47 0)))))"
  },
  {
    "id": "directory-bad-regexp",
    "source": "(directory-files \"@ROOT@\" nil \"[\")"
  },
  {
    "id": "substitute-raw-bytes",
    "source": "(let ((s (substitute-in-file-name (unibyte-string 255 97 47 47 98)))) (list (equal s \"/b\") (multibyte-string-p s)))"
  },
  {
    "id": "directory-result-multibyte",
    "source": "(list (multibyte-string-p (car (directory-files \"@ROOT@\" nil \"^alpha$\"))) (multibyte-string-p (car (directory-files \"@ROOT@\" nil \"^é$\"))))"
  },
  {
    "id": "directory-full-result-multibyte",
    "source": "(list (multibyte-string-p (car (directory-files \"@ROOT@\" t \"^alpha$\"))) (multibyte-string-p (car (directory-files \"@ROOT@\" t \"^é$\"))))"
  },
  {
    "id": "substitute-tilde-nul-before-helper",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) s)) (equal (substitute-in-file-name (string 97 47 126 0 98)) (string 126 0 98)))"
  },
  {
    "id": "substitute-tilde-nul-after-helper",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) (string 97 47 126 0 98))) (equal (substitute-in-file-name \"x\") (string 126 0 98)))"
  },
  {
    "id": "helper-order",
    "source": "(let (seen) (defalias 'substitute-env-in-file-name (lambda (s) (setq seen s) \"prefix//after/~/final\")) (list (substitute-in-file-name \"before//input\") seen))"
  },
  {
    "id": "helper-error",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) (signal 'file-error (list \"helper failed\" s)))) (substitute-in-file-name \"before//input\"))"
  },
  {
    "id": "helper-type",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) 42)) (substitute-in-file-name \"input\"))"
  },
  {
    "id": "helper-once",
    "source": "(let ((calls 0)) (defalias 'substitute-env-in-file-name (lambda (s) (setq calls (1+ calls)) \"prefix//$$HOME\")) (list (substitute-in-file-name \"before//input\") calls))"
  },
  {
    "id": "helper-identity",
    "source": "(let ((s (copy-sequence \"input\"))) (defalias 'substitute-env-in-file-name (lambda (s) s)) (eq s (substitute-in-file-name s)))"
  },
  {
    "id": "helper-same-object-mutation",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) (aset s 1 47) s)) (substitute-in-file-name \"axb\"))"
  },
  {
    "id": "helper-original-multibyte",
    "source": "(progn (defalias 'substitute-env-in-file-name (lambda (s) (string-to-multibyte \"a//b\"))) (let ((s (substitute-in-file-name (unibyte-string 120)))) (list (equal s \"/b\") (multibyte-string-p s))))"
  },
  {
    "id": "real-helper-dollar",
    "real_helper": true,
    "source": "(equal (substitute-in-file-name \"before//$$UNDEFINED/~/result\") \"~/result\")"
  },
  {
    "id": "real-helper-env",
    "real_helper": true,
    "source": "(let ((process-environment (list \"ROMACS_FILENAME_CASE=prefix//final\"))) (equal (substitute-in-file-name \"before/$ROMACS_FILENAME_CASE\") \"/final\"))",
    "candidate_error": "(void-function getenv-internal)"
  },
  {
    "id": "real-helper-undefined",
    "real_helper": true,
    "source": "(let ((process-environment nil)) (equal (substitute-in-file-name \"$ROMACS_FILENAME_UNDEFINED\") \"$ROMACS_FILENAME_UNDEFINED\"))",
    "candidate_error": "(void-function getenv-internal)"
  },
  {
    "id": "real-helper-getenv-fixture",
    "real_helper": true,
    "source": "(progn (defalias 'getenv (lambda (&rest args) \"prefix//from-env\")) (equal (substitute-in-file-name \"before/$ROMACS_FILENAME_CASE\") \"/from-env\"))"
  }
]

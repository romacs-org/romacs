;; Read-only GNU behavioral oracle for eval_data.rs/eval_buffer.rs.
(setq print-escape-newlines t)
(defun s124-check (name form expected)
  (let ((actual (condition-case e (prin1-to-string (eval form t))
                  (error (format "ERROR:%s" (car e))))))
    (princ (format "%s\t%s\t%s\t%s\n" name (if (equal actual expected) "PASS" "FAIL") actual expected))))
(defun s124-error (name form)
  (let ((actual (condition-case e (progn (eval form t) nil) (error (car e)))))
    (princ (format "%s\t%s\t%S\n" name (if actual "PASS" "FAIL") actual))))
(princ (format "GNU %s\n" emacs-version))
(s124-check "data:equal-deep" '(list (equal '(a (2 . 3)) '(a (2 . 3))) (equal [a (2)] [a (2)]) (equal (copy-sequence "text") "text") (equal '(1) '(2)) (equal 1 1.0) (equal 1.5 1.5)) "(t t t nil nil t)")
(s124-error "data:equal-arity" '(equal 1))
(s124-check "data:equal-cycle-properties" '(let ((a (list 1)) (b (list 1)) (s (copy-sequence "a"))) (setcdr a a) (setcdr b b) (put-text-property 0 1 'face 'bold s) (list (equal a b) (equal s "a"))) "(t t)")
(s124-check "data:min" '(list (min 7) (min 4 2 8) (min 1 2.5) (min 4 1.5) (min 9007199254740993 9007199254740992) (min 1.0 1) (min 1 1.0)) "(7 2 1 1.5 9007199254740992 1.0 1)")
(s124-error "data:min-zero" '(min))
(s124-error "data:min-type" '(min 1 'bad))
(s124-check "data:append-sharing" '(let ((a (list 1 2)) (b (list 3))) (let ((r (append a b))) (list r (eq r a) (eq (cdr (cdr r)) b) (append '(4) 'tail) (append) (eq (append b) b)))) "((1 2 3) nil t (4 . tail) nil t)")
(s124-error "data:append-improper" '(append '(1 . 2) nil))
(s124-check "data:append-sequences" '(append [1 2] "λ" (unibyte-string 255) '(end)) "(1 2 955 255 end)")
(s124-check "data:prin1-nested" '(prin1-to-string '(a ["quoted"] . tail)) "\"(a [\\\"quoted\\\"] . tail)\"")
(s124-check "data:prin1-noescape" '(prin1-to-string '("a" . "b") t) "\"(a . b)\"")
(s124-error "data:prin1-arity" '(prin1-to-string))
(s124-check "data:print-newlines-nil" '(let ((print-escape-newlines nil)) (prin1-to-string "a\nb")) "\"\\\"a\\nb\\\"\"")
(s124-check "data:print-newlines-t" '(let ((print-escape-newlines t)) (prin1-to-string "a\nb")) "\"\\\"a\\\\nb\\\"\"")
(s124-check "DIVERGENCE:print-circle-accepted-by-GNU" '(let ((print-circle t)) (prin1-to-string '(a))) "\"(a)\"")
(s124-check "data:gc-setup" '(progn (dotimes (i 80) (copy-sequence "dead")) (setq s124-data-tail (list (copy-sequence "tail")) s124-data-list (append (list (copy-sequence "head")) s124-data-tail) s124-data-print (prin1-to-string s124-data-list)) (car s124-data-list)) "\"head\"")
(garbage-collect)
(s124-check "data:gc-result" '(list s124-data-list (eq (cdr s124-data-list) s124-data-tail) (equal s124-data-print (prin1-to-string s124-data-list)) (min 3.0 2)) "((\"head\" \"tail\") t t 2)")
(s124-check "buffer:absent" '(get-buffer "absent-s124") "nil")
(s124-check "buffer:identity" '(eq (get-buffer (current-buffer)) (current-buffer)) "t")
(s124-check "buffer:scratch" '(eq (get-buffer "*scratch*") (current-buffer)) "t")
(s124-error "buffer:get-type" '(get-buffer 42))
(s124-check "buffer:switch-create" '(eq (switch-to-buffer "s124-a") (current-buffer)) "t")
(s124-check "buffer:switch-preserve" '(progn (insert "alpha") (switch-to-buffer "s124-b") (insert "beta") (switch-to-buffer "s124-a" t t) (buffer-string)) "\"alpha\"")
(s124-check "buffer:switch-object" '(eq (switch-to-buffer (get-buffer "s124-b")) (current-buffer)) "t")
(s124-error "buffer:switch-type" '(switch-to-buffer 42))
(with-temp-buffer
 (s124-check "buffer:erase" '(progn (insert "abcδεf") (narrow-to-region 2 4) (erase-buffer)) "nil")
 (s124-check "buffer:erased-state" '(list (point) (point-min) (point-max) (buffer-size) (buffer-string)) "(1 1 1 0 \"\")"))
(with-temp-buffer
 (s124-check "buffer:forward-default" '(progn (insert "αβ\ncd\nend") (goto-char 2) (forward-line)) "0")
 (s124-check "buffer:point-first" '(point) "4")
 (s124-check "buffer:forward-shortage" '(forward-line 9) "7")
 (s124-check "buffer:point-eob" '(point) "10")
 (s124-check "buffer:backward-shortage" '(forward-line -9) "-7")
 (s124-check "buffer:point-bob" '(point) "1")
 (s124-check "buffer:forward-zero" '(progn (goto-char 5) (forward-line 0) (point)) "4")
 (s124-check "buffer:forward-narrow-nil" '(progn (narrow-to-region 2 6) (goto-char 2) (forward-line nil) (point)) "4"))
(with-temp-buffer
 (s124-check "buffer:major-mode-data-model" '(progn (emacs-lisp-mode) major-mode) "emacs-lisp-mode")
 (s124-check "buffer:menu-enable" '(progn (menu-bar-mode 1) menu-bar-mode) "t")
 (s124-check "buffer:menu-disable" '(progn (menu-bar-mode -1) menu-bar-mode) "nil")
 (s124-check "buffer:menu-default" '(progn (menu-bar-mode) menu-bar-mode) "t")
 (s124-check "buffer:force-update-default" '(force-mode-line-update) "nil")
 (s124-check "buffer:force-update-all" '(force-mode-line-update 'all) "all"))
(s124-check "buffer:daemonp" '(daemonp) "nil")
(let ((actual (condition-case e (daemon-initialized) (error (error-message-string e)))))
 (princ (format "buffer:daemon-initialized-error\t%s\t%S\n" (if (and (stringp actual) (string-match-p "daemon" actual)) "PASS" "FAIL") actual)))
(s124-check "buffer:library-missing" '(locate-library "s124-does-not-exist") "nil")
(let* ((dir (expand-file-name "s124-oracle-library" temporary-file-directory))
       (load-path (list dir)) (fixture (expand-file-name "fixture.el" dir)))
 (s124-check "buffer:library-locate" '(locate-library "fixture") (prin1-to-string fixture))
 (s124-check "buffer:library-not-loaded" '(boundp 's124-loaded) "nil")
 (s124-check "buffer:library-nosuffix-miss" '(locate-library "fixture" t) "nil")
 (s124-check "buffer:library-nosuffix-hit" '(locate-library "fixture.el" t) (prin1-to-string fixture)))
(s124-check "buffer:gc-setup" '(progn (switch-to-buffer "s124-root") (insert "kept")) "nil")
(garbage-collect)
(s124-check "buffer:gc-identity" '(eq (get-buffer "s124-root") (current-buffer)) "t")
(s124-check "buffer:gc-preserve" '(progn (switch-to-buffer "s124-other") (switch-to-buffer "s124-root") (buffer-string)) "\"kept\"")

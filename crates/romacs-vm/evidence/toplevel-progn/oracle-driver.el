(require 'bytecomp)
(setq debug-on-error nil)
(defvar lr-dir (file-name-as-directory (expand-file-name "romacs-progn-oracle" (getenv "TMPDIR"))))
(make-directory lr-dir t)
(princ (format "PIN=%s eager=%S prog2=%S\n" emacs-version (fboundp 'internal-macroexpand-for-load) (macroexpand '(prog2 a b c))))
(dolist (regime '(eager lazy compile))
 (dolist (case '((progn . "(progn (defmacro lr-m () 2) (setq lr-result (lr-m)))")
                 (generated . "(lr-wrap)")
                 (prog1 . "(prog1 (defmacro lr-m () 2) (setq lr-result (lr-m)))")
                 (prog2-first . "(prog2 (defmacro lr-m () 2) (setq lr-result (lr-m)) nil)")
                 (prog2-second . "(prog2 nil (defmacro lr-m () 2) (setq lr-result (lr-m)))")
                 (missing-progn . "(progn (setq lr-side 1) (lr-missing))")
                 (missing-prog1 . "(prog1 (setq lr-side 1) (lr-missing))")))
  (fset 'lr-m '(macro lambda nil 1))
  (fset 'lr-wrap '(macro lambda nil '(progn (defmacro lr-m () 2) (setq lr-result (lr-m)))))
  (fset 'lr-missing '(macro lambda nil (error "lr-missing-expanded")))
  (setq lr-result nil lr-side nil)
  (let* ((file (concat lr-dir (symbol-name regime) "-" (symbol-name (car case)) ".el"))
         (saved (symbol-function 'internal-macroexpand-for-load))
         status)
   (with-temp-file file (insert ";;; -*- lexical-binding: t; -*-\n" (cdr case) "\n"))
   (unwind-protect
    (condition-case err
      (progn
       (when (eq regime 'lazy) (fmakunbound 'internal-macroexpand-for-load))
       (setq status (if (eq regime 'compile)
                        (let ((byte-compile-error-on-warn nil)) (byte-compile-file file))
                      (load file nil t t))))
     (error (setq status (list 'error (error-message-string err)))))
    (fset 'internal-macroexpand-for-load saved))
   (princ (format "%S %S status=%S result=%S side=%S macro=%S\n" regime (car case) status lr-result lr-side (macroexpand '(lr-m))))
   (when (and (eq regime 'compile) status (not (consp status)))
    (fset 'lr-m '(macro lambda nil 1))
    (setq lr-result nil lr-side nil)
    (condition-case err
      (progn (load (concat file "c") nil t t) (princ (format "compiled-load %S result=%S side=%S\n" (car case) lr-result lr-side)))
     (error (princ (format "compiled-load %S error=%S result=%S side=%S\n" (car case) err lr-result lr-side))))))))

;; GNU oracle transcript for symbol property lists. Run:
;;   emacs -Q --batch -l plist-oracle.el
;; Each case prints FORM => VALUE or FORM => (SIGNAL . DATA).
(defvar plist-oracle-cases
  '((let ((a (make-symbol "foo")) (b (make-symbol "foo")))
      (put a 'p 1) (put 'foo 'p 3)
      (list (get a 'p) (get b 'p) (get 'foo 'p) (symbol-plist a) (symbol-plist b) (eq a b)))
    (let ((s (make-symbol "s"))) (put s 'a 1) (put s 'b 2) (put s 'a 3) (symbol-plist s))
    (let ((s (make-symbol "s")) (l (list 'x 1)))
      (list (eq (setplist s l) l) (eq (symbol-plist s) l) (get s 'x)))
    (let* ((s (make-symbol "s")) (l (list 'x 1)))
      (setplist s l) (put s 'x 2) (put s 'y 3) (list l (eq (symbol-plist s) l)))
    (let ((s (make-symbol "s"))) (setplist s 5) (list (get s 'a) (symbol-plist s)))
    (let ((s (make-symbol "s"))) (setplist s 5) (put s 'a 1))
    (let ((s (make-symbol "s"))) (setplist s (list 'a)) (list (get s 'a) (get s 'b)))
    (let ((s (make-symbol "s"))) (setplist s (list 'a)) (put s 'b 1))
    (let ((s (make-symbol "s"))) (setplist s (list 'a 1 'b)) (put s 'c 1))
    (let ((s (make-symbol "s")) (k "k"))
      (put s 1 'one) (put s k 'str)
      (list (get s 1) (get s "k") (get s k) (symbol-plist s)))
    (get 1 'a)
    (put 1 'a 2)
    (symbol-plist 1)
    (setplist 1 nil)
    (progn (put nil 'plist-oracle-p 1) (put t 'plist-oracle-p 2)
           (list (get nil 'plist-oracle-p) (get t 'plist-oracle-p)
                 (plist-get (symbol-plist nil) 'plist-oracle-p)
                 (plist-get (symbol-plist t) 'plist-oracle-p)))
    (progn (put :plist-oracle-kw 'p 1) (get :plist-oracle-kw 'p))
    (let ((s (make-symbol "s")) (l (list 'a 1)))
      (setcdr (cdr l) l) (setplist s l) (list (get s 'a) (get s 'z)))
    (let ((s (make-symbol "s")) (l (list 'a 1)))
      (setcdr (cdr l) l) (setplist s l) (put s 'z 1))
    (progn (defvar plist-oracle-local 1)
           (make-variable-buffer-local 'plist-oracle-local)
           (list (symbol-plist 'plist-oracle-local)
                 (progn (setplist 'plist-oracle-local nil)
                        (local-variable-if-set-p 'plist-oracle-local))))
    (progn (defvar plist-oracle-l2 1)
           (with-temp-buffer
             (make-local-variable 'plist-oracle-l2)
             (setq plist-oracle-l2 5)
             (list (symbol-plist 'plist-oracle-l2)
                   (progn (setplist 'plist-oracle-l2 '(q 1)) plist-oracle-l2)
                   (local-variable-if-set-p 'plist-oracle-l2))))
    (plist-get (symbol-plist 'wrong-type-argument) 'error-conditions)
    (let ((s (make-symbol "c")))
      (setplist s (list 'error-conditions '(c error) 'error-message "C!"))
      (condition-case e (signal s '(1)) (error (list 'caught (car e) (error-message-string e)))))
    (let ((s (make-symbol "c")))
      (define-error s "Made")
      (list (symbol-plist s) (get s 'error-message)))
    (let ((s (make-symbol "x"))) (put s 'pcase-used t) (get s 'pcase-used))
    (pcase '(1 2) (`(,a ,b) (+ a b)))
    (pcase 5 ((app 1+ x) x))
    (subr-arity (symbol-function 'symbol-plist))
    (subr-arity (symbol-function 'setplist))
    (subr-arity (symbol-function 'get))
    (subr-arity (symbol-function 'put))))

(dolist (form plist-oracle-cases)
  (let ((print-circle t) (print-gensym t))
    (princ (format "%S\n  => %S\n"
                   form
                   (condition-case err (eval form t)
                     (error (list 'SIGNAL err)))))))

(setq gc-cons-threshold most-positive-fixnum gc-cons-percentage 1.0)
(defvar redirect-bench-global 17)
(princ "READY\n")
(condition-case nil
    (while t
      (let* ((n (string-to-number (read-from-minibuffer "")))
             (form `(defun redirect-bench-run ()
                      (let ((i 0) (answer 0))
                        (while (< i ,n)
                          (setq answer redirect-bench-global)
                          (setq i (1+ i))) answer))))
        (eval form t)
        (byte-compile 'redirect-bench-run)
        (redirect-bench-run)
        (princ "READY\n")
        (read-from-minibuffer "")
        (let ((before gcs-done))
          (unless (= (redirect-bench-run) 17) (error "incorrect result"))
          (princ (format "DONE collections=%s\n" (- gcs-done before))))))
  (end-of-file nil))

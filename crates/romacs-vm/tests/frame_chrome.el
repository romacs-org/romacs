;;; frame_chrome.el --- window dividers and the internal border  -*- lexical-binding: t -*-
;; Evaluated in one session, form by form, by pinned GNU on an X display
;; (frame_chrome.gnu, regenerated by child_frames_oracle.py --probe) and
;; by Romacs with GNU's Lisp (tests/frame_chrome.rs), on a frame 1216x876
;; native pixels of 10x25 cells with 8-pixel fringes.  Each form's value
;; is compared as printed.  A `probe-resize' form makes the frame W by H
;; native pixels: GNU by `set-frame-size', Romacs by its host's geometry.
;; GNU keeps the native size when a parameter changes, as a tiled frame
;; does (`frame-inhibit-implied-resize').  Windows are compared in pixels:
;; Romacs derives their sizes in characters from them (VM2-WIN1).

(defun probe-settle (w h) (dotimes (_ 100) (unless (and (= (frame-native-width) w) (= (frame-native-height) h)) (sit-for 0.02))) (redisplay t) (list (frame-native-width) (frame-native-height)))
(progn (setq window-resize-pixelwise t) (when (fboundp 'x-create-frame) (message nil) (setq frame-inhibit-implied-resize t frame-resize-pixelwise t) (menu-bar-mode -1) (tool-bar-mode -1) (scroll-bar-mode -1) (blink-cursor-mode -1) (set-frame-font (font-spec :family "Iosevka" :size 19) nil t) (modify-frame-parameters nil '((internal-border-width . 0) (left-fringe . 8) (right-fringe . 8))) (set-frame-size nil 1200 876 t) (probe-settle 1216 876)) (dolist (face '(mode-line mode-line-active mode-line-inactive)) (set-face-attribute face nil :box nil :inherit nil :height 'unspecified :family 'unspecified)) (list (frame-char-width) (frame-char-height) (frame-native-width) (frame-native-height)))
(defun probe-resize (w h) (let ((b (* 2 (frame-internal-border-width)))) (set-frame-size nil (- w b 16) (- h b) t) (probe-settle w h)))
(defun probe-window (w) (list (window-pixel-left w) (window-pixel-top w) (window-pixel-width w) (window-pixel-height w) (window-edges w nil nil t) (window-edges w t nil t) (window-inside-pixel-edges w) (window-body-width w) (window-body-height w) (window-body-width w t) (window-body-height w t) (window-right-divider-width w) (window-bottom-divider-width w) (window-mode-line-height w) (window-header-line-height w)))
(defun probe-windows () (mapcar #'probe-window (append (window-list nil 'never (frame-first-window)) (list (minibuffer-window)))))
(defun probe-sizes (w) (list (window-min-size w nil nil t) (window-min-size w t nil t) (window-min-delta w nil nil nil nil nil t) (window-min-delta w t nil nil nil nil t) (window-max-delta w nil nil nil nil nil t) (window-max-delta w t nil nil nil nil t)))
(defun probe-frame () (list (frame-right-divider-width) (frame-bottom-divider-width) (frame-internal-border-width) (frame-native-width) (frame-native-height) (window-edges (frame-root-window) nil nil t) (frame-text-width) (frame-text-height) (frame-text-cols) (frame-text-lines) (frame-total-cols) (frame-total-lines)))
(probe-frame)
(probe-windows)
;; dividers_and_border_follow_gnu_on_a_three_way_split
(progn (modify-frame-parameters nil '((right-divider-width . 6) (bottom-divider-width . 6) (internal-border-width . 6))) (probe-settle 1216 876) (probe-frame))
(probe-windows)
(mapcar #'probe-sizes (window-list nil 'never (frame-first-window)))
(progn (split-window-right) (probe-windows))
(progn (split-window-below) (probe-windows))
(mapcar #'probe-sizes (window-list nil 'never (frame-first-window)))
(probe-frame)
;; the_mini_window_has_no_bottom_divider_and_ordinary_windows_do
(mapcar (lambda (w) (list (window-bottom-divider-width w) (window-right-divider-width w))) (append (window-list nil 'never (frame-first-window)) (list (minibuffer-window))))
(progn (delete-window (frame-first-window)) (probe-windows))
(progn (split-window-below) (probe-windows))
;; uneven_resize_cycles_keep_sibling_sums_and_bodies
(progn (window-resize (frame-first-window) 3 nil nil t) (window-resize (frame-first-window) 37 t nil t) (probe-windows))
(probe-resize 1001 876)
(probe-windows)
(probe-resize 1216 876)
(probe-windows)
(probe-resize 777 876)
(probe-windows)
(probe-resize 1216 876)
(probe-windows)
(probe-resize 1216 601)
(probe-windows)
(probe-resize 1216 876)
(probe-windows)
;; balance_windows_with_dividers_matches_gnu
(progn (delete-other-windows) (let ((right (split-window-right))) (split-window-below) (select-window right) (split-window-below) (select-window (frame-first-window))) (window-resize (frame-first-window) 4 nil nil t) (window-resize (frame-first-window) 50 t nil t) (probe-windows))
(progn (balance-windows) (probe-windows))
(mapcar #'probe-sizes (window-list nil 'never (frame-first-window)))
;; Back to no dividers and no border.
(progn (delete-other-windows) (modify-frame-parameters nil '((right-divider-width . 0) (bottom-divider-width . 0) (internal-border-width . 0))) (probe-settle 1216 876) (probe-frame))
(probe-windows)

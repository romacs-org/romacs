;;; top_frames.el --- top-level frame queries and commands  -*- lexical-binding: t -*-
;; Evaluated in one session, form by form, by pinned GNU on an X display
;; (top_frames.gnu, regenerated by child_frames_oracle.py --probe) and by
;; Romacs (tests/top_frames.rs) over a host that shows more than one
;; top-level frame.  Each form's value is compared as printed; a form that
;; signals reads (signal ERROR).  Frames are made by the primitive
;; `make-frame' reaches on a window system, GNU's `x-create-frame' and
;; Romacs's `romacs--create-frame'.

(defalias 'probe-create-frame (if (fboundp 'x-create-frame) #'x-create-frame #'romacs--create-frame))
(setq F (selected-frame))
(setq G (probe-create-frame '((name . "two") (width . 40) (height . 10) (left-fringe . 8) (right-fringe . 8) (menu-bar-lines . 0) (tool-bar-lines . 0) (tab-bar-lines . 0) (vertical-scroll-bars . nil))))
(and (frame-live-p G) t)
(frame-parent G)
(equal (frame-list) (list G F))
(eq (selected-frame) F)
(eq (window-frame (frame-root-window G)) G)
(eq (window-frame (minibuffer-window G)) G)
(eq (minibuffer-window G) (minibuffer-window F))
(window-minibuffer-p (minibuffer-window G))
(eq (frame-selected-window G) (frame-root-window G))
(frame-parameter G 'name)
(frame-parameter G 'minibuffer)
(eq (frame-parameter G 'minibuffer) (minibuffer-window G))
(list (frame-text-cols G) (frame-text-lines G))
(list (= (frame-text-width G) (* 40 (frame-char-width G))) (= (frame-text-height G) (* 10 (frame-char-height G))))
(eq (frame-terminal G) (frame-terminal F))
(length (terminal-list))
(eq (next-frame F) G)
(eq (next-frame G) F)
(eq (previous-frame F) G)
(eq (previous-frame G) F)
(eq (next-frame F 'visible) G)
(eq (next-frame F 0) G)
(eq (next-frame F (minibuffer-window F)) F)
(eq (next-frame G (minibuffer-window G)) G)
(progn (select-frame G) (eq (selected-frame) G))
(eq (window-frame (selected-window)) G)
(eq (last-nonminibuffer-frame) G)
(progn (select-frame F) (eq (selected-frame) F))
(progn (make-frame-invisible G) (frame-visible-p G))
(equal (visible-frame-list) (list F))
(eq (next-frame F 'visible) F)
(eq (next-frame F) G)
(condition-case e (make-frame-invisible F) (error (list 'signal e)))
(progn (make-frame-visible G) (frame-visible-p G))
(equal (visible-frame-list) (list G F))
(progn (modify-frame-parameters G '((no-other-frame . t))) (eq (next-frame F) F))
(progn (modify-frame-parameters G '((no-other-frame . nil))) (eq (next-frame F) G))
(setq H (probe-create-frame '((name . "three") (menu-bar-lines . 0) (tool-bar-lines . 0) (tab-bar-lines . 0) (vertical-scroll-bars . nil))))
(equal (frame-list) (list H G F))
(progn (select-frame G) (select-frame F) (select-frame H) (eq (selected-frame) H))
(progn (delete-frame H) (frame-live-p H))
(eq (selected-frame) F)
(equal (frame-list) (list G F))
(setq M (probe-create-frame '((name . "borrower") (minibuffer . nil) (menu-bar-lines . 0) (tool-bar-lines . 0) (tab-bar-lines . 0) (vertical-scroll-bars . nil))))
(eq (minibuffer-window M) (minibuffer-window F))
(eq (window-frame (minibuffer-window M)) F)
(condition-case e (delete-frame F) (error (list 'signal e)))
(progn (delete-frame M) (frame-live-p M))
(progn (select-frame G) (delete-frame G) (frame-live-p G))
(eq (selected-frame) F)
(equal (frame-list) (list F))
(eq (next-frame F) F)
(condition-case e (delete-frame F) (error (list 'signal e)))
(condition-case e (delete-frame F t) (error (list 'signal e)))
